#!/usr/bin/env bash
#
# tg-ping: expressive Telegram notifications for coding and research agents.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# Homepage:  https://github.com/dutykh/tg-ping
# License:   LGPL-2.1-or-later, see the LICENSE file of the distribution.
#
# Dependencies: bash (3.2+) and curl. Optional: jq (or python3) for the
# commands that read incoming updates, and typst or LaTeX for rendered
# mathematics.

# The awk, jq and python programs below are single quoted on purpose: their
# dollar signs belong to them, not to the shell.
# shellcheck disable=SC2016

set -uo pipefail

TG_PING_VERSION="2.2.0"
TG_PING_NAME="tg-ping"

TAB=$(printf '\t')
CR=$(printf '\r')
ESC=$(printf '\033')
US=$(printf '\037')       # unit separator, the field delimiter of internal records

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

readonly TG_MAX_TEXT=4096       # Telegram limit for a text message
readonly TG_MAX_CAPTION=1024    # Telegram limit for a media caption
readonly TG_UPLOAD_LIMIT=52428800  # 50 MiB, the bot upload ceiling
readonly TG_PHOTO_LIMIT=10485760   # 10 MB, above which Telegram refuses a photo

# Exit codes, documented in --help and in the README.
readonly EX_OK=0          # message delivered
readonly EX_FAIL=1        # generic failure
readonly EX_USAGE=2       # bad invocation
readonly EX_CONFIG=3      # missing or invalid credentials
readonly EX_NET=4         # network unreachable, curl failed
readonly EX_API=5         # Telegram rejected the request
readonly EX_RATE=6        # rate limited beyond the retry budget
readonly EX_TIMEOUT=7     # no answer within the deadline (ask, poll)

# ---------------------------------------------------------------------------
# Global state, all assigned before use so that "set -u" stays meaningful
# ---------------------------------------------------------------------------

TOKEN=""
CHATS=""                  # comma separated list, resolved late
PROFILE="${TG_PING_PROFILE:-default}"
API_ROOT="${TG_PING_API:-https://api.telegram.org}"
ENV_FILE="${TG_PING_ENV_FILE:-}"

bool01() {
    # A boolean setting as 1 or 0: 1, true, yes and on count as true.
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on|y) printf '1' ;;
        *)               printf '0' ;;
    esac
}

VERBOSE=0
QUIET=0
DRY_RUN=0
JSON_OUT=0
SOFT_FAIL=$(bool01 "${TG_PING_SOFT_FAIL:-0}")
DISABLED=$(bool01 "${TG_PING_DISABLED:-0}")
TIMEOUT="${TG_PING_TIMEOUT:-20}"
RETRIES="${TG_PING_RETRIES:-3}"
FALLBACK=1
INSECURE=0

# Response of the last API call.
API_HTTP=""
API_BODY=""
API_ERROR=""
NO_RATE_WAIT=0            # 1: a 429 answer returns at once instead of waiting

WORKDIR=""

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

redact() {
    # Replace anything that looks like a bot token with a marker, so that no
    # verbose output, error message or dry run ever leaks the credential.
    sed -e 's#bot[0-9][0-9]*:[A-Za-z0-9_-]*#bot<TOKEN>#g' \
        -e 's#[0-9]\{5,\}:[A-Za-z0-9_-]\{20,\}#<TOKEN>#g'
}

msg()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$TG_PING_NAME" "$*" | redact >&2; }
note() { [ "$VERBOSE" -eq 1 ] && printf '%s: %s\n' "$TG_PING_NAME" "$*" | redact >&2; return 0; }

die() {
    local code="$1"; shift
    printf '%s: error: %s\n' "$TG_PING_NAME" "$*" | redact >&2
    if [ "$SOFT_FAIL" = "1" ] && [ "$code" != "$EX_USAGE" ]; then
        note "soft-fail is on, exiting 0 despite the error above"
        exit "$EX_OK"
    fi
    exit "$code"
}

have() {
    # TG_PING_HIDE lists programs to treat as absent, so that the fallbacks
    # used without jq or python3 can be exercised on any machine.
    case " ${TG_PING_HIDE:-} " in *" $1 "*) return 1 ;; esac
    command -v "$1" >/dev/null 2>&1
}

lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

awk_run() {
    # The awk of TG_PING_AWK (a command, possibly with arguments such as
    # "busybox awk"), else the one chosen by choose_awk.
    if [ -n "${TG_PING_AWK:-}" ]; then
        # shellcheck disable=SC2086  # the setting may hold a command and its arguments
        ${TG_PING_AWK} "$@"
    else
        # shellcheck disable=SC2086  # "busybox awk" is a command and its argument
        ${AWK_CMD:-awk} "$@"
    fi
}

awk_counts_bytes() {
    # True when the awk named by the arguments counts bytes under LC_ALL=C,
    # as the measuring and cutting of texts require (an awk that always
    # reads UTF-8, such as the second edition of the one true awk, does not).
    [ "$(printf '\303\251\n' | LC_ALL=C "$@" '{ print length($0) }' 2>/dev/null)" = 2 ]
}

choose_awk() {
    # choose_awk -> the first awk on PATH that counts bytes, else "awk".
    local a
    for a in awk mawk gawk nawk original-awk "busybox awk"; do
        have "${a%% *}" || continue
        # shellcheck disable=SC2086  # "busybox awk" is a command and its argument
        if awk_counts_bytes $a; then printf '%s' "$a"; return 0; fi
    done
    printf 'awk'
}

# ---------------------------------------------------------------------------
# Temporary working directory, removed on exit
# ---------------------------------------------------------------------------

# shellcheck disable=SC2329  # called by the EXIT trap below
_cleanup() {
    local code=$?
    # A question that stops waiting leaves the shared inbox, and a lock held
    # as a directory is released (a flock goes with the process).
    [ -n "${INBOX_WAITER:-}" ] && rm -f "$INBOX_WAITER"
    [ "${INBOX_LOCKED:-}" = "mkdir" ] && [ -n "${INBOX_D:-}" ] && rm -rf "$INBOX_D/lock.d"
    [ -n "$WORKDIR" ] && [ -d "$WORKDIR" ] && rm -rf "$WORKDIR"
    exit "$code"
}

workdir_init() {
    # Must run in the main shell: a directory created inside a command
    # substitution would be removed when that subshell exits.
    [ -n "$WORKDIR" ] && return 0
    WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/tg-ping.XXXXXX") ||
        die "$EX_FAIL" "cannot create a temporary directory"
    trap _cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    return 0
}

workdir() {
    [ -n "$WORKDIR" ] || workdir_init
    printf '%s' "$WORKDIR"
}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

human_duration() {
    # Seconds to a compact human string: 45s, 3m 12s, 1h 04m 09s.
    local s="$1" h m
    h=$(( s / 3600 )); m=$(( (s % 3600) / 60 )); s=$(( s % 60 ))
    if   [ "$h" -gt 0 ]; then printf '%dh %02dm %02ds' "$h" "$m" "$s"
    elif [ "$m" -gt 0 ]; then printf '%dm %02ds' "$m" "$s"
    else                      printf '%ds' "$s"
    fi
}

short_hash() {
    # A stable short digest of stdin, used for cooldown keys.
    if have sha256sum;   then sha256sum   | cut -c1-16
    elif have shasum;    then shasum -a 256 | cut -c1-16
    elif have md5sum;    then md5sum      | cut -c1-16
    elif have cksum;     then cksum       | tr -d ' ' | cut -c1-16
    else                      wc -c | tr -d ' '
    fi
}

state_dir() {
    local d="${TG_PING_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tg-ping}"
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null || true
    printf '%s' "$d"
}

config_dir() {
    printf '%s' "${TG_PING_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tg-ping}"
}

host_name() { printf '%s' "${HOSTNAME:-$(uname -n 2>/dev/null || echo host)}"; }

git_context() {
    # "repo@branch" when the working directory sits inside a git repository.
    local root branch
    have git || return 0
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    [ -n "$root" ] || return 0
    # The branch, or the commit when detached, or the branch to be of a
    # repository without commits yet.
    branch=$(git symbolic-ref --short -q HEAD 2>/dev/null) ||
        branch=$(git rev-parse --short HEAD 2>/dev/null) || branch="?"
    printf '%s@%s' "$(basename "$root")" "$branch"
}

is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

detect_machine_kind() {
    # detect_machine_kind -> laptop, desktop or server: the DMI chassis code
    # first, then the virtualisation check (a virtual server reports code 1,
    # "other"), then the presence of a battery.
    local dmi="${TG_PING_DMI_DIR:-/sys/class/dmi/id}" code virt
    code=$(tr -d ' \n' < "$dmi/chassis_type" 2>/dev/null || true)
    case "$code" in
        8|9|10|11|14|30|31|32)               printf 'laptop'; return 0 ;;
        3|4|5|6|7|13|15|16|24|34|35|36)      printf 'desktop'; return 0 ;;
        17|23|25|28|29)                      printf 'server'; return 0 ;;
    esac
    if have systemd-detect-virt; then
        virt=$(systemd-detect-virt 2>/dev/null || true)
        case "$virt" in ""|none) ;; *) printf 'server'; return 0 ;; esac
    fi
    if ls "${TG_PING_POWER_DIR:-/sys/class/power_supply}"/BAT* >/dev/null 2>&1; then
        printf 'laptop'; return 0
    fi
    if [ "$(uname -s 2>/dev/null)" = "Darwin" ] && have pmset; then
        case "$(pmset -g batt 2>/dev/null)" in
            *InternalBattery*) printf 'laptop' ;;
            *)                 printf 'desktop' ;;
        esac
        return 0
    fi
    printf 'desktop'
}

machine_icon_for() {
    case "$1" in
        laptop) printf '\xf0\x9f\x92\xbb' ;;                # laptop computer
        server) printf '\xf0\x9f\x8c\x90' ;;                # globe
        *)      printf '\xf0\x9f\x96\xa5\xef\xb8\x8f' ;;    # desktop computer
    esac
}

machine_tag() {
    # The name of this machine for the first line of a message, with its
    # icon, or nothing when the machine has no name.
    local name="$MACHINE" icon="$MACHINE_ICON"
    [ "$SHOW_MACHINE" -eq 1 ] || return 0
    case "$(lc "$name")" in
        ""|none|off|0) return 0 ;;
        auto)          name=$(host_name) ;;
    esac
    [ -n "$icon" ] || icon=$(machine_icon_for "$(detect_machine_kind)")
    case "$(lc "$icon")" in none|off) icon="" ;; esac
    printf '%s%s' "${icon:+$icon }" "$name"
}

# ---------------------------------------------------------------------------
# Which agent is speaking
# ---------------------------------------------------------------------------

agent_chain() {
    # The programs above this process, nearest first, one per line as
    # "name<TAB>argument 0<TAB>argument 1<TAB>argument 2<TAB>argument 3",
    # read from /proc where it exists, which starts no program, else from
    # ps. TG_PING_PROC_DIR stands for /proc, so that a test can empty it.
    local proc="${TG_PING_PROC_DIR:-/proc}" pid="$PPID" n=0 line comm a0 a1 a2 a3
    if [ -n "${TG_PING_PROC_DIR:-}" ] || [ -r "$proc/$$/stat" ]; then
        while [ "$n" -lt 64 ] && is_number "$pid" && [ "$pid" -gt 1 ]; do
            line=""
            IFS= read -r line 2>/dev/null < "$proc/$pid/stat" || [ -n "$line" ] || break
            comm=""; a0=""; a1=""; a2=""; a3=""
            IFS= read -r comm 2>/dev/null < "$proc/$pid/comm" || true
            { IFS= read -r -d '' a0; IFS= read -r -d '' a1
              IFS= read -r -d '' a2; IFS= read -r -d '' a3; } 2>/dev/null < "$proc/$pid/cmdline" || true
            printf '%s\t%s\t%s\t%s\t%s\n' "$comm" "$a0" "$a1" "$a2" "$a3"
            # The parent is the second field after the name in parentheses,
            # a name that may itself hold spaces and parentheses.
            line=${line##*) }; line=${line#* }; pid=${line%% *}
            n=$(( n + 1 ))
        done
    elif have ps; then
        ps -A -o pid= -o ppid= -o args= 2>/dev/null | awk_run -v start="$PPID" '
            { up[$1] = $2; seen[$1] = $3 "\t" $3 "\t" $4 "\t" $5 "\t" $6 }
            END {
                p = start; n = 0
                while (p > 1 && (p in up) && n < 64) { print seen[p]; p = up[p]; n++ }
            }'
    fi
    return 0
}

agent_match() {
    # The lines of agent_chain on stdin -> the agent that the nearest program
    # standing for one names: by its own name, or, for an interpreter (node,
    # python, a shell), by the script it runs, its first argument that is not
    # an option. All the input is read, so that the writer never meets a
    # closed pipe.
    awk_run '
        function base(s) {
            sub(/.*\//, "", s); s = tolower(s)
            sub(/^\./, "", s); sub(/\.(exe|js|mjs|cjs)$/, "", s)
            return s
        }
        function agent(n) {
            if (n == "claude" || n == "claude-code")  return "Claude"
            if (n == "codex" || n ~ /^codex-/)        return "Codex"
            if (n == "grok" || n ~ /^grok-/)          return "Grok"
            if (n == "opencode")                      return "OpenCode"
            if (n == "gemini")                        return "Gemini"
            if (n == "agy" || n == "antigravity")     return "Antigravity"
            if (n == "cursor-agent")                  return "Cursor"
            if (n == "copilot")                       return "Copilot"
            if (n == "aider")                         return "Aider"
            if (n == "amp")                           return "Amp"
            if (n == "goose")                         return "Goose"
            if (n == "qwen")                          return "Qwen Code"
            if (n == "crush")                         return "Crush"
            if (n == "droid")                         return "Droid"
            if (n == "auggie")                        return "Augment"
            if (n == "kiro-cli")                      return "Kiro"
            return ""
        }
        BEGIN { FS = "\t"; found = "" }
        found == "" {
            a = agent(base($1))
            if (a == "") a = agent(base($2))
            if (a == "" && base($2) ~ /^(node|nodejs|bun|deno|python[0-9.]*|pypy[0-9.]*|ruby|perl|bash|sh|dash|zsh|ksh|env)$/)
                for (i = 3; i <= NF; i++)
                    if (substr($i, 1, 1) != "-") { a = agent(base($i)); break }
            found = a
        }
        END { if (found != "") print found }'
}

agent_from_env() {
    # The agent named by the marks that agents leave in the environment of
    # the commands they run, for a command whose agent cannot be seen above
    # it: one run inside the sandbox of Codex, whose own process namespace
    # hides every program outside it, or a job left running in the
    # background. The marks of that sandbox come first, since they hold
    # only inside it; then AI_AGENT, which several agents set for their
    # commands, replacing the value of an agent that started them; then the
    # marks of each agent; and last a value of AI_AGENT that names an agent
    # unknown here, by its first word.
    local v
    if [ -n "${CODEX_SANDBOX:-}${CODEX_SANDBOX_NETWORK_DISABLED:-}" ]; then
        printf 'Codex'; return 0
    fi
    v=$(lc "${AI_AGENT:-}")
    case "$v" in
        claude*)                   printf 'Claude'; return 0 ;;
        codex*)                    printf 'Codex'; return 0 ;;
        grok*)                     printf 'Grok'; return 0 ;;
        opencode*)                 printf 'OpenCode'; return 0 ;;
        gemini*)                   printf 'Gemini'; return 0 ;;
        antigravity*|agy*|jetski*) printf 'Antigravity'; return 0 ;;
        cursor*)                   printf 'Cursor'; return 0 ;;
        copilot*|github-copilot*)  printf 'Copilot'; return 0 ;;
    esac
    if   [ -n "${CLAUDECODE:-}" ]; then printf 'Claude'
    elif [ -n "${CODEX_THREAD_ID:-}" ]; then printf 'Codex'
    elif [ -n "${CODEX_MANAGED_BY_NPM:-}${CODEX_MANAGED_BY_PNPM:-}${CODEX_MANAGED_BY_BUN:-}" ]; then printf 'Codex'
    elif [ -n "${GROK_SESSION_ID:-}${GROK_HOOK_EVENT:-}" ]; then printf 'Grok'
    elif [ -n "${OPENCODE:-}${OPENCODE_SESSION_ID:-}" ]; then printf 'OpenCode'
    elif [ -n "${ANTIGRAVITY_CONVERSATION_ID:-}" ]; then printf 'Antigravity'
    elif [ -n "${GEMINI_CLI:-}" ]; then printf 'Gemini'
    elif [ -n "${CURSOR_AGENT:-}" ]; then printf 'Cursor'
    else
        case "$v" in
            ""|1|0|true|false|yes|no|on|off) ;;
            [a-z]*)
                v=${AI_AGENT%%[_ ]*}
                printf '%s%s' "$(printf '%s' "${v:0:1}" | tr '[:lower:]' '[:upper:]')" "${v:1}" ;;
        esac
    fi
    return 0
}

detect_agent() {
    # The agent this command works for: the nearest program above it that is
    # one, else the marks of the environment, else nothing.
    local a
    a=$(agent_chain | agent_match)
    [ -n "$a" ] || a=$(agent_from_env)
    printf '%s' "$a"
}

resolve_agent() {
    # AGENT_NAME, the agent named on the first line of every message, as
    # TG_PING_AGENT or --agent decide: auto (the default) finds it, off
    # leaves it out, and any other value is the name itself. It runs in the
    # main shell, once, since messages are composed in subshells.
    case "$(lc "$AGENT_MODE")" in
        off|none|0|false|no|n)   AGENT_NAME="" ;;
        ""|auto|on|1|true|yes|y) AGENT_NAME=$(detect_agent) ;;
        *)                       AGENT_NAME="$AGENT_MODE" ;;
    esac
}

agent_summary() {
    # The agent line of 'config show'.
    case "$(lc "$AGENT_MODE")" in
        off|none|0|false|no|n)   printf 'not shown (TG_PING_AGENT=%s)' "$AGENT_MODE" ;;
        ""|auto|on|1|true|yes|y)
            if [ -n "$AGENT_NAME" ]; then printf '%s (detected)' "$AGENT_NAME"
            else printf 'none detected here'; fi ;;
        *)                       printf '%s (given by TG_PING_AGENT)' "$AGENT_NAME" ;;
    esac
}

speaker_tag() {
    # Who speaks, for the first line of a message: the machine and the agent
    # working there ("🖥️ office desktop · Codex"), or whichever is known.
    local machine
    machine=$(machine_tag)
    if [ -n "$machine" ] && [ -n "$AGENT_NAME" ]; then
        printf '%s · %s' "$machine" "$AGENT_NAME"
    else
        printf '%s%s' "$machine" "$AGENT_NAME"
    fi
}

settings_set() {
    # settings_set FILE KEY VALUE: write KEY=VALUE into a settings file, in
    # place of any earlier line for the key, keeping every other line. An
    # empty VALUE removes the key. The file is created with mode 600.
    local file="$1" key="$2" value="$3" line dir tmp
    case "$value" in
        *[[:space:]\#\"\'\\]*|"")
            # Double quotes, inside which a backslash escapes a quote or a
            # backslash: a value may then hold both kinds of quotes.
            line="$key=\"$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')\"" ;;
        *) line="$key=$value" ;;
    esac
    [ -n "$value" ] || line=""
    dir=$(dirname "$file")
    mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null
    tmp="$file.tmp.$$"
    ( umask 077
      if [ -f "$file" ]; then
          TGP_KEY="$key" TGP_LINE="$line" awk_run '
              BEGIN { key = ENVIRON["TGP_KEY"]; nl = ENVIRON["TGP_LINE"]; done = 0 }
              {
                  probe = $0
                  sub(/^[ \t]*(export[ \t]+)?/, "", probe)
                  if (index(probe, key "=") == 1 || index(probe, key " =") == 1) {
                      if (!done && nl != "") print nl
                      done = 1
                      next
                  }
                  print
              }
              END { if (!done && nl != "") print nl }' "$file" > "$tmp"
      else
          { printf '# tg-ping settings, profile file %s\n' "$(basename "$file")"
            printf '# Keep this file private: it grants full control of the bot.\n'
            [ -n "$line" ] && printf '%s\n' "$line"; } > "$tmp"
      fi ) || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp" 2>/dev/null
    mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

atomic_write() {
    # atomic_write FILE TEXT: readers see the old content or the new one,
    # never a partial write.
    local file="$1" tmp
    tmp="$file.tmp.$$"
    printf '%s' "$2" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$file" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

parse_duration() {
    # parse_duration TEXT -> seconds. Accepts 90, 90s, 15m, 2h, 1d and sums
    # such as 1h30m; fails on anything else.
    local text="$1" total=0 num unit
    [ -n "$text" ] || return 1
    while [ -n "$text" ]; do
        num=${text%%[!0-9]*}
        [ -n "$num" ] || return 1
        text=${text#"$num"}
        unit=${text%"${text#?}"}
        case "$unit" in
            s|"") total=$(( total + num )) ;;
            m)    total=$(( total + num * 60 )) ;;
            h)    total=$(( total + num * 3600 )) ;;
            d)    total=$(( total + num * 86400 )) ;;
            *)    return 1 ;;
        esac
        text=${text#"$unit"}
    done
    printf '%s' "$total"
}

mutex_acquire() {
    # mutex_acquire DIR [SECONDS]: a short lock held as a directory, waited for
    # at most SECONDS (default 5). A lock whose owner has died, or older than
    # a minute, is broken; a single rename decides who breaks it.
    local dir="$1" limit="${2:-5}" tries=0 owner stamp now
    while ! mkdir "$dir" 2>/dev/null; do
        owner=$(cat "$dir/owner" 2>/dev/null || true)
        stamp=${owner#* }; owner=${owner%% *}
        now=$(date +%s)
        if { is_number "$owner" && ! kill -0 "$owner" 2>/dev/null; } ||
           { is_number "$stamp" && [ $(( now - stamp )) -gt 60 ]; } ||
           { [ -z "$owner" ] && [ -n "$(find "$dir" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
            mv "$dir" "$dir.stale.$$" 2>/dev/null && rm -rf "$dir.stale.$$"
            continue
        fi
        tries=$(( tries + 1 ))
        [ "$tries" -gt $(( limit * 10 )) ] && return 1
        sleep 0.1
    done
    printf '%s %s' "$$" "$(date +%s)" > "$dir/owner" 2>/dev/null
    return 0
}

mutex_release() { rm -rf "$1" 2>/dev/null; return 0; }

# ---------------------------------------------------------------------------
# Configuration
#
# Resolution order, first value wins for each setting:
#   1. command line flags
#   2. environment variables named TG_PING_*
#   3. --env-file FILE, or $TG_PING_ENV_FILE
#   4. ./.tg-ping.env               (project local, no token, no API root)
#   5. ./.env.local                 (TG_PING_* keys only, no token, no API root)
#   6. ./.env                       (TG_PING_* keys only, no token, no API root)
#   7. $XDG_CONFIG_HOME/tg-ping/<profile>.env
#   8. /etc/tg-ping/config
#   9. the older TELEGRAM_* names: from the environment, then from the files
#
# A file in the working directory may arrive with a repository written by
# somebody else. It may choose a chat, a topic or one of the user's profiles,
# but never supply a token or send the requests, token included, to another
# server. Files are never sourced and never evaluated: a hand written reader
# accepts KEY=VALUE lines only, so a hostile .env cannot execute anything.
# ---------------------------------------------------------------------------

SECRET_KEYS=" TG_PING_TOKEN TG_PING_BOT_TOKEN TELEGRAM_BOT_TOKEN TELEGRAM_TOKEN BOT_TOKEN TG_PING_API "

env_file_get() {
    # env_file_get FILE KEY -> value on stdout; fails when the key is absent.
    local file="$1" key="$2" line value rest c
    [ -r "$file" ] || return 1
    line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n1) || true
    [ -n "$line" ] || return 1
    value=${line#*=}
    value=${value%"$CR"}
    value="${value#"${value%%[![:space:]]*}"}"
    # One quoted string, whatever follows it being a comment, or a bare value
    # that ends where a blank and a # begin a comment. Inside double quotes
    # a backslash escapes a quote or a backslash, as settings_set writes
    # them; inside single quotes nothing is special.
    case "$value" in
        \"*)
            rest=${value#\"}; value=""
            while [ -n "$rest" ]; do
                c=${rest%"${rest#?}"}; rest=${rest#?}
                case "$c" in
                    \\) case "$rest" in \"*|\\*) c=${rest%"${rest#?}"}; rest=${rest#?} ;; esac ;;
                    \") break ;;
                esac
                value="$value$c"
            done ;;
        \'*) value=${value#\'}; value=${value%%\'*} ;;
        *)   value=$(printf '%s' "$value" | sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//') ;;
    esac
    printf '%s' "$value"
}

config_files() {
    # Candidate configuration files, most specific first, one per line as
    # "SCOPE PATH". The scope "own" marks the files written for tg-ping by the
    # user, read in full; "project" is ./.tg-ping.env; "generic" marks
    # ./.env.local and ./.env, shared with other tools.
    local dir; dir=$(config_dir)
    [ -n "$ENV_FILE" ] && printf 'own %s\n' "$ENV_FILE"
    if [ "$(bool01 "${TG_PING_NO_DOTENV:-0}")" != "1" ]; then
        # .env.local is preferred over .env (same convention as many app stacks).
        printf 'project %s\n' "./.tg-ping.env"
        printf 'generic %s\n' "./.env.local" "./.env"
    fi
    printf 'own %s\n' "$dir/${PROFILE}.env" "$dir/config.env" "$dir/config" "/etc/tg-ping/config"
}

key_allowed() {
    # key_allowed SCOPE KEY: whether a file of that scope may set the key.
    [ "$1" = "own" ] && return 0
    case "$SECRET_KEYS" in *" $2 "*) return 1 ;; esac
    case "$1" in
        project) return 0 ;;
        generic) case "$2" in TG_PING_*) return 0 ;; esac ;;
    esac
    return 1
}

lookup_setting() {
    # lookup_setting PRIMARY [ALIAS...] -> first value found across the files.
    local scope file key value
    while read -r scope file; do
        [ -n "$file" ] && [ -r "$file" ] || continue
        for key in "$@"; do
            key_allowed "$scope" "$key" || continue
            value=$(env_file_get "$file" "$key") || continue
            if [ -n "$value" ]; then
                printf '%s' "$value"
                return 0
            fi
        done
    done <<EOF
$(config_files)
EOF
    return 1
}

setting_file() {
    # setting_file KEY [ALIAS...] -> the first file allowed to set, and setting,
    # any of them.
    local scope file key
    while read -r scope file; do
        [ -n "$file" ] && [ -r "$file" ] || continue
        for key in "$@"; do
            key_allowed "$scope" "$key" || continue
            if env_file_get "$file" "$key" >/dev/null 2>&1; then
                printf '%s' "$file"
                return 0
            fi
        done
    done <<EOF
$(config_files)
EOF
    return 1
}

ignored_keys() {
    # ignored_keys -> "KEY in FILE" for each credential a local file sets but
    # may not, so that doctor can explain why it is not used.
    local scope file key
    while read -r scope file; do
        [ "$scope" = "own" ] && continue
        [ -n "$file" ] && [ -r "$file" ] || continue
        for key in TG_PING_TOKEN TG_PING_BOT_TOKEN TG_PING_API TELEGRAM_BOT_TOKEN \
                   TELEGRAM_TOKEN TELEGRAM_CHAT_ID BOT_TOKEN; do
            key_allowed "$scope" "$key" && continue
            env_file_get "$file" "$key" >/dev/null 2>&1 && printf '%s in %s\n' "$key" "$file"
        done
    done <<EOF
$(config_files)
EOF
    return 0
}

TOKEN_SRC=""; CHATS_SRC=""; API_FROM_FLAG=0

load_config() {
    # Flags already stored in TOKEN and CHATS take precedence over everything.
    # TOKEN_SRC and CHATS_SRC record where each credential was found.
    local v
    if [ -n "$TOKEN" ]; then
        TOKEN_SRC="${TOKEN_SRC:-the command line}"
    elif [ -n "${TG_PING_TOKEN:-${TG_PING_BOT_TOKEN:-}}" ]; then
        TOKEN="${TG_PING_TOKEN:-${TG_PING_BOT_TOKEN:-}}"; TOKEN_SRC="the environment"
    elif v=$(lookup_setting TG_PING_TOKEN TG_PING_BOT_TOKEN); then
        TOKEN="$v"; TOKEN_SRC=$(setting_file TG_PING_TOKEN TG_PING_BOT_TOKEN)
    elif [ -n "${TELEGRAM_BOT_TOKEN:-${TELEGRAM_TOKEN:-}}" ]; then
        TOKEN="${TELEGRAM_BOT_TOKEN:-${TELEGRAM_TOKEN:-}}"; TOKEN_SRC="the environment (TELEGRAM_BOT_TOKEN)"
    elif v=$(lookup_setting TELEGRAM_BOT_TOKEN TELEGRAM_TOKEN BOT_TOKEN); then
        TOKEN="$v"; TOKEN_SRC=$(setting_file TELEGRAM_BOT_TOKEN TELEGRAM_TOKEN BOT_TOKEN)
    fi
    if [ -n "$CHATS" ]; then
        CHATS_SRC="${CHATS_SRC:-the command line}"
    elif [ -n "${TG_PING_CHAT_ID:-${TG_PING_CHAT:-}}" ]; then
        CHATS="${TG_PING_CHAT_ID:-${TG_PING_CHAT:-}}"; CHATS_SRC="the environment"
    elif v=$(lookup_setting TG_PING_CHAT_ID TG_PING_CHAT); then
        CHATS="$v"; CHATS_SRC=$(setting_file TG_PING_CHAT_ID TG_PING_CHAT)
    elif [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
        CHATS="$TELEGRAM_CHAT_ID"; CHATS_SRC="the environment (TELEGRAM_CHAT_ID)"
    elif v=$(lookup_setting TELEGRAM_CHAT_ID CHAT_ID); then
        CHATS="$v"; CHATS_SRC=$(setting_file TELEGRAM_CHAT_ID CHAT_ID)
    fi
    if [ -z "${THREAD_ID:-}" ]; then
        THREAD_ID="${TG_PING_THREAD_ID:-}"
        [ -n "$THREAD_ID" ] || THREAD_ID=$(lookup_setting TG_PING_THREAD_ID TG_PING_TOPIC_ID) || THREAD_ID=""
    fi
    if [ -z "${PREFIX:-}" ]; then
        PREFIX="${TG_PING_PREFIX:-}"
        [ -n "$PREFIX" ] || PREFIX=$(lookup_setting TG_PING_PREFIX) || PREFIX=""
    fi
    if [ "$API_FROM_FLAG" -eq 0 ] && [ -z "${TG_PING_API:-}" ]; then
        v=$(lookup_setting TG_PING_API) && [ -n "$v" ] && API_ROOT="$v"
    fi
    return 0
}

load_file_settings() {
    # Fill the non credential settings from the configuration files. A value
    # already present in the environment is left alone, and flags parsed later
    # override whatever is decided here.
    local v
    _from_file() {
        # _from_file ENV_NAME KEY: the file value in v, unless the environment
        # already sets ENV_NAME.
        local name="$1"
        [ -n "${!name:-}" ] && return 1
        v=$(lookup_setting "$2") || return 1
        [ -n "$v" ] || return 1
        return 0
    }
    _from_file TG_PING_FORMAT      TG_PING_FORMAT      && FORMAT=$(lc "$v")
    _from_file TG_PING_TIMEOUT     TG_PING_TIMEOUT     && TIMEOUT="$v"
    _from_file TG_PING_RETRIES     TG_PING_RETRIES     && RETRIES="$v"
    _from_file TG_PING_MAX_PARTS   TG_PING_MAX_PARTS   && MAX_PARTS="$v"
    _from_file TG_PING_TAIL        TG_PING_TAIL        && RUN_TAIL="$v"
    _from_file TG_PING_BAR_WIDTH   TG_PING_BAR_WIDTH   && BAR_WIDTH="$v"
    _from_file TG_PING_SOFT_FAIL   TG_PING_SOFT_FAIL   && SOFT_FAIL=$(bool01 "$v")
    _from_file TG_PING_DISABLED    TG_PING_DISABLED    && DISABLED=$(bool01 "$v")
    _from_file TG_PING_MATH_DPI    TG_PING_MATH_DPI    && MATH_DPI="$v"
    _from_file TG_PING_MATH_BG     TG_PING_MATH_BG     && MATH_BG=$(lc "$v")
    _from_file TG_PING_MATH_PREAMBLE TG_PING_MATH_PREAMBLE && MATH_PREAMBLE="$v"
    # shellcheck disable=SC2088  # the tilde is matched literally, then expanded
    case "$MATH_PREAMBLE" in "~/"*) MATH_PREAMBLE="$HOME/${MATH_PREAMBLE#\~/}" ;; esac
    _from_file TG_PING_MATH_REMOTE TG_PING_MATH_REMOTE && MATH_REMOTE_OK=$(bool01 "$v")
    _from_file TG_PING_MACHINE     TG_PING_MACHINE     && MACHINE="$v"
    _from_file TG_PING_MACHINE_ICON TG_PING_MACHINE_ICON && MACHINE_ICON="$v"
    _from_file TG_PING_AGENT       TG_PING_AGENT       && AGENT_MODE="$v"
    _from_file TG_PING_QUIET_HOURS TG_PING_QUIET_HOURS && QUIET_HOURS="$v"
    _from_file TG_PING_META        TG_PING_META        && META_FIELDS=$(lc "$v")
    _from_file TG_PING_TOPICS      TG_PING_TOPICS      && TOPICS_MODE=$(lc "$v")
    _from_file TG_PING_PROJECT     TG_PING_PROJECT     && PROJECT_MODE="$v"
    return 0
}

preparse_config_flags() {
    # Only the flags that decide which files are read. Everything else waits
    # for parse_common_args, so that flags keep the last word. A project file
    # may name one of the user's profiles when neither a flag nor the
    # environment does.
    local from_flag=0 v
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile|-P)        PROFILE="${2:-$PROFILE}"; from_flag=1; shift 2 || break ;;
            --env-file|--config) ENV_FILE="${2:-$ENV_FILE}"; shift 2 || break ;;
            --)                  break ;;
            *)                   shift ;;
        esac
    done
    if [ "$from_flag" -eq 0 ] && [ -z "${TG_PING_PROFILE:-}" ] &&
       [ "$(bool01 "${TG_PING_NO_DOTENV:-0}")" != "1" ]; then
        v=$(env_file_get ./.tg-ping.env TG_PING_PROFILE) && [ -n "$v" ] && PROFILE="$v"
    fi
    case "$PROFILE" in
        ''|.*|*[!A-Za-z0-9._-]*)
            die "$EX_USAGE" "'$PROFILE' is not a profile name (letters, digits, dot, dash and underscore, not starting with a dot)" ;;
    esac
    if [ -n "$ENV_FILE" ] && [ ! -f "$ENV_FILE" ] && [ -r "$ENV_FILE" ]; then
        # A pipe such as <(...) can be read only once; keep a copy to read from.
        cat "$ENV_FILE" > "$(workdir)/env-file" 2>/dev/null && ENV_FILE="$(workdir)/env-file"
        chmod 600 "$ENV_FILE" 2>/dev/null || true
    fi
    return 0
}

require_credentials() {
    if [ "$DISABLED" = "1" ]; then
        note "TG_PING_DISABLED is set, nothing is sent"
        exit "$EX_OK"
    fi
    load_config
    if [ -z "$TOKEN" ]; then
        die "$EX_CONFIG" "no bot token found.
  Set TG_PING_TOKEN, or run '$TG_PING_NAME init' to create a configuration file.
  See '$TG_PING_NAME doctor' for the exact locations that were searched."
    fi
    if [ -z "$CHATS" ]; then
        die "$EX_CONFIG" "no chat id found.
  Set TG_PING_CHAT_ID, pass --chat ID, or run '$TG_PING_NAME init'.
  '$TG_PING_NAME chats' lists every chat the bot has already seen."
    fi
    case "$TOKEN" in
        *:*) ;;
        *) warn "the token does not look like a Telegram bot token (expected digits, a colon, then the secret)" ;;
    esac
    local chat
    for chat in $(chat_list); do
        case "$chat" in
            -[0-9]*|[0-9]*) is_number "${chat#-}" || chat_id_invalid "$chat" ;;
            @[A-Za-z0-9_]*) ;;
            *) chat_id_invalid "$chat" ;;
        esac
    done
}

chat_id_invalid() {
    die "$EX_CONFIG" "'$1' is not a usable chat id.
  A chat id is a number such as 123456789 or -1001234567890, or a public
  channel name such as @my_channel. Run '$TG_PING_NAME chats' to see the ids
  the bot already knows, or '$TG_PING_NAME init' to configure one."
}

chat_list() {
    # Split the comma or space separated chat list into one id per line.
    # shellcheck disable=SC2020  # both separators are meant to become newlines
    printf '%s' "$CHATS" | tr ',;' '\n\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$'
}

# ---------------------------------------------------------------------------
# Escaping helpers
# ---------------------------------------------------------------------------

html_escape() {
    # Telegram HTML parse mode needs exactly these three replaced.
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

html_unescape() {
    sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e 's/&amp;/\&/g'
}

html_strip() {
    # Turn a rendered HTML message back into readable plain text. Used by the
    # automatic fallback when Telegram refuses to parse the markup.
    awk_run '{ gsub(/<br *\/?>/, "\n"); gsub(/<[^>]*>/, ""); print }' | html_unescape
}

md2_escape() {
    # Escape every character that MarkdownV2 treats as special.
    sed -e 's/\\/\\\\/g' -e 's/[][_*()~`>#+=|{}.!-]/\\&/g'
}

json_escape() {
    # Escape stdin for embedding inside a JSON string literal. Every control
    # character becomes \u00XX, since JSON forbids them raw (a colour code in
    # a log tail would otherwise break the request).
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" -e "s/$CR/\\\\r/g" |
        LC_ALL=C awk_run '
        BEGIN { ORS = ""; for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i }
        function ctrl(s,    out, c) {
            out = ""
            while (match(s, /[\001-\010\013\014\016-\037]/)) {
                c = substr(s, RSTART, 1)
                out = out substr(s, 1, RSTART - 1) sprintf("\\u%04x", ORD[c])
                s = substr(s, RSTART + 1)
            }
            return out s
        }
        { if (NR > 1) print "\\n"; print ctrl($0) }'
}

curl_conf_escape() {
    # Escape stdin for a double quoted value inside a curl configuration file.
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" |
        awk_run 'BEGIN{ORS=""} {if (NR>1) print "\\n"; print}'
}

# ---------------------------------------------------------------------------
# Reading JSON replies. jq is used when available, python3 next, and a small
# text extractor last so that the common paths work with curl alone.
# ---------------------------------------------------------------------------

json_get() {
    # json_get JSON DOTTED.PATH -> scalar value, empty when absent.
    local json="$1" path="$2"
    # A numeric element of the path indexes an array: result.0.message_id.
    if have jq; then
        printf '%s' "$json" | jq -r --arg p "$path" '
            def pick($p): reduce ($p | split(".")[]) as $k (.;
                if type == "object" then .[$k]
                elif type == "array" and ($k | test("^[0-9]+$")) then .[($k | tonumber)]
                else null end);
            pick($p) | if . == null then "" else tostring end' 2>/dev/null
        return 0
    fi
    if have python3; then
        TGP_JSON="$json" TGP_PATH="$path" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["TGP_JSON"])
except Exception:
    sys.exit(0)
for key in os.environ["TGP_PATH"].split("."):
    if isinstance(data, dict) and key in data:
        data = data[key]
    elif isinstance(data, list) and key.isdigit() and int(key) < len(data):
        data = data[int(key)]
    else:
        sys.exit(0)
if isinstance(data, bool):
    sys.stdout.write("true" if data else "false")
elif data is not None:
    sys.stdout.write(str(data))
' 2>/dev/null
        return 0
    fi
    # Last resort: the first occurrence of the final path element as a flat
    # key, which in a Telegram reply is the outermost one.
    printf '%s' "$json" | awk_run -v key="${path##*.}" '
        BEGIN { RS = "\001" }
        {
            p = index($0, "\"" key "\"")
            if (!p) exit
            s = substr($0, p + length(key) + 2)
            sub(/^[ \t\r\n]*:[ \t\r\n]*/, "", s)
            if (substr(s, 1, 1) == "\"") {
                s = substr(s, 2); e = index(s, "\""); print substr(s, 1, e - 1)
            } else if (match(s, /^-?[0-9]+/)) {
                print substr(s, RSTART, RLENGTH)
            } else if (s ~ /^true/) {
                print "true"
            } else if (s ~ /^false/) {
                print "false"
            }
            exit
        }'
}

need_json_reader() {
    have jq && return 0
    have python3 && return 0
    die "$EX_CONFIG" "'$1' reads incoming Telegram updates and needs jq or python3.
  Install one of them, for example:  sudo apt install -y jq"
}

# ---------------------------------------------------------------------------
# Transport
#
# Every request is handed to curl through a configuration file in the private
# working folder (curl --config FILE), deleted right after the request. The
# bot token therefore never appears in the process table, and field values
# are read from files, which removes all shell quoting concerns for arbitrary
# message text.
# ---------------------------------------------------------------------------

REQ_FIELDS=()
REQ_FILES=()

req_reset() { REQ_FIELDS=(); REQ_FILES=(); }

req_add() {
    # req_add NAME VALUE, skipped silently when the value is empty.
    [ -n "${2:-}" ] || return 0
    REQ_FIELDS[${#REQ_FIELDS[@]}]="$1=$2"
}

req_set() {
    # req_set NAME VALUE: replace the value of a field already added.
    local i=0
    while [ "$i" -lt "${#REQ_FIELDS[@]}" ]; do
        case "${REQ_FIELDS[$i]}" in
            "$1="*) REQ_FIELDS[i]="$1=$2" ;;
        esac
        i=$(( i + 1 ))
    done
}

req_unset() {
    # req_unset NAME: remove a field from the request.
    local kept=() entry
    for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
        case "$entry" in "$1="*) ;; *) kept[${#kept[@]}]="$entry" ;; esac
    done
    REQ_FIELDS=(${kept[@]+"${kept[@]}"})
}

req_file() {
    # req_file NAME PATH, attached as a multipart upload.
    REQ_FILES[${#REQ_FILES[@]}]="$1=$2"
}

req_reply() {
    # req_reply MESSAGE_ID: answer that message; the message still goes out
    # when the one it answers has been deleted. The word "last" stands for
    # the last message this project sent to the chat of the request.
    local id="${1:-}" chat="" entry
    [ -n "$id" ] || return 0
    if [ "$id" = "last" ]; then
        for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
            case "$entry" in chat_id=*) chat=${entry#chat_id=} ;; esac
        done
        id=$(cat "$(last_file "$chat")" 2>/dev/null || true)
        if ! is_number "$id" || [ "$id" = "0" ]; then
            note "no message of this project is remembered in chat $chat, sending without a reply"
            return 0
        fi
    fi
    req_add reply_parameters "{\"message_id\":$id,\"allow_sending_without_reply\":true}"
}

req_no_preview() {
    [ "$NO_PREVIEW" -eq 1 ] && req_add link_preview_options '{"is_disabled":true}'
    return 0
}

quiet_now() {
    # True inside the quiet hours (TG_PING_QUIET_HOURS=23-08, whole hours of
    # the local clock), when messages arrive without sound. Errors and
    # questions keep their sound.
    local from to h
    [ -n "$QUIET_HOURS" ] || return 1
    case "$(lc "$LEVEL")" in err|error|fail|question|ask|blocked) return 1 ;; esac
    from=${QUIET_HOURS%%-*}; to=${QUIET_HOURS#*-}
    { is_number "$from" && is_number "$to"; } || return 1
    from=$(( 10#$from )); to=$(( 10#$to ))
    h=$(( 10#$(date +%H) ))
    if [ "$from" -le "$to" ]; then
        [ "$h" -ge "$from" ] && [ "$h" -lt "$to" ]
    else
        [ "$h" -ge "$from" ] || [ "$h" -lt "$to" ]
    fi
}

req_silent() {
    # Silent on request, inside the quiet hours, and at the debug level.
    if [ "$SILENT" -eq 1 ] || quiet_now; then
        req_add disable_notification "true"
    else
        case "$(lc "$LEVEL")" in debug|trace) req_add disable_notification "true" ;; esac
    fi
    return 0
}

_write_value() {
    # Store a field value in the working directory and echo the file path.
    # The file is named after the field, because a counter incremented inside
    # a command substitution would not survive the subshell.
    local name="$1" wd f
    wd=$(workdir)
    f="$wd/field.$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
    printf '%s' "$2" > "$f"
    chmod 600 "$f" 2>/dev/null || true
    printf '%s' "$f"
}

_build_config() {
    # Emit a curl configuration file for METHOD on stdout.
    local method="$1" wd multipart=0 entry name value vfile
    wd=$(workdir)
    [ ${#REQ_FILES[@]} -gt 0 ] && multipart=1

    printf 'url = "%s/bot%s/%s"\n' "$(printf '%s' "$API_ROOT" | curl_conf_escape)" "$TOKEN" "$method"
    printf 'silent\nshow-error\nlocation\n'
    if [ ${#REQ_FILES[@]} -gt 0 ]; then
        # An upload may take minutes on a slow line: it is abandoned only when
        # it stalls, below 1 KiB/s for a minute, never at a fixed deadline.
        printf 'connect-timeout = %s\n' "$TIMEOUT"
        printf 'speed-limit = 1024\nspeed-time = 60\n'
    else
        printf 'max-time = %s\n' "$TIMEOUT"
    fi
    printf 'user-agent = "%s/%s"\n' "$TG_PING_NAME" "$TG_PING_VERSION"
    [ "$INSECURE" -eq 1 ] && printf 'insecure\n'

    for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
        name=${entry%%=*}
        value=${entry#*=}
        vfile=$(_write_value "$name" "$value")
        if [ "$multipart" -eq 1 ]; then
            printf 'form = "%s=<%s"\n' "$name" "$(printf '%s' "$vfile" | curl_conf_escape)"
        else
            printf 'data-urlencode = "%s@%s"\n' "$name" "$(printf '%s' "$vfile" | curl_conf_escape)"
        fi
    done

    for entry in ${REQ_FILES[@]+"${REQ_FILES[@]}"}; do
        name=${entry%%=*}
        value=${entry#*=}
        printf 'form = "%s=@%s"\n' "$name" "$(printf '%s' "$value" | curl_conf_escape)"
    done

    printf 'output = "%s"\n' "$wd/response.json"
    printf 'write-out = "%%{http_code}"\n'
}

_safe_path() {
    # curl's -F parser treats ; and , specially, and @ or < at the start of a
    # value have their own meaning. Copy such files under a tame name.
    local path="$1" wd base d
    case "$path" in
        *[\;\,\"]*|*$'\n'*)
            wd=$(workdir)
            base=$(printf '%s' "$(basename "$path")" | tr -c 'A-Za-z0-9._-' '_')
            # A folder of its own, so that two files of the same name never meet.
            d=$(mktemp -d "$wd/upload.XXXXXX") || die "$EX_FAIL" "cannot create a temporary folder"
            cp "$path" "$d/$base" || die "$EX_FAIL" "cannot read $path"
            printf '%s' "$d/$base"
            ;;
        *) printf '%s' "$path" ;;
    esac
}

TOPIC_FILE=""

topic_name() {
    # The name of this project's topic on this computer: "heat-equation · laptop".
    local root machine
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
    [ -n "$root" ] || root="$PWD"
    machine="$MACHINE"
    case "$(lc "$machine")" in ""|none|off|0|auto) machine=$(host_name) ;; esac
    printf '%s · %s\n' "$(basename "$root")" "$machine" | utf8_clean 120
}

topic_create() {
    # topic_create CHAT -> the id of a new topic for this project and this
    # computer. When the bot's topic mode is off, says so once a day and
    # fails, and messages go to the main chat meanwhile.
    local t rc
    t=$(cat "$(state_dir)/topics.off" 2>/dev/null || echo 0); is_number "$t" || t=0
    [ $(( $(date +%s) - t )) -lt 86400 ] && return 1
    req_reset
    req_add chat_id "$1"
    req_add name "$(topic_name)"
    api_call createForumTopic; rc=$?
    if [ "$rc" -eq 0 ]; then
        t=$(json_get "$API_BODY" "result.message_thread_id")
        is_number "$t" && { printf '%s' "$t"; return 0; }
        return 1
    fi
    # A network failure says nothing about the topics: they are tried again
    # with the next message.
    [ "$rc" -eq "$EX_API" ] || return 1
    warn "no topic could be made for this project ($API_ERROR); switch on Threaded Mode for the bot in @BotFather. Messages go to the main chat meanwhile"
    [ "$DRY_RUN" -eq 1 ] || atomic_write "$(state_dir)/topics.off" "$(date +%s)" || true
    return 1
}

topic_inject() {
    # topic_inject METHOD: with TG_PING_TOPICS=project, a message sent without
    # a topic of its own goes to the topic of this project and this computer,
    # made the first time. Returns 0 when it added one.
    local chat="" entry id file
    TOPIC_FILE=""
    [ "$TOPICS_MODE" = "project" ] || return 1
    case "$1" in send*) ;; *) return 1 ;; esac
    for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
        case "$entry" in
            chat_id=*)           chat=${entry#chat_id=} ;;
            message_thread_id=*) return 1 ;;
        esac
    done
    [ -n "$chat" ] || return 1
    file="$(state_dir)/topic.$(slot_name "$chat").$(slot_name "$(project_key)")"
    id=$(cat "$file" 2>/dev/null || true)
    if ! is_number "$id"; then
        # A subshell: the request being built stays untouched.
        id=$(topic_create "$chat") || return 1
        [ "$DRY_RUN" -eq 1 ] || atomic_write "$file" "$id" || true
    fi
    req_add message_thread_id "$id"
    TOPIC_FILE="$file"
    return 0
}

fake_reply() {
    # The reply a dry or disabled run pretends to receive, shaped like the
    # real one so that the code reading it follows its usual path.
    case "$1" in
        getUpdates)     printf '{"ok":true,"result":[]}' ;;
        sendMediaGroup) printf '{"ok":true,"result":[{"message_id":0}]}' ;;
        getMe)          printf '{"ok":true,"result":{"id":0,"first_name":"dry run","username":"dry_run"}}' ;;
        *)              printf '{"ok":true,"result":{"message_id":0}}' ;;
    esac
}

dry_run_dump() {
    local method="$1" entry name value
    printf '%s\n' "--- $TG_PING_NAME dry run ---"
    printf 'endpoint : %s/bot<TOKEN>/%s\n' "$API_ROOT" "$method"
    for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
        name=${entry%%=*}; value=${entry#*=}
        printf 'field    : %s = %s\n' "$name" "$value" | redact
    done
    for entry in ${REQ_FILES[@]+"${REQ_FILES[@]}"}; do
        name=${entry%%=*}; value=${entry#*=}
        printf 'upload   : %s = %s\n' "$name" "$value"
    done
    printf '%s\n' "--- end of dry run ---"
}

api_call() {
    # api_call METHOD. Sets API_HTTP, API_BODY and API_ERROR.
    # Returns 0 when Telegram answered ok:true, otherwise an EX_* code.
    local method="$1" attempt=0 rc delay retry_after wd cfg migrated=0 newchat topic_retried=0 entry chat
    API_HTTP=""; API_BODY=""; API_ERROR=""
    topic_inject "$method" || TOPIC_FILE=""

    if [ "$DISABLED" = "1" ]; then
        note "TG_PING_DISABLED is set, skipping the $method call"
        API_BODY=$(fake_reply "$method")
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_run_dump "$method" >&2
        API_BODY=$(fake_reply "$method")
        return 0
    fi

    have curl || die "$EX_CONFIG" "curl is required but was not found (sudo apt install -y curl)"

    wd=$(workdir); cfg="$wd/curl.cfg"
    while :; do
        attempt=$(( attempt + 1 ))
        ( umask 077; _build_config "$method" > "$cfg" )
        rm -f "$wd/response.json"

        # Descriptor 8 holds the lock of the update reader (see inbox_lock);
        # curl must not inherit it.
        API_HTTP=$(curl --config "$cfg" 2>"$wd/curl.err" 8>&-)
        rc=$?
        # The configuration holds the token: it lives only as long as the request.
        rm -f "$cfg"
        [ -f "$wd/response.json" ] && API_BODY=$(cat "$wd/response.json") || API_BODY=""

        if [ "$rc" -ne 0 ] && [ -z "$API_BODY" ]; then
            API_ERROR="curl failed with exit code $rc: $(tr -d '\n' < "$wd/curl.err" | redact)"
            if [ "$attempt" -le "$RETRIES" ]; then
                delay=$(( attempt * attempt ))
                note "$API_ERROR, retrying in ${delay}s (attempt $attempt of $RETRIES)"
                sleep "$delay"; continue
            fi
            return "$EX_NET"
        fi

        case "$API_HTTP" in
            2*)
                if [ "$(json_get "$API_BODY" "ok")" = "true" ]; then
                    note "$method succeeded (HTTP $API_HTTP)"
                    return 0
                fi
                API_ERROR=$(json_get "$API_BODY" "description")
                [ -n "$API_ERROR" ] || API_ERROR="unexpected reply: $API_BODY"
                return "$EX_API"
                ;;
            429)
                retry_after=$(json_get "$API_BODY" "parameters.retry_after")
                is_number "$retry_after" || retry_after=$(( attempt * 5 ))
                API_ERROR="rate limited by Telegram, retry_after=${retry_after}s"
                # A progress update can be skipped rather than block its caller.
                [ "$NO_RATE_WAIT" -eq 1 ] && return "$EX_RATE"
                [ "$retry_after" -gt 300 ] && retry_after=300
                if [ "$attempt" -le "$RETRIES" ]; then
                    note "$API_ERROR, waiting (attempt $attempt of $RETRIES)"
                    sleep "$retry_after"; continue
                fi
                return "$EX_RATE"
                ;;
            5*)
                API_ERROR="Telegram server error (HTTP $API_HTTP)"
                if [ "$attempt" -le "$RETRIES" ]; then
                    delay=$(( attempt * attempt ))
                    note "$API_ERROR, retrying in ${delay}s"
                    sleep "$delay"; continue
                fi
                return "$EX_API"
                ;;
            *)
                API_ERROR=$(json_get "$API_BODY" "description")
                [ -n "$API_ERROR" ] || API_ERROR="HTTP $API_HTTP"
                # A group upgraded to a supergroup has a new id: send there
                # once, and say which id the settings should now hold.
                newchat=$(json_get "$API_BODY" "parameters.migrate_to_chat_id")
                if [ "$migrated" -eq 0 ] && is_number "${newchat#-}"; then
                    migrated=1
                    warn "the group became a supergroup with the new id $newchat; put that id in TG_PING_CHAT_ID"
                    req_set chat_id "$newchat"
                    attempt=$(( attempt - 1 ))
                    continue
                fi
                # A project topic deleted in Telegram is made again, once.
                # When no topic works, the message goes to the main chat and
                # the topics rest for a day, so that nothing is lost to them.
                if [ -n "$TOPIC_FILE" ]; then
                    case "$API_ERROR" in
                        *"thread not found"*|*TOPIC_DELETED*|*TOPIC_CLOSED*)
                            rm -f "$TOPIC_FILE"
                            if [ "$topic_retried" -eq 0 ]; then
                                topic_retried=1
                                for entry in ${REQ_FIELDS[@]+"${REQ_FIELDS[@]}"}; do
                                    case "$entry" in chat_id=*) chat=${entry#chat_id=} ;; esac
                                done
                                if newchat=$(topic_create "$chat"); then
                                    atomic_write "$TOPIC_FILE" "$newchat" || true
                                    req_set message_thread_id "$newchat"
                                    attempt=$(( attempt - 1 ))
                                    continue
                                fi
                            else
                                atomic_write "$(state_dir)/topics.off" "$(date +%s)" || true
                            fi
                            warn "the project topic cannot be used ($API_ERROR); this message goes to the main chat"
                            TOPIC_FILE=""
                            req_unset message_thread_id
                            attempt=$(( attempt - 1 ))
                            continue ;;
                    esac
                fi
                return "$EX_API"
                ;;
        esac
    done
}

api_explain() {
    # Turn the raw Telegram complaint into advice the caller can act on.
    local err="$1"
    case "$err" in
        *"chat not found"*)
            printf '%s\n' "$err
  The bot cannot reach that chat id. Open Telegram, send /start to your bot,
  then run '$TG_PING_NAME chats' to read the correct id. For a channel the bot
  must be an administrator, and the id looks like -1001234567890." ;;
        *"bot was blocked"*)
            printf '%s\n' "$err
  Unblock the bot in Telegram and send it /start again." ;;
        *"Unauthorized"*|*"unauthorized"*)
            printf '%s\n' "$err
  The bot token is wrong or was revoked. Ask @BotFather for the current token." ;;
        *"can't parse entities"*|*"can't find end"*)
            printf '%s\n' "$err
  The markup was rejected. Use --format plain, or let the automatic plain text
  fallback handle it (it is on unless --no-fallback is given)." ;;
        *"message thread not found"*)
            printf '%s\n' "$err
  The --topic id does not exist in that group, or the group has no topics." ;;
        *) printf '%s\n' "$err" ;;
    esac
}

last_file() {
    # last_file CHAT -> where the last message sent to CHAT from this project
    # is remembered, for 'edit --last' and 'delete --last'.
    printf '%s/last.%s.%s' "$(state_dir)" "$(slot_name "$1")" "$(slot_name "$(project_key)")"
}

report_result() {
    # Common success reporting for the sending commands; the message is also
    # remembered as the last one of this project in that chat.
    local chat="$1" mid
    mid=$(json_get "$API_BODY" "result.message_id")
    [ -n "$mid" ] || mid=$(json_get "$API_BODY" "result.0.message_id")
    if is_number "$mid" && [ "$mid" != "0" ] && [ "$DRY_RUN" -eq 0 ] && [ "$DISABLED" != "1" ]; then
        atomic_write "$(last_file "$chat")" "$mid" || true
    fi
    if [ "$JSON_OUT" -eq 1 ]; then
        printf '%s\n' "$API_BODY"
    elif [ "$VERBOSE" -eq 1 ]; then
        msg "sent to chat $chat (message $mid)"
    fi
}

# ---------------------------------------------------------------------------
# Formatting
#
# The default format is "auto": the caller writes light Markdown, the tool
# emits correctly escaped Telegram HTML, and if Telegram still refuses the
# markup the message is resent as literal plain text. A notification is never
# lost because an agent happened to write an underscore.
# ---------------------------------------------------------------------------

level_emoji() {
    case "$(lc "${1:-}")" in
        start|begin|run)      printf '\xf0\x9f\x9a\x80' ;;   # rocket
        info|note)            printf '\xe2\x84\xb9\xef\xb8\x8f' ;;
        ok|success|done)      printf '\xe2\x9c\x85' ;;
        warn|warning)         printf '\xe2\x9a\xa0\xef\xb8\x8f' ;;
        err|error|fail)       printf '\xe2\x9d\x8c' ;;
        question|ask)         printf '\xe2\x9d\x93' ;;
        debug|trace)          printf '\xf0\x9f\x90\x9b' ;;
        progress|working)     printf '\xe2\x8f\xb3' ;;
        math|result)          printf '\xf0\x9f\x93\x90' ;;
        partial)              printf '\xf0\x9f\x9f\xa1' ;;   # yellow circle
        blocked)              printf '\xe2\x9b\x94' ;;       # no entry
        *)                    printf '' ;;
    esac
}

# The inline rules of light Markdown, shared by the classic and the rich
# formats. With MATH=1, $...$ becomes an inline formula of a rich message.
MD_INLINE_AWK='
    function esc(s) {
        gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s)
        return s
    }
    # Fragments already rendered to HTML are parked behind a placeholder so
    # that later inline rules cannot corrupt them (a URL full of underscores,
    # or Markdown characters inside a code span).
    function store(html) {
        nfrag++; frag[nfrag] = html
        return SOH nfrag STX
    }
    function restore(s,    p, q, id) {
        while ((p = index(s, SOH)) > 0) {
            q = index(substr(s, p), STX)
            if (q == 0) break
            id = substr(s, p + 1, q - 2) + 0
            s = substr(s, 1, p - 1) frag[id] substr(s, p + q)
        }
        return s
    }
    function wrap(s, re, o, c, dlen, guard,    out, pre, m, body, prevch, nextch, ok) {
        out = ""
        while (match(s, re)) {
            pre = substr(s, 1, RSTART - 1)
            m   = substr(s, RSTART, RLENGTH)
            if (RSTART > 1)           prevch = substr(s, RSTART - 1, 1)
            else if (length(out) > 0) prevch = substr(out, length(out), 1)
            else                      prevch = ""
            nextch = substr(s, RSTART + RLENGTH, 1)
            ok = 1
            body = substr(m, dlen + 1, RLENGTH - 2 * dlen)
            if (guard) {
                # An underscore belongs to the word: snake_case and __init__
                # are names, not emphasis.
                if (prevch ~ /[A-Za-z0-9_]/) ok = 0
                if (nextch ~ /[A-Za-z0-9_]/) ok = 0
            }
            # A bare identifier between double underscores is a Python name
            # such as __init__, not underlined text.
            if (guard == 2 && body ~ /^[A-Za-z0-9]+$/) ok = 0
            out = out pre (ok ? store(o body c) : m)
            s = substr(s, RSTART + RLENGTH)
        }
        return out s
    }
    function links(s,    out, m, pre, lab, url, p) {
        out = ""
        while (match(s, "\\[[^]\\[]*\\]\\([^)]*\\)")) {
            pre = substr(s, 1, RSTART - 1)
            m   = substr(s, RSTART, RLENGTH)
            p   = index(m, "](")
            lab = substr(m, 2, p - 2)
            url = substr(m, p + 2, length(m) - p - 2)
            gsub(/"/, "\\&quot;", url)
            out = out pre store("<a href=\"" url "\">" lab "</a>")
            s = substr(s, RSTART + RLENGTH)
        }
        return out s
    }
    function math_spans(s,    out, pre, m, prevch, nextch) {
        # Pandoc rule: no blank just inside the dollars, no digit right after
        # the closing one, and \$ is a dollar, so "$5 and $10" stays text.
        out = ""
        while (match(s, /\$[^ $]([^$]*[^ $\\])?\$/)) {
            pre = substr(s, 1, RSTART - 1); m = substr(s, RSTART, RLENGTH)
            prevch = (RSTART > 1) ? substr(s, RSTART - 1, 1) : ""
            nextch = substr(s, RSTART + RLENGTH, 1)
            if (prevch == "\\" || nextch ~ /[0-9]/) {
                out = out pre "$"; s = substr(s, RSTART + 1); continue
            }
            out = out pre store("<tg-math>" substr(m, 2, RLENGTH - 2) "</tg-math>")
            s = substr(s, RSTART + RLENGTH)
        }
        return out s
    }
    function inline(s) {
        # Code spans first: whatever sits inside them stays literal.
        while (match(s, "`[^`]+`"))
            s = substr(s, 1, RSTART - 1) \
                store("<code>" substr(s, RSTART + 1, RLENGTH - 2) "</code>") \
                substr(s, RSTART + RLENGTH)
        # Formulas next, so that emphasis cannot reach inside them.
        if (MATH) s = math_spans(s)
        s = links(s)
        # Emphasis needs a non-blank character just inside each marker, so
        # that f(*args, **kwargs) and a || b || c stay literal.
        s = wrap(s, "\\*\\*[^* ]([^*]*[^* ])?\\*\\*", "<b>", "</b>", 2, 0)
        s = wrap(s, "__[^_ ]([^_]*[^_ ])?__",         "<u>", "</u>", 2, 2)
        s = wrap(s, "~~[^~ ]([^~]*[^~ ])?~~",         "<s>", "</s>", 2, 0)
        s = wrap(s, "\\|\\|[^| ]([^|]*[^| ])?\\|\\|", "<tg-spoiler>", "</tg-spoiler>", 2, 0)
        s = wrap(s, "\\*[^* ]([^*]*[^* ])?\\*",       "<b>", "</b>", 1, 1)
        s = wrap(s, "_[^_ ]([^_]*[^_ ])?_",           "<i>", "</i>", 1, 1)
        return restore(s)
    }
    BEGIN {
        SOH = sprintf("%c", 1); STX = sprintf("%c", 2)
        nfrag = 0; incode = 0; inquote = 0; nolang = 0
    }
'

md_to_html() {
    # Convert light Markdown on stdin into Telegram HTML on stdout.
    awk_run "$MD_INLINE_AWK"'
    {
        line = $0
        if (line ~ /^[[:space:]]*```/) {
            if (incode) { print (nolang ? "</pre>" : "</code></pre>"); incode = 0 }
            else {
                lang = line
                sub(/^[[:space:]]*```[[:space:]]*/, "", lang)
                gsub(/[^A-Za-z0-9+#._-]/, "", lang)
                nolang = (lang == "")
                if (nolang) printf "<pre>"
                else        printf "<pre><code class=\"language-%s\">", lang
                incode = 1
            }
            next
        }
        if (incode) { print esc(line); next }

        if (line ~ /^[[:space:]]*>[[:space:]]?/) {
            if (!inquote) { printf "<blockquote>"; inquote = 1 }
            sub(/^[[:space:]]*>[[:space:]]?/, "", line)
            print inline(esc(line))
            next
        } else if (inquote) { print "</blockquote>"; inquote = 0 }

        if (line ~ /^[[:space:]]*#{1,6}[[:space:]]+/) {
            sub(/^[[:space:]]*#{1,6}[[:space:]]+/, "", line)
            print "<b>" inline(esc(line)) "</b>"
            next
        }
        if (line ~ /^[[:space:]]*[-*+][[:space:]]+/) {
            indent = line
            sub(/[^ \t].*$/, "", indent)
            sub(/^[[:space:]]*[-*+][[:space:]]+/, "", line)
            print indent "\342\200\242 " inline(esc(line))
            next
        }
        print inline(esc(line))
    }
    END {
        if (incode)  print (nolang ? "</pre>" : "</code></pre>")
        if (inquote) print "</blockquote>"
    }
    '
}

md_to_rich() {
    # Convert light Markdown on stdin into the HTML of a rich message: blocks
    # (paragraphs, headings, lists, quotations, code, tables, display
    # formulas between $$) and the same inline rules, with $...$ as inline
    # formulas. Lines of a paragraph are joined by <br>.
    awk_run -v MATH=1 "$MD_INLINE_AWK"'
    function close_para()  { if (inpara)  { printf "</p>"; inpara = 0 } }
    function close_quote() { if (inquote) { printf "</blockquote>"; inquote = 0 } }
    function close_list()  { if (inlist != "") { printf "</%s>", inlist; inlist = "" } }
    function cells(row, out,    n, i) {
        sub(/^[ \t]*\|/, "", row); sub(/\|[ \t]*$/, "", row)
        n = split(row, out, "|")
        for (i = 1; i <= n; i++) gsub(/^[ \t]+|[ \t]+$/, "", out[i])
        return n
    }
    function close_table(    r, c, n, sepline, head, tag, al) {
        if (!nrows) return
        sepline = (nrows > 1 && rows[2] ~ /^[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*$/)
        if (sepline) {
            n = cells(rows[2], sep)
            for (c = 1; c <= n; c++)
                align[c] = (sep[c] ~ /^:.*:$/) ? "center" : (sep[c] ~ /:$/) ? "right" : ""
        }
        printf "<table bordered striped compact>"
        for (r = 1; r <= nrows; r++) {
            if (sepline && r == 2) continue
            n = cells(rows[r], row)
            tag = (sepline && r == 1) ? "th" : "td"
            printf "<tr>"
            for (c = 1; c <= n; c++) {
                al = (sepline && align[c] != "") ? " align=\"" align[c] "\"" : ""
                printf "<%s%s>%s</%s>", tag, al, inline(esc(row[c])), tag
            }
            printf "</tr>"
        }
        printf "</table>"
        nrows = 0; delete align
    }
    function close_all() { close_para(); close_quote(); close_list(); close_table() }
    BEGIN { inpara = 0; inlist = ""; nrows = 0; inmath = 0 }
    {
        line = $0
        if (inmath) {
            if (line ~ /\$\$[ \t]*$/) {
                sub(/\$\$[ \t]*$/, "", line)
                mathbuf = mathbuf (mathbuf != "" ? "\n" : "") line
                printf "<tg-math-block>%s</tg-math-block>", esc(mathbuf)
                inmath = 0; mathbuf = ""
            } else mathbuf = mathbuf (mathbuf != "" ? "\n" : "") line
            next
        }
        if (incode) {
            if (line ~ /^[ \t]*```/) { printf (nolang ? "</pre>" : "</code></pre>"); incode = 0 }
            else { printf "%s%s", (codefirst ? "" : "\n"), esc(line); codefirst = 0 }
            next
        }
        if (line ~ /^[ \t]*```/) {
            close_all()
            lang = line
            sub(/^[ \t]*```[ \t]*/, "", lang); gsub(/[^A-Za-z0-9+#._-]/, "", lang)
            nolang = (lang == "")
            if (nolang) printf "<pre>"; else printf "<pre><code class=\"language-%s\">", lang
            incode = 1; codefirst = 1
            next
        }
        if (line ~ /^[ \t]*\$\$/) {
            close_all()
            sub(/^[ \t]*\$\$/, "", line)
            if (line ~ /\$\$[ \t]*$/) {
                sub(/\$\$[ \t]*$/, "", line)
                printf "<tg-math-block>%s</tg-math-block>", esc(line)
            } else { inmath = 1; mathbuf = line }
            next
        }
        if (line ~ /^[ \t]*$/) { close_all(); next }
        if (line ~ /^[ \t]*\|.*\|[ \t]*$/) {
            close_para(); close_quote(); close_list()
            rows[++nrows] = line
            next
        }
        close_table()
        if (line ~ /^[ \t]*>/) {
            close_para(); close_list()
            sub(/^[ \t]*>[ \t]?/, "", line)
            if (inquote) printf "<br>%s", inline(esc(line))
            else { printf "<blockquote>%s", inline(esc(line)); inquote = 1 }
            next
        }
        close_quote()
        if (line ~ /^[ \t]*#+[ \t]+/) {
            close_all()
            lvl = line; sub(/^[ \t]*/, "", lvl); sub(/[ \t].*$/, "", lvl)
            n = length(lvl); if (n > 6) n = 6
            sub(/^[ \t]*#+[ \t]+/, "", line)
            printf "<h%d>%s</h%d>", n, inline(esc(line)), n
            next
        }
        if (line ~ /^[ \t]*(-[ \t]*-[ \t]*-[- \t]*|\*[ \t]*\*[ \t]*\*[* \t]*)$/) { close_all(); printf "<hr/>"; next }
        if (line ~ /^[ \t]*[-*+][ \t]+/) {
            close_para()
            if (inlist != "ul") { close_list(); printf "<ul>"; inlist = "ul" }
            sub(/^[ \t]*[-*+][ \t]+/, "", line)
            if (line ~ /^\[[ xX]\][ \t]/) {
                box = (substr(line, 2, 1) == " ") ? "<input type=\"checkbox\">" : "<input type=\"checkbox\" checked>"
                printf "<li>%s%s</li>", box, inline(esc(substr(line, 5)))
            } else printf "<li>%s</li>", inline(esc(line))
            next
        }
        if (line ~ /^[ \t]*[0-9]+[.)][ \t]+/) {
            close_para()
            if (inlist != "ol") { close_list(); printf "<ol>"; inlist = "ol" }
            sub(/^[ \t]*[0-9]+[.)][ \t]+/, "", line)
            printf "<li>%s</li>", inline(esc(line))
            next
        }
        close_list()
        if (inpara) printf "<br>%s", inline(esc(line))
        else { printf "<p>%s", inline(esc(line)); inpara = 1 }
    }
    END {
        if (incode) printf (nolang ? "</pre>" : "</code></pre>")
        if (inmath) printf "<tg-math-block>%s</tg-math-block>", esc(mathbuf)
        close_all()
    }'
}

format_text() {
    # format_text TEXT -> markup in the active format.
    local text="$1"
    case "$FORMAT" in
        auto|rich) printf '%s' "$text" | md_to_html ;;
        html)     printf '%s' "$text" ;;
        markdown) printf '%s' "$text" ;;
        *)        printf '%s' "$text" ;;
    esac
}

fmt_escape() {
    # Escape a literal fragment (a title, a field name) for the active format.
    case "$FORMAT" in
        auto|html|rich) printf '%s' "$1" | html_escape ;;
        markdown)  printf '%s' "$1" | md2_escape ;;
        *)         printf '%s' "$1" ;;
    esac
}

fmt_bold() {
    case "$FORMAT" in
        auto|html|rich) printf '<b>%s</b>' "$(fmt_escape "$1")" ;;
        markdown)  printf '*%s*' "$(fmt_escape "$1")" ;;
        *)         printf '%s' "$1" ;;
    esac
}

fmt_italic() {
    case "$FORMAT" in
        auto|html|rich) printf '<i>%s</i>' "$(fmt_escape "$1")" ;;
        markdown)  printf '_%s_' "$(fmt_escape "$1")" ;;
        *)         printf '%s' "$1" ;;
    esac
}

fmt_code_block() {
    # fmt_code_block CONTENT [LANGUAGE]
    local content="$1" lang="${2:-}"
    case "$FORMAT" in
        auto|html|rich)
            if [ -n "$lang" ]; then
                printf '<pre><code class="language-%s">%s</code></pre>' \
                    "$(printf '%s' "$lang" | tr -cd 'A-Za-z0-9+#._-')" \
                    "$(printf '%s' "$content" | html_escape)"
            else
                printf '<pre>%s</pre>' "$(printf '%s' "$content" | html_escape)"
            fi ;;
        markdown)
            # shellcheck disable=SC2016  # the backticks are literal Markdown
            printf '```%s\n%s\n```' "$lang" "$(printf '%s' "$content" | sed -e 's/\\/\\\\/g' -e 's/`/\\`/g')" ;;
        *)
            printf '%s' "$content" ;;
    esac
}

fmt_quote() {
    # fmt_quote CONTENT EXPANDABLE
    local content="$1" expandable="${2:-0}"
    case "$FORMAT" in
        auto|html|rich)
            if [ "$expandable" -eq 1 ]; then
                printf '<blockquote expandable>%s</blockquote>' "$(printf '%s' "$content" | html_escape)"
            else
                printf '<blockquote>%s</blockquote>' "$(printf '%s' "$content" | html_escape)"
            fi ;;
        markdown)
            printf '%s' "$content" | md2_escape | sed -e 's/^/>/' ;;
        *)
            printf '%s' "$content" | sed -e 's/^/| /' ;;
    esac
}

percent_value() {
    # percent_value VALUE -> a whole percentage from 45, 45.5 or 37/512.
    local v="$1" k n int frac
    case "$v" in
        */*)
            k=${v%%/*}; n=${v#*/}
            if is_number "$k" && is_number "$n" && [ "$n" -gt 0 ]; then
                printf '%s' $(( (k * 100 + n / 2) / n ))
            else
                printf '0'
            fi ;;
        *.*)
            int=${v%%.*}; frac=${v#*.}
            { is_number "${int:-0}" && is_number "$frac"; } || { printf '0'; return 0; }
            int=$(( 10#${int:-0} ))
            case "$frac" in [5-9]*) int=$(( int + 1 )) ;; esac
            printf '%s' "$int" ;;
        *)
            if is_number "$v"; then printf '%s' $(( 10#$v )); else printf '0'; fi ;;
    esac
}

progress_bar() {
    # progress_bar VALUE [WIDTH] -> a filled bar, then the percentage, after
    # the count itself when VALUE is a count of a total (37/512).
    local value="$1" width="${2:-12}" pct filled i out="" label=""
    pct=$(percent_value "$value")
    [ "$pct" -gt 100 ] && pct=100
    case "$value" in */*) label="$value · " ;; esac
    filled=$(( pct * width / 100 ))
    i=0
    while [ "$i" -lt "$width" ]; do
        if [ "$i" -lt "$filled" ]; then out="${out}▰"; else out="${out}▱"; fi
        i=$(( i + 1 ))
    done
    printf '%s %s%s%%' "$out" "$label" "$pct"
}

# Text measured and cut the way Telegram counts it. Every awk program below
# runs under LC_ALL=C and works on bytes, identically in gawk, mawk and
# busybox awk: a character is a lead byte with its continuation bytes
# (\200-\277), and one outside the basic plane (lead byte \360-\364) counts
# twice, as Telegram counts UTF-16 units.
# shellcheck disable=SC2016  # awk code, not shell expansions
U8_AWK='
function u8_init(   i) { for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i }
function u8_valid(s) {
    return s ~ /^([\001-\177]|[\302-\337][\200-\277]|[\340-\357][\200-\277][\200-\277]|[\360-\364][\200-\277][\200-\277][\200-\277])*$/
}
function u8_clean(s,    out, i, n, c, cc, k, len, ok) {
    # Every byte that does not belong to a valid sequence becomes U+FFFD.
    if (s !~ /[\200-\377]/ || u8_valid(s)) return s
    out = ""; n = length(s); i = 1
    while (i <= n) {
        c = ORD[substr(s, i, 1)]
        if (c < 128) { out = out substr(s, i, 1); i++; continue }
        len = (c >= 194 && c <= 223) ? 2 : (c >= 224 && c <= 239) ? 3 : (c >= 240 && c <= 244) ? 4 : 0
        ok = (len > 0 && i + len - 1 <= n)
        for (k = 1; ok && k < len; k++) {
            cc = ORD[substr(s, i + k, 1)]
            if (cc < 128 || cc > 191) ok = 0
        }
        if (ok) { out = out substr(s, i, len); i += len }
        else    { out = out "\357\277\275"; i++ }
    }
    return out
}
function vis_len(s, mode,    t, n) {
    # Length after Telegram parses the markup: tags count nothing, an entity
    # counts one.
    t = s
    if (mode == "html") {
        gsub(/<[^<>]*>/, "", t)
        gsub(/&(#[0-9]+|#[xX][0-9A-Fa-f]+|[A-Za-z]+);/, "e", t)
    }
    n = length(t)
    n -= gsub(/[\200-\277]/, "", t)
    n += gsub(/[\360-\364]/, "", t)
    return n
}
'

# shellcheck disable=SC2016  # awk code, not shell expansions
SPLIT_AWK='
BEGIN {
    u8_init()
    KNOWN = "|b|strong|i|em|u|ins|s|strike|del|span|tg-spoiler|code|pre|a|blockquote|"
    ATOMS = "|tg-emoji|tg-time|tg-math|tg-math-block|"
    part = 0; sp = 0; buf = ""; bufn = 0; has = 0; fence = ""; lastsp = 0
}
function tag_name(t,   n) { n = t; sub(/^<\/?/, "", n); sub(/[^A-Za-z0-9-].*$/, "", n); return tolower(n) }
function OPEN(   k, o) {
    if (MODE == "md2") return (fence != "" ? fence "\n" : "")
    o = ""; for (k = 1; k <= sp; k++) o = o SO[k]
    return o
}
function CLOSE(   k, o) {
    if (MODE == "md2") return (fence != "" ? "\n```" : "")
    o = ""; for (k = sp; k >= 1; k--) o = o "</" SN[k] ">"
    return o
}
function apply_tag(t,   name, k) {
    name = tag_name(t)
    if (index(KNOWN, "|" name "|") == 0) return
    if (substr(t, 2, 1) == "/") {
        for (k = sp; k >= 1; k--) if (SN[k] == name) { sp = k - 1; return }
        return
    }
    sp++; SN[sp] = name; SO[sp] = t
}
function scan(line,   s) {
    if (MODE == "md2") {
        if (line ~ /^[ \t]*```/) fence = (fence == "" ? line : "")
        return
    }
    if (MODE != "html") return
    s = line
    while (match(s, /<\/?[A-Za-z][A-Za-z0-9-]*[^<>]*>/)) {
        apply_tag(substr(s, RSTART, RLENGTH))
        s = substr(s, RSTART + RLENGTH)
    }
}
function emit(body,   f) {
    if (vis_len(body, MODE) == 0) return
    part++
    f = sprintf("%s/%s.%03d", DIR, PREFIX, part)
    printf "%s", body > f
    close(f)
}
function end_part() {
    if (!has) return
    emit(buf CLOSE())
    buf = OPEN(); bufn = 0; has = 0; lastsp = 0
}
function snap(   k) { ssp = sp; for (k = 1; k <= sp; k++) { SSN[k] = SN[k]; SSO[k] = SO[k] }; sfence = fence }
function restore(   k) { sp = ssp; for (k = 1; k <= sp; k++) { SN[k] = SSN[k]; SO[k] = SSO[k] }; fence = sfence }
function seqlen(o) { return (o >= 240 ? 4 : o >= 224 ? 3 : o >= 192 ? 2 : 1) }
function token(s,   c, o, n, name, close_at, room) {
    # Sets TL (bytes), TU (units counted by Telegram) and TK (tag, atom,
    # space or text) for the token that starts s.
    c = substr(s, 1, 1); TK = "text"
    if (MODE == "html" && c == "<" && match(s, /^<\/?[A-Za-z][A-Za-z0-9-]*[^<>]*>/)) {
        n = RLENGTH
        name = tag_name(substr(s, 1, n))
        if (index(ATOMS, "|" name "|") && substr(s, 2, 1) != "/") {
            close_at = index(s, "</" name ">")
            if (close_at > 0) {
                TL = close_at + length(name) + 2
                TU = vis_len(substr(s, 1, TL), MODE); TK = "atom"; return
            }
        }
        if (index(KNOWN, "|" name "|")) { TL = n; TU = 0; TK = "tag"; return }
    }
    if (MODE == "html" && c == "&" && match(s, /^&(#[0-9]+|#[xX][0-9A-Fa-f]+|[A-Za-z]+);/)) {
        TL = RLENGTH; TU = 1; return
    }
    if (MODE == "md2" && c == "\\" && length(s) > 1) {
        TL = 1 + seqlen(ORD[substr(s, 2, 1)]); TU = 2; return
    }
    if (c == " ") { TL = 1; TU = 1; TK = "space"; return }
    o = ORD[c]
    if (o >= 128) { TL = seqlen(o); TU = (o >= 240 ? 2 : 1); return }
    if (match(s, /^[^<& \\\200-\377]+/)) {
        n = RLENGTH; room = B - bufn
        if (room < 1) room = 1
        if (n > room) n = room
        TL = n; TU = n; return
    }
    TL = 1; TU = 1
}
function stream(s,   tok, head, tail) {
    # A line longer than the budget, cut at the last space of the final
    # fifth of a part when there is one, at a token boundary otherwise.
    while (s != "") {
        token(s)
        if (has && bufn + TU > B) {
            if (lastsp > 0 && spn >= int(B * 4 / 5)) {
                head = substr(buf, 1, lastsp); tail = substr(buf, lastsp + 1)
                restore()
                emit(head CLOSE())
                buf = OPEN() tail; bufn = vis_len(tail, MODE); has = (bufn > 0); lastsp = 0
                scan(tail)
            } else {
                end_part()
            }
            continue
        }
        tok = substr(s, 1, TL)
        buf = buf tok; bufn += TU
        if (TU > 0) has = 1
        if (TK == "tag") apply_tag(tok)
        s = substr(s, TL + 1)
        if (TK == "space") { lastsp = length(buf); spn = bufn; snap() }
    }
}
{
    line = u8_clean($0)
    ln = vis_len(line, MODE)
    if (has && bufn + 1 + ln <= B) { buf = buf "\n" line; bufn += 1 + ln; scan(line); next }
    if (!has && bufn + ln <= B)    { buf = buf line; bufn += ln; if (ln > 0) has = 1; scan(line); next }
    if (ln <= B) {
        end_part()
        buf = buf line; bufn = ln; has = (ln > 0); scan(line); next
    }
    if (has) { buf = buf "\n"; bufn += 1 }
    lastsp = 0
    stream(line)
}
END { end_part(); print part }
'

split_mode() {
    # The splitter mode of the active format.
    case "$FORMAT" in
        markdown) printf 'md2' ;;
        plain)    printf 'plain' ;;
        *)        printf 'html' ;;
    esac
}

split_into_files() {
    # split_into_files TEXT BUDGET DIR PREFIX [MODE] -> number of parts on
    # stdout, written to DIR/PREFIX.001 and on. BUDGET counts the characters
    # Telegram sees; MODE is html (the default), plain or md2.
    local text="$1" budget="$2" dir="$3" prefix="$4" mode="${5:-html}"
    printf '%s' "$text" | LC_ALL=C awk_run -v B="$budget" -v DIR="$dir" -v PREFIX="$prefix" \
        -v MODE="$mode" "$U8_AWK$SPLIT_AWK"
}

visible_length() {
    # visible_length TEXT [MODE] -> the length Telegram measures.
    printf '%s' "$1" | LC_ALL=C awk_run -v MODE="${2:-html}" "$U8_AWK"'
        BEGIN { u8_init() }
        { n += vis_len($0, MODE) + (NR > 1) }
        END { print n + 0 }'
}

utf8_clean() {
    # utf8_clean [MAX] -> stdin with invalid bytes replaced by U+FFFD, each
    # line cut to MAX characters (when given) at a character boundary.
    LC_ALL=C awk_run -v MAX="${1:-0}" "$U8_AWK"'
        BEGIN { u8_init() }
        {
            s = u8_clean($0)
            if (MAX > 0 && vis_len(s, "plain") > MAX) {
                out = ""; n = 0; i = 1
                while (i <= length(s) && n < MAX) {
                    o = ORD[substr(s, i, 1)]
                    l = (o >= 240 ? 4 : o >= 224 ? 3 : o >= 192 ? 2 : 1)
                    out = out substr(s, i, l); i += l; n++
                }
                s = out "\342\200\246"
            }
            print s
        }'
}

# ---------------------------------------------------------------------------
# Message composition
# ---------------------------------------------------------------------------

# Composition state, filled in by the argument parser.
TITLE=""; BODY=""; LEVEL=""; EMOJI=""; META=0
QUOTE_TEXT=""; COLLAPSE=0; CODE_TEXT=""; CODE_LANG=""; PERCENT=""
FORMAT="${TG_PING_FORMAT:-auto}"
SILENT=0; PIN=0; PROTECT=0; REPLY_TO=""; NO_PREVIEW=1
TRUNCATE=0; MAX_PARTS="${TG_PING_MAX_PARTS:-8}"
RUN_TAIL="${TG_PING_TAIL:-20}"; BAR_WIDTH="${TG_PING_BAR_WIDTH:-12}"
COOLDOWN=""; COOLDOWN_KEY=""; TEE=0
BUTTON_COLS=1
ITEMS=(); FIELDS=(); BUTTONS=()
THREAD_ID="${THREAD_ID:-}"; PREFIX="${PREFIX:-}"
MACHINE="${TG_PING_MACHINE:-}"; MACHINE_ICON="${TG_PING_MACHINE_ICON:-}"; SHOW_MACHINE=1
AGENT_MODE="${TG_PING_AGENT:-}"; AGENT_NAME=""
QUIET_HOURS="${TG_PING_QUIET_HOURS:-}"
META_FIELDS=$(lc "${TG_PING_META:-host,repo,time}")
TOPICS_MODE=$(lc "${TG_PING_TOPICS:-}")
PROJECT_MODE="${TG_PING_PROJECT:-}"
DELIVER_SUPPRESSED=0; NO_BUTTONS=0; KEYBOARD_FORCE_REPLY=0; PROGRESS_INFO=""; MATH_AS_CODE=0
RICH_MEDIA_JSON=""; RICH_FILES=(); RICH_KIND="html"; RICH_EXTRA=""

project_shown() {
    # True when every message ends with the project it comes from
    # (TG_PING_PROJECT on, or a name of the project's own).
    case "$(lc "$PROJECT_MODE")" in ""|off|0|false|no|n) return 1 ;; esac
    return 0
}

project_label() {
    # The project a message comes from, for its footer: the name
    # TG_PING_PROJECT gives when it is not a switch, else the folder inside
    # its git repository ("typst-vault/Proofs/Zipf", "tg-ping" at the root
    # of one), or the folder relative to home outside a repository
    # ("~/Dropbox/iPad"), so that the reports of several agents working on
    # one machine can be told apart.
    local root here rel
    case "$(lc "$PROJECT_MODE")" in
        ""|on|1|true|yes|y|auto) ;;
        *) printf '%s' "$PROJECT_MODE"; return 0 ;;
    esac
    here=$(pwd -P 2>/dev/null) || here="$PWD"
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
    if [ -n "$root" ]; then
        rel=${here#"$root"}; rel=${rel#/}
        printf '%s%s' "$(basename "$root")" "${rel:+/$rel}"
        return 0
    fi
    # shellcheck disable=SC2088  # the tilde is printed, not expanded
    case "$here" in
        "$HOME")   printf '~' ;;
        "$HOME"/*) printf '~/%s' "${here#"$HOME"/}" ;;
        *)         printf '%s' "$here" ;;
    esac
}

meta_line() {
    # The footer of --meta, with the fields TG_PING_META chooses among host
    # (the machine), repo (repository and branch), project (the folder, see
    # project_label) and time. With TG_PING_PROJECT on, the project is in
    # every footer, and is the whole footer of a message sent without --meta.
    local fields="$META_FIELDS" field out="" ctx
    if project_shown; then
        [ "$META" -eq 1 ] || fields="project"
        case ",$fields," in *,project,*|*,folder,*|*,dir,*) ;; *) fields="$fields,project" ;; esac
    fi
    for field in $(printf '%s' "$fields" | tr ',' ' '); do
        case "$field" in
            host|machine)
                if [ -n "$(machine_tag)" ]; then out="$out · $(machine_tag)"; else out="$out · $(host_name)"; fi ;;
            repo|git)     ctx=$(git_context); [ -n "$ctx" ] && out="$out · $ctx" ;;
            project|folder|dir) out="$out · 📂 $(project_label)" ;;
            time|date)    out="$out · $(date '+%Y-%m-%d %H:%M %Z')" ;;
        esac
    done
    printf '%s' "${out# · }"
}

build_message_rich() {
    # The message as the HTML of a rich message: the same parts as the
    # classic form, laid out as blocks, with formulas typeset by Telegram.
    local out="" head="" emoji tag f item entry key value i id
    emoji="$EMOJI"
    [ -n "$emoji" ] || emoji=$(level_emoji "$LEVEL")
    tag=$(speaker_tag)
    [ -n "$emoji" ] && head="$emoji "
    [ -n "$tag" ] && head="$head$(printf '%s' "$tag" | html_escape) · "
    [ -n "$PREFIX" ] && head="$head$(printf '%s' "$PREFIX" | html_escape) "
    [ -n "$TITLE" ] && head="$head<b>$(printf '%s' "$TITLE" | html_escape)</b>"
    head="${head% }"; head="${head% ·}"
    [ -n "$head" ] && out="<p>$head</p>"
    [ -n "$BODY" ] && out="$out$(printf '%s\n' "$BODY" | md_to_rich)"
    [ -n "$RICH_EXTRA" ] && out="$out$RICH_EXTRA"
    [ -n "$PERCENT" ] && out="$out<p>$(progress_bar "$PERCENT" "$BAR_WIDTH")</p>"
    [ -n "$PROGRESS_INFO" ] && out="$out<p>$PROGRESS_INFO</p>"
    if [ ${#ITEMS[@]} -gt 0 ]; then
        out="$out$(for item in "${ITEMS[@]}"; do printf -- '- %s\n' "$item"; done | md_to_rich)"
    fi
    if [ ${#FIELDS[@]} -gt 0 ]; then
        out="$out<table compact>"
        for entry in "${FIELDS[@]}"; do
            key=${entry%%=*}; value=${entry#*=}
            out="$out<tr><td><b>$(printf '%s' "$key" | html_escape)</b></td><td>$(printf '%s' "$value" | html_escape)</td></tr>"
        done
        out="$out</table>"
    fi
    for f in ${MATH_LIST[@]+"${MATH_LIST[@]}"}; do
        out="$out<tg-math-block>$(printf '%s' "$f" | html_escape)</tg-math-block>"
    done
    if [ -n "$QUOTE_TEXT" ]; then
        out="$out<blockquote$( [ "$COLLAPSE" -eq 1 ] && printf ' expandable')>$(printf '%s' "$QUOTE_TEXT" | html_escape | awk_run 'BEGIN{ORS=""} {if (NR>1) print "<br>"; print}')</blockquote>"
    fi
    [ -n "$CODE_TEXT" ] && out="$out$(fmt_code_block "$CODE_TEXT" "$CODE_LANG")"
    # The pictures and documents prepared for this rich message, embedded.
    if [ -n "$RICH_MEDIA_JSON" ]; then
        i=0
        while [ "$i" -lt "${#MP[@]}" ]; do
            id="a$(( i + 1 ))"
            case "${MK[$i]}" in
                photo)           out="$out<img src=\"tg://photo?id=$id\">" ;;
                video|animation) out="$out<video src=\"tg://video?id=$id\">" ;;
                audio)           out="$out<audio src=\"tg://audio?id=$id\">" ;;
                *)               out="$out<tg-document src=\"tg://document?id=$id\">" ;;
            esac
            i=$(( i + 1 ))
        done
    fi
    if [ "$META" -eq 1 ] || project_shown; then
        out="$out<footer><i>$(meta_line | html_escape)</i></footer>"
    fi
    printf '%s' "$out"
}

build_message() {
    local out="" head="" emoji="" item entry key value tag f
    if [ "$FORMAT" = "rich" ]; then
        build_message_rich
        return 0
    fi
    emoji="$EMOJI"
    [ -n "$emoji" ] || emoji=$(level_emoji "$LEVEL")
    tag=$(speaker_tag)

    head=""
    [ -n "$emoji" ] && head="$emoji "
    if [ -n "$tag" ]; then
        head="${head}$(fmt_escape "$tag")"
        # The separator only leads into a title or a body.
        if [ -n "$PREFIX$TITLE$BODY" ]; then head="$head · "; else head="$head "; fi
    fi
    [ -n "$PREFIX" ] && head="${head}$(fmt_escape "$PREFIX") "
    if [ -n "$TITLE" ]; then
        head="${head}$(fmt_bold "$TITLE")"
    elif [ -n "$head" ] && [ -n "$BODY" ]; then
        : # a bare emoji simply prefixes the body
    fi

    if [ -n "$TITLE" ]; then
        out="$head"
        [ -n "$BODY" ] && out="$out
$(format_text "$BODY")"
    elif [ -n "$BODY" ]; then
        out="${head}$(format_text "$BODY")"
    else
        out="${head% }"
    fi

    if [ -n "$PERCENT" ]; then
        out="$out
$(progress_bar "$PERCENT" "$BAR_WIDTH")"
    fi
    # The timing line of a progress message, already in the active markup.
    if [ -n "$PROGRESS_INFO" ]; then
        out="$out
$PROGRESS_INFO"
    fi

    for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
        out="$out
• $(format_text "$item")"
    done

    for entry in ${FIELDS[@]+"${FIELDS[@]}"}; do
        key=${entry%%=*}
        value=${entry#*=}
        out="$out
$(fmt_bold "$key"): $(fmt_escape "$value")"
    done

    if [ -n "$QUOTE_TEXT" ]; then
        out="$out
$(fmt_quote "$QUOTE_TEXT" "$COLLAPSE")"
    fi

    if [ -n "$CODE_TEXT" ]; then
        out="$out
$(fmt_code_block "$CODE_TEXT" "$CODE_LANG")"
    fi

    # Formulas that could not be drawn travel as their source.
    if [ "$MATH_AS_CODE" -eq 1 ]; then
        for f in ${MATH_LIST[@]+"${MATH_LIST[@]}"}; do
            out="$out
$(fmt_code_block "$f" latex)"
        done
    fi

    if { [ "$META" -eq 1 ] || project_shown; } && [ -n "$(meta_line)" ]; then
        out="$out

$(fmt_italic "$(meta_line)")"
    fi

    printf '%s' "$out"
}

buttons_json() {
    # The inline keyboard of the BUTTONS entries, each built of fields joined
    # by the unit separator, so that any character may appear in a label:
    # "url LABEL TARGET" or "cb LABEL DATA [STYLE]", STYLE being success
    # (green), danger (red) or primary (blue). KEYBOARD_FORCE_REPLY=1 adds
    # Telegram's reply prompt beside the buttons.
    local entry kind label target style row=0 col=0 json="" sep=""
    [ "$NO_BUTTONS" -eq 1 ] && return 1
    if [ ${#BUTTONS[@]} -eq 0 ]; then
        # A question without buttons opens the reply field by itself.
        [ "$KEYBOARD_FORCE_REPLY" -eq 1 ] || return 1
        printf '{"force_reply":true,"input_field_placeholder":"Your answer"}'
        return 0
    fi
    json='{"inline_keyboard":['
    for entry in "${BUTTONS[@]}"; do
        kind=${entry%%"$US"*}; entry=${entry#*"$US"}
        label=${entry%%"$US"*}; entry=${entry#*"$US"}
        target=${entry%%"$US"*}; style=""
        case "$entry" in *"$US"*) style=${entry#*"$US"} ;; esac
        if [ "$col" -eq 0 ]; then
            [ "$row" -gt 0 ] && json="${json}],["
            [ "$row" -eq 0 ] && json="${json}["
            row=$(( row + 1 )); sep=""
        fi
        if [ "$kind" = "url" ]; then
            json="$json$sep{\"text\":\"$(printf '%s' "$label" | json_escape)\",\"url\":\"$(printf '%s' "$target" | json_escape)\""
        else
            json="$json$sep{\"text\":\"$(printf '%s' "$label" | json_escape)\",\"callback_data\":\"$(printf '%s' "$target" | json_escape)\""
        fi
        [ -n "$style" ] && json="$json,\"style\":\"$style\""
        json="$json}"
        sep=","
        col=$(( col + 1 ))
        [ "$col" -ge "$BUTTON_COLS" ] && col=0
    done
    json="$json]]"
    [ "$KEYBOARD_FORCE_REPLY" -eq 1 ] && json="$json,\"force_reply\":true"
    printf '%s}' "$json"
}

button_style() {
    # The colour of an answer button: green for a yes, red for a no.
    case "$(lc "$1")" in
        yes|y|ok|okay|approve|accept|continue|proceed|go|"go ahead") printf 'success' ;;
        no|n|stop|abort|cancel|reject|deny)                          printf 'danger' ;;
    esac
}

parse_mode_value() {
    case "$FORMAT" in
        auto|html|rich) printf 'HTML' ;;
        markdown)  printf 'MarkdownV2' ;;
        *)         printf '' ;;
    esac
}

cooldown_file() {
    # cooldown_file TEXT -> the state file of this alert's cooldown bucket. The
    # default bucket hashes the parts of the message, not the rendered text,
    # so that the time in a --meta footer does not make every repeat new.
    local key
    key="$COOLDOWN_KEY"
    if [ -z "$key" ]; then
        if [ -n "$TITLE$BODY$CODE_TEXT$QUOTE_TEXT${ITEMS[*]+x}${FIELDS[*]+x}" ]; then
            key=$(printf '%s\n' "$LEVEL" "$TITLE" "$BODY" "$CODE_TEXT" "$QUOTE_TEXT" \
                  ${ITEMS[@]+"${ITEMS[@]}"} ${FIELDS[@]+"${FIELDS[@]}"} | short_hash)
        else
            key=$(printf '%s' "$1" | short_hash)
        fi
    fi
    key=$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')
    printf '%s/cooldown.%s' "$(state_dir)" "$key"
}

cooldown_allows() {
    # Returns 1 when the same alert was sent inside the cooldown window.
    local file now last
    [ -n "$COOLDOWN" ] || return 0
    is_number "$COOLDOWN" || die "$EX_USAGE" "--cooldown expects seconds"
    file=$(cooldown_file "$1")
    now=$(date +%s)
    last=$(cat "$file" 2>/dev/null || echo 0)
    is_number "$last" || last=0
    if [ $(( now - last )) -lt "$COOLDOWN" ]; then
        note "suppressed by --cooldown (${COOLDOWN}s, $(basename "$file"))"
        return 1
    fi
    return 0
}

cooldown_record() {
    # Called after a successful delivery only: a failed alert must be free to
    # try again. Dry and disabled runs record nothing.
    local file
    [ -n "$COOLDOWN" ] || return 0
    [ "$DRY_RUN" -eq 1 ] && return 0
    [ "$DISABLED" = "1" ] && return 0
    file=$(cooldown_file "$1")
    if mutex_acquire "$file.lock" 2; then
        atomic_write "$file" "$(date +%s)" || true
        mutex_release "$file.lock"
    fi
    return 0
}

is_markup_error() {
    # True when Telegram refused a text for its markup alone.
    case "$1" in
        *"parse entities"*|*"can't find end"*|*"nsupported start tag"*|*"nmatched end tag"*|*"TAG"*) return 0 ;;
    esac
    return 1
}

markup_strip() {
    # The text of stdin without the markup of the active format.
    case "$FORMAT" in
        markdown) sed -e 's/\\\(.\)/\1/g' ;;
        plain)    cat ;;
        *)        html_strip ;;
    esac
}

send_one() {
    # send_one CHAT TEXT [KEYBOARD_JSON]. Handles the plain text fallback.
    local chat="$1" text="$2" keyboard="${3:-}" mode rc
    mode=$(parse_mode_value)

    req_reset
    req_add chat_id "$chat"
    req_add text "$text"
    req_add parse_mode "$mode"
    req_no_preview
    req_silent
    [ "$PROTECT" -eq 1 ] && req_add protect_content "true"
    req_add message_thread_id "$THREAD_ID"
    req_reply "$REPLY_TO"
    req_add reply_markup "$keyboard"

    api_call sendMessage
    rc=$?
    if [ "$rc" -eq "$EX_API" ] && [ "$FALLBACK" -eq 1 ] && [ -n "$mode" ] && is_markup_error "$API_ERROR"; then
        warn "Telegram rejected the markup ($API_ERROR), resending as plain text"
        req_reset
        req_add chat_id "$chat"
        req_add text "$(printf '%s' "$text" | markup_strip)"
        req_no_preview
        req_silent
        [ "$PROTECT" -eq 1 ] && req_add protect_content "true"
        req_add message_thread_id "$THREAD_ID"
        req_reply "$REPLY_TO"
        req_add reply_markup "$keyboard"
        api_call sendMessage
        rc=$?
    fi
    return "$rc"
}

pin_last() {
    local chat="$1" mid
    mid=$(json_get "$API_BODY" "result.message_id")
    [ -n "$mid" ] && [ "$mid" != "0" ] || return 0
    local saved_body="$API_BODY"
    req_reset
    req_add chat_id "$chat"
    req_add message_id "$mid"
    req_silent
    api_call pinChatMessage || warn "could not pin the message: $API_ERROR"
    API_BODY="$saved_body"
    return 0
}

message_file() {
    # message_file TEXT FILE: the whole message as plain text, for the file
    # attached when it needs more parts than allowed.
    printf '%s\n' "$1" | markup_strip | utf8_clean > "$2"
}

send_text_file() {
    # send_text_file CHAT FILE REPLY_TO: a text file, answering a message.
    local saved_reply="$REPLY_TO" saved_cur="$CHATS_CURRENT" rc
    CHATS_CURRENT="$1"; REPLY_TO="$3"; MEDIA_KEYBOARD=0
    send_media_file sendDocument document "$2" "" "message.txt"
    rc=$?
    REPLY_TO="$saved_reply"; CHATS_CURRENT="$saved_cur"; MEDIA_KEYBOARD=1
    return "$rc"
}

rich_refused_recently() {
    # True for a day after Telegram refused a rich message (an older server
    # behind --api, for instance): the classic form goes out meanwhile.
    local t
    t=$(cat "$(state_dir)/rich.refused" 2>/dev/null || echo 0)
    is_number "$t" || t=0
    [ $(( $(date +%s) - t )) -lt 86400 ]
}

rich_refusal() {
    # True when a refusal concerns the rich message itself, not the chat,
    # the bot, the topic or the rights, which the classic form would meet too.
    case "$1" in
        *"chat not found"*|*"bot was blocked"*|*nauthorized*|*"thread not found"*|*"not enough rights"*|*"have no rights"*|*"deactivated"*)
            return 1 ;;
    esac
    return 0
}

rich_fallback() {
    # The classic form of the current message, formulas as their source and
    # the pictures as captions or as a reply; a Markdown report goes as
    # text, its figures following as an album.
    local FORMAT=auto MATH_AS_CODE=1 RICH_MEDIA_JSON=""
    if [ "$RICH_KIND" = "markdown" ]; then
        local RICH_KIND=html
        rich_report_fallback
        return $?
    fi
    send_with_attachments
}

deliver_rich() {
    # deliver_rich HTML: one rich message to every chat, with the pictures of
    # RICH_MEDIA_JSON uploaded from RICH_FILES. A refusal of the rich message
    # itself is remembered for a day, and the message goes out in the
    # classic form, so that nothing is lost.
    local html="$1" chat rc failures=0 first_failure=0 sent=0 keyboard json entry rest
    if rich_refused_recently; then
        note "a rich message was refused within the day, sending the classic form"
        rich_fallback; return $?
    fi
    if [ "$(visible_length "$html" html)" -gt 32000 ]; then
        note "too long for one rich message, sending the classic form"
        rich_fallback; return $?
    fi
    keyboard=$(buttons_json) || keyboard=""
    if ! cooldown_allows "$html"; then
        DELIVER_SUPPRESSED=1
        return 0
    fi
    json="{\"$RICH_KIND\":\"$(printf '%s' "$html" | json_escape)\"${RICH_MEDIA_JSON:+,\"media\":$RICH_MEDIA_JSON}}"
    rest="$(chat_list | tr '\n' ' ')"
    for chat in $(chat_list); do
        rest="${rest#"$chat "}"
        req_reset
        req_add chat_id "$chat"
        req_add rich_message "$json"
        req_silent
        [ "$PROTECT" -eq 1 ] && req_add protect_content "true"
        req_add message_thread_id "$THREAD_ID"
        req_reply "$REPLY_TO"
        req_add reply_markup "$keyboard"
        for entry in ${RICH_FILES[@]+"${RICH_FILES[@]}"}; do
            req_file "${entry%%=*}" "${entry#*=}"
        done
        api_call sendRichMessage; rc=$?
        if [ "$rc" -eq "$EX_API" ] && [ "$FALLBACK" -eq 1 ] && rich_refusal "$API_ERROR"; then
            warn "Telegram refused the rich message ($API_ERROR); it goes out in the classic form, and so do rich messages for a day"
            [ "$DRY_RUN" -eq 1 ] || atomic_write "$(state_dir)/rich.refused" "$(date +%s)" || true
            local CHATS="$chat,${rest// /,}"
            rich_fallback; return $?
        fi
        if [ "$rc" -ne 0 ]; then
            failures=$(( failures + 1 ))
            [ "$first_failure" -eq 0 ] && first_failure="$rc"
            printf '%s: error: chat %s: %s\n' "$TG_PING_NAME" "$chat" "$(api_explain "$API_ERROR")" | redact >&2
            continue
        fi
        sent=$(( sent + 1 ))
        [ "$PIN" -eq 1 ] && pin_last "$chat"
        report_result "$chat"
    done
    if [ "$failures" -gt 0 ]; then
        [ "$SOFT_FAIL" = "1" ] && { note "soft-fail is on, reporting success"; return 0; }
        return "$first_failure"
    fi
    [ "$sent" -eq 0 ] && return "$EX_FAIL"
    cooldown_record "$html"
    return 0
}

edit_request() {
    # edit_request CHAT MESSAGE_ID TEXT: the request that replaces the text of
    # a message, in the form the message was sent in (FORMAT). The caller adds
    # its keyboard and calls editMessageText.
    req_reset
    req_add chat_id "$1"
    req_add message_id "$2"
    if [ "$FORMAT" = "rich" ]; then
        req_add rich_message "{\"html\":\"$(printf '%s' "$3" | json_escape)\"}"
    else
        req_add text "$(fit_message "$3")"
        req_add parse_mode "$(parse_mode_value)"
        req_no_preview
    fi
}

deliver() {
    # deliver TEXT: split when needed, fan out over every configured chat.
    # Returns 0, or the code of the first failure (4 network, 5 Telegram,
    # 6 rate limit). A repeat suppressed by --cooldown returns 0 and sets
    # DELIVER_SUPPRESSED, so that the caller keeps its own exit code.
    local text="$1" keyboard chat parts i part file wd budget rc failures=0 sent=0 first_failure=0
    local overflow=0 first_mid
    [ -n "$text" ] || die "$EX_USAGE" "nothing to send (give a message, pipe one in, or use --title)"
    [ "$DISABLED" = "1" ] && return 0
    if [ "$FORMAT" = "rich" ]; then
        deliver_rich "$text"
        return $?
    fi
    keyboard=$(buttons_json) || keyboard=""

    if ! cooldown_allows "$text"; then
        DELIVER_SUPPRESSED=1
        return 0
    fi

    [ "$TEE" -eq 1 ] && printf '%s\n' "$(printf '%s' "$text" | markup_strip)" >&2

    # Room is left for the line that numbers the parts.
    budget=$(( TG_MAX_TEXT - 46 ))
    wd=$(workdir)
    rm -f "$wd"/part.* 2>/dev/null || true
    parts=$(split_into_files "$text" "$budget" "$wd" "part" "$(split_mode)")
    is_number "$parts" || parts=0
    [ "$parts" -gt 0 ] || die "$EX_USAGE" "nothing to send: the message is empty"

    if [ "$TRUNCATE" -eq 1 ]; then
        parts=1
    elif [ "$parts" -gt "$MAX_PARTS" ]; then
        warn "the message needs $parts parts: the first is sent, and the whole text follows as a file"
        overflow=1; parts=1
        message_file "$text" "$wd/message.txt"
    fi

    for chat in $(chat_list); do
        i=0; rc=0; first_mid=""
        while [ "$i" -lt "$parts" ]; do
            i=$(( i + 1 ))
            file=$(printf '%s/part.%03d' "$wd" "$i")
            [ -f "$file" ] || break
            part=$(cat "$file")
            if [ "$parts" -gt 1 ]; then
                part="$part
$(fmt_italic "part $i of $parts")"
            elif [ "$overflow" -eq 1 ]; then
                part="$part
$(fmt_italic "(the whole message is in the file below)")"
            fi
            # Buttons ride on the last part only.
            if [ "$i" -eq "$parts" ]; then
                send_one "$chat" "$part" "$keyboard"; rc=$?
            else
                send_one "$chat" "$part" ""; rc=$?
            fi
            if [ "$rc" -ne 0 ]; then
                failures=$(( failures + 1 ))
                [ "$first_failure" -eq 0 ] && first_failure="$rc"
                printf '%s: error: chat %s: %s\n' "$TG_PING_NAME" "$chat" "$(api_explain "$API_ERROR")" | redact >&2
                break
            fi
            [ -n "$first_mid" ] || first_mid=$(json_get "$API_BODY" "result.message_id")
            sent=$(( sent + 1 ))
        done
        if [ "$rc" -eq 0 ] && [ "$overflow" -eq 1 ]; then
            local saved_body="$API_BODY"
            send_text_file "$chat" "$wd/message.txt" "$first_mid"; rc=$?
            if [ "$rc" -ne 0 ]; then
                failures=$(( failures + 1 ))
                [ "$first_failure" -eq 0 ] && first_failure="$rc"
            fi
            API_BODY="$saved_body"
        fi
        [ "$PIN" -eq 1 ] && pin_last "$chat"
        [ "$rc" -eq 0 ] && report_result "$chat"
    done

    if [ "$failures" -gt 0 ]; then
        [ "$SOFT_FAIL" = "1" ] && { note "soft-fail is on, reporting success"; return 0; }
        return "$first_failure"
    fi
    [ "$sent" -eq 0 ] && return "$EX_FAIL"
    cooldown_record "$text"
    return 0
}

finish_failure() {
    # finish_failure CODE: end with CODE, or with 0 under --soft-fail, so that
    # a notification never breaks the pipeline that sent it.
    local code="${1:-$EX_FAIL}"
    [ "$code" -eq 0 ] && code="$EX_FAIL"
    if [ "$SOFT_FAIL" = "1" ]; then
        note "soft-fail is on, exiting 0 despite the error above"
        exit "$EX_OK"
    fi
    exit "$code"
}

read_stdin_if_piped() {
    # The body comes from stdin when it is given as "-", or when nothing was
    # given and the tool sits at the end of a pipe. A file on stdin is read
    # only on request: inside 'while read ... done < file' the loop's own
    # lines must stay with the loop. --no-stdin, or TG_PING_NO_STDIN=1,
    # forbids the implicit read, for hooks and traps that inherit a pipe.
    if [ "$BODY" = "-" ]; then
        BODY=$(cat)
        return 0
    fi
    [ -z "$BODY" ] || return 0
    [ "$NO_STDIN" -eq 1 ] && return 0
    [ -t 0 ] && return 0
    [ -p /dev/stdin ] || return 0
    BODY=$(cat)
}

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

file_size() { wc -c < "$1" 2>/dev/null | tr -d ' '; }

guess_kind() {
    # Map an extension to the Telegram send method family.
    case "$(lc "${1##*.}")" in
        jpg|jpeg|png|webp)           printf 'photo' ;;
        gif)                         printf 'animation' ;;
        mp4|mov|m4v|mkv|webm)        printf 'video' ;;
        mp3|m4a|flac|wav|oga|ogg)    printf 'audio' ;;
        *)                           printf 'document' ;;
    esac
}

is_remote_ref() {
    case "$1" in
        http://*|https://*) return 0 ;;
        *) return 1 ;;
    esac
}

kind_method() {
    case "$1" in
        photo)     printf 'sendPhoto' ;;
        video)     printf 'sendVideo' ;;
        audio)     printf 'sendAudio' ;;
        animation) printf 'sendAnimation' ;;
        *)         printf 'sendDocument' ;;
    esac
}

media_family() {
    # Telegram groups photos with videos, documents with documents and audio
    # with audio, and never puts an animation in an album.
    case "$1" in
        photo|video) printf 'visual' ;;
        audio)       printf 'audio' ;;
        animation)   printf 'animation' ;;
        *)           printf 'document' ;;
    esac
}

reencode_video() {
    # reencode_video IN OUT CRF SIDE: H.264 in an MP4 container, the longest
    # side at most SIDE pixels, even dimensions, playable on every phone.
    local side="$4"
    ffmpeg -nostdin -y -loglevel error -i "$1" -c:v libx264 -preset veryfast -crf "$3" \
        -pix_fmt yuv420p -movflags +faststart \
        -vf "scale='if(gte(iw,ih),trunc(min($side,iw)/2)*2,-2)':'if(gte(iw,ih),-2,trunc(min($side,ih)/2)*2)'" \
        -c:a aac -b:a 96k "$2" >>"$(workdir)/ffmpeg.log" 2>&1
}

UPLOAD_PATH=""; UPLOAD_KIND=""

prepare_upload() {
    # prepare_upload PATH KIND: sets UPLOAD_PATH and UPLOAD_KIND, the file and
    # the way it travels. A video over the 50 MiB upload limit is re-encoded
    # first; a photo over 10 MB, the photo limit, goes as a document. Must run
    # in the main shell: it sets globals and may stop the program.
    local path="$1" kind="$2" size out ok=0
    UPLOAD_PATH="$path"; UPLOAD_KIND="$kind"
    is_remote_ref "$path" && return 0
    [ -f "$path" ] || die "$EX_USAGE" "no such file: $path"
    [ -r "$path" ] || die "$EX_USAGE" "cannot read: $path"
    size=$(file_size "$path")
    is_number "$size" || size=0
    [ "$size" -gt 0 ] || die "$EX_USAGE" "$path is empty"
    if [ "$size" -gt "$TG_UPLOAD_LIMIT" ] && { [ "$kind" = "video" ] || [ "$kind" = "animation" ]; } && have ffmpeg; then
        out="$(mktemp -d "$(workdir)/video.XXXXXX")/$(basename "${path%.*}").mp4"
        note "$path is $(( size / 1048576 )) MiB, re-encoding it to fit the 50 MiB limit"
        if reencode_video "$path" "$out" 28 1280 && [ "$(file_size "$out")" -le "$TG_UPLOAD_LIMIT" ]; then
            ok=1
        elif reencode_video "$path" "$out" 32 960 && [ "$(file_size "$out")" -le "$TG_UPLOAD_LIMIT" ]; then
            ok=1
        fi
        if [ "$ok" -eq 1 ]; then
            warn "$(basename "$path") was re-encoded from $(( size / 1048576 )) MiB to $(( $(file_size "$out") / 1048576 )) MiB to fit the upload limit"
            UPLOAD_PATH="$out"
            return 0
        fi
        die "$EX_USAGE" "$path stays above the 50 MiB bot upload limit even re-encoded.
  Shorten it, or upload it elsewhere and send the link instead."
    fi
    if [ "$size" -gt "$TG_UPLOAD_LIMIT" ]; then
        die "$EX_USAGE" "$path is $(( size / 1048576 )) MiB, above the 50 MiB bot upload limit.
  Split it, compress it, or upload it elsewhere and send the link instead."
    fi
    if [ "$kind" = "photo" ] && [ "$size" -gt "$TG_PHOTO_LIMIT" ]; then
        warn "$(basename "$path") is above the 10 MB photo limit, it goes as a document"
        UPLOAD_KIND="document"
    fi
    return 0
}

cut_caption() {
    # cut_caption TEXT -> the text, cut to the caption limit when needed at a
    # line or word boundary, markup balanced.
    local text="$1" wd n
    if [ -z "$text" ] || [ "$(visible_length "$text" "$(split_mode)")" -le "$TG_MAX_CAPTION" ]; then
        printf '%s' "$text"
        return 0
    fi
    wd=$(workdir); rm -f "$wd"/cut.* 2>/dev/null
    n=$(split_into_files "$text" $(( TG_MAX_CAPTION - 4 )) "$wd" cut "$(split_mode)")
    is_number "$n" && [ "$n" -gt 0 ] && cat "$wd/cut.001"
}

caption_split() {
    # Sets CAPTION_TEXT, at most 1,024 characters as Telegram counts them, and
    # CAPTION_OVERFLOW, the whole text when it had to be cut, which follows as
    # a reply to the picture. Never called through a command substitution:
    # the assignments must reach the caller.
    local text="$1" wd n
    CAPTION_TEXT="$text"; CAPTION_OVERFLOW=""
    [ -n "$text" ] || return 0
    [ "$(visible_length "$text" "$(split_mode)")" -le "$TG_MAX_CAPTION" ] && return 0
    wd=$(workdir); rm -f "$wd"/cap.* 2>/dev/null
    n=$(split_into_files "$text" $(( TG_MAX_CAPTION - 24 )) "$wd" cap "$(split_mode)")
    is_number "$n" || n=0
    CAPTION_TEXT="$( [ "$n" -gt 0 ] && cat "$wd/cap.001")
$(fmt_italic "(continued below)")"
    CAPTION_OVERFLOW="$text"
}

send_overflow() {
    # send_overflow CHAT MESSAGE_ID: the whole text of a caption that had to
    # be cut, as a reply to the picture it belongs to.
    [ -n "$CAPTION_OVERFLOW" ] || return 0
    local saved_chats="$CHATS" saved_reply="$REPLY_TO" saved_cooldown="$COOLDOWN" saved_pin="$PIN"
    CHATS="$1"; REPLY_TO="$2"; COOLDOWN=""; PIN=0; NO_BUTTONS=1
    deliver "$CAPTION_OVERFLOW" || warn "the rest of the caption could not be sent"
    CHATS="$saved_chats"; REPLY_TO="$saved_reply"; COOLDOWN="$saved_cooldown"; PIN="$saved_pin"; NO_BUTTONS=0
    return 0
}

photo_refused() {
    # True when Telegram will not take a file as a photo, though it would
    # take it as a document.
    case "$1" in
        *PHOTO_INVALID_DIMENSIONS*|*PHOTO_SAVE_FILE_INVALID*|*IMAGE_PROCESS_FAILED*|*PHOTO_EXT_INVALID*|*"Too Large"*|*"too big"*|*"HTTP 413"*)
            return 0 ;;
    esac
    return 1
}

_media_request() {
    # _media_request METHOD FIELD TARGET NAME CAPTION MODE KEYBOARD
    local method="$1" field="$2" target="$3" name="$4" caption="$5" mode="$6" keyboard="$7"
    req_reset
    req_add chat_id "$CHATS_CURRENT"
    req_add caption "$caption"
    req_add parse_mode "$mode"
    req_silent
    [ "$PROTECT" -eq 1 ] && req_add protect_content "true"
    req_add message_thread_id "$THREAD_ID"
    req_reply "$REPLY_TO"
    req_add reply_markup "$keyboard"
    [ "$method" = "sendVideo" ] && req_add supports_streaming "true"
    if is_remote_ref "$target"; then
        req_add "$field" "$target"
    elif [ -n "$name" ]; then
        req_file "$field" "${target};filename=$(printf '%s' "$name" | tr ',;"' '___')"
    else
        req_file "$field" "$target"
    fi
}

send_media_file() {
    # send_media_file METHOD FIELD PATH CAPTION [DISPLAY_NAME]. A caption whose
    # markup Telegram refuses is resent as plain text, and a picture Telegram
    # will not take as a photo goes as a document: the file always arrives.
    local method="$1" field="$2" path="$3" caption="$4" name="${5:-}" keyboard="" rc target mode=""
    if [ "$MEDIA_KEYBOARD" -eq 1 ]; then keyboard=$(buttons_json) || keyboard=""; fi
    [ -n "$caption" ] && mode=$(parse_mode_value)
    target="$path"
    if ! is_remote_ref "$path"; then
        # A comma or a semicolon would confuse the multipart parser of curl,
        # so such a path is copied aside and the real name is restored here.
        target=$(_safe_path "$path")
        [ -n "$name" ] || [ "$target" = "$path" ] || name=$(basename "$path")
    fi

    _media_request "$method" "$field" "$target" "$name" "$caption" "$mode" "$keyboard"
    api_call "$method"; rc=$?
    if [ "$rc" -eq "$EX_API" ] && [ -n "$mode" ] && [ "$FALLBACK" -eq 1 ] && is_markup_error "$API_ERROR"; then
        warn "Telegram rejected the caption markup ($API_ERROR), resending it as plain text"
        caption=$(printf '%s' "$caption" | markup_strip); mode=""
        _media_request "$method" "$field" "$target" "$name" "$caption" "$mode" "$keyboard"
        api_call "$method"; rc=$?
    fi
    if [ "$rc" -eq "$EX_API" ] && [ "$method" = "sendPhoto" ] && photo_refused "$API_ERROR"; then
        warn "Telegram would not take $(basename "$path") as a photo ($API_ERROR), sending it as a document"
        _media_request sendDocument document "$target" "$name" "$caption" "$mode" "$keyboard"
        api_call sendDocument; rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
        printf '%s: error: %s\n' "$TG_PING_NAME" "$(api_explain "$API_ERROR")" | redact >&2
        return "$rc"
    fi
    report_result "$CHATS_CURRENT"
    return 0
}

_album_json() {
    # _album_json STRIP INDEX... -> the media array of an album of the files
    # MP[INDEX] (kinds in MK), the captions from ITEM_CAPTION. STRIP=1 drops
    # the markup of the captions.
    local strip="$1" json="[" sep="" idx cap mode
    shift
    mode=$(parse_mode_value)
    for idx in "$@"; do
        if is_remote_ref "${MP[$idx]}"; then
            json="$json$sep{\"type\":\"${MK[$idx]}\",\"media\":\"$(printf '%s' "${MP[$idx]}" | json_escape)\""
        else
            json="$json$sep{\"type\":\"${MK[$idx]}\",\"media\":\"attach://f$idx\""
        fi
        cap="${ITEM_CAPTION[$idx]}"
        if [ -n "$cap" ]; then
            if [ "$strip" -eq 1 ]; then
                json="$json,\"caption\":\"$(printf '%s' "$cap" | markup_strip | json_escape)\""
            else
                json="$json,\"caption\":\"$(printf '%s' "$cap" | json_escape)\""
                [ -n "$mode" ] && json="$json,\"parse_mode\":\"$mode\""
            fi
        fi
        json="$json}"
        sep=","
    done
    printf '%s]' "$json"
}

send_album() {
    # send_album INDEX...: two to ten files of one family as one album.
    local idx rc
    if [ "$MEDIA_KEYBOARD" -eq 1 ] && [ ${#BUTTONS[@]} -gt 0 ]; then
        warn "Telegram puts no buttons on an album: the buttons are left out (send one picture, or the text with the buttons first)"
    fi
    req_reset
    req_add chat_id "$CHATS_CURRENT"
    req_add media "$(_album_json 0 "$@")"
    req_silent
    [ "$PROTECT" -eq 1 ] && req_add protect_content "true"
    req_add message_thread_id "$THREAD_ID"
    req_reply "$REPLY_TO"
    for idx in "$@"; do
        is_remote_ref "${MP[$idx]}" || req_file "f$idx" "$(_safe_path "${MP[$idx]}")"
    done
    api_call sendMediaGroup; rc=$?
    if [ "$rc" -eq "$EX_API" ] && [ "$FALLBACK" -eq 1 ] && is_markup_error "$API_ERROR"; then
        warn "Telegram rejected the caption markup ($API_ERROR), resending the album with plain captions"
        req_set media "$(_album_json 1 "$@")"
        api_call sendMediaGroup; rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
        printf '%s: error: %s\n' "$TG_PING_NAME" "$(api_explain "$API_ERROR")" | redact >&2
        return "$rc"
    fi
    report_result "$CHATS_CURRENT"
    return 0
}

# The files of one media call: paths, kinds and captions, by position.
MP=(); MK=(); ITEM_CAPTION=(); MEDIA_FIRST_MID=""; MEDIA_KEYBOARD=1

send_media_set() {
    # Sends every file of MP to CHATS_CURRENT: animations one by one, the
    # others grouped by family into balanced albums of two to ten (eleven
    # files become six and five, since an album holds at least two).
    # MEDIA_FIRST_MID receives the id of the first message sent.
    local fam families="" i n k base extra size start chunk idxs idx
    MEDIA_FIRST_MID=""
    i=0
    while [ "$i" -lt "${#MP[@]}" ]; do
        fam=$(media_family "${MK[$i]}")
        case " $families " in *" $fam "*) ;; *) families="$families $fam" ;; esac
        i=$(( i + 1 ))
    done
    for fam in $families; do
        idxs=""
        i=0
        while [ "$i" -lt "${#MP[@]}" ]; do
            [ "$(media_family "${MK[$i]}")" = "$fam" ] && idxs="$idxs $i"
            i=$(( i + 1 ))
        done
        # shellcheck disable=SC2086  # the indices are words on purpose
        set -- $idxs
        n=$#
        if [ "$fam" = "animation" ] || [ "$n" -eq 1 ]; then
            for i in "$@"; do
                send_media_file "$(kind_method "${MK[$i]}")" "${MK[$i]}" "${MP[$i]}" \
                    "${ITEM_CAPTION[$i]}" "$MEDIA_NAME" || return $?
                [ -n "$MEDIA_FIRST_MID" ] || MEDIA_FIRST_MID=$(json_get "$API_BODY" "result.message_id")
            done
            continue
        fi
        k=$(( (n + 9) / 10 )); base=$(( n / k )); extra=$(( n % k ))
        start=0
        while [ "$start" -lt "$n" ]; do
            size=$base
            [ "$extra" -gt 0 ] && { size=$(( size + 1 )); extra=$(( extra - 1 )); }
            chunk=""
            i=0
            for idx in "$@"; do
                [ "$i" -ge "$start" ] && [ "$i" -lt $(( start + size )) ] && chunk="$chunk $idx"
                i=$(( i + 1 ))
            done
            # shellcheck disable=SC2086  # the indices are words on purpose
            send_album $chunk || return $?
            [ -n "$MEDIA_FIRST_MID" ] || MEDIA_FIRST_MID=$(json_get "$API_BODY" "result.0.message_id")
            start=$(( start + size ))
        done
    done
    return 0
}

# ---------------------------------------------------------------------------
# Rendering mathematics to an image
# ---------------------------------------------------------------------------

math_engine_available() {
    case "$1" in
        typst) have typst ;;
        latex) { have latex && have dvipng; } || { have pdflatex && { have pdftoppm || have pdftocairo; }; } ;;
        *) return 1 ;;
    esac
}

render_math_typst() {
    # render_math_typst SOURCE OUTPUT DPI BACKGROUND
    local src="$1" out="$2" dpi="$3" bg="$4" wd fill
    wd=$(workdir)
    case "$bg" in
        transparent) fill="none" ;;
        dark)        fill="rgb(\"#1e1e1e\")" ;;
        *)           fill="white" ;;
    esac
    {
        printf '#set page(width: auto, height: auto, margin: 14pt, fill: %s)\n' "$fill"
        [ "$bg" = "dark" ] && printf '#set text(fill: rgb("#e8e8e8"))\n'
        printf '#set text(size: 20pt)\n'
        if [ -n "$MATH_PREAMBLE" ] && [ -r "$MATH_PREAMBLE" ]; then
            case "$MATH_PREAMBLE" in
                *.typ) cat "$MATH_PREAMBLE" ;;
                *) warn "the preamble $MATH_PREAMBLE is not a .typ file, ignoring it for typst" ;;
            esac
        fi
        if [ "$MATH_PROSE" -eq 1 ]; then
            # A sentence with its formulas, set at a width that reads well
            # on a phone.
            printf '#set page(width: 12cm)\n#set par(justify: false)\n%s\n' "$src"
        elif [ "$MATH_INLINE" -eq 1 ]; then
            printf '$%s$\n' "$src"
        else
            # Typst breaks lines with \ and aligns at & by itself.
            printf '$ %s $\n' "$src"
        fi
    } > "$wd/math.typ"
    typst compile --format png --ppi "$dpi" "$wd/math.typ" "$out" >"$wd/typst.log" 2>&1
}

latex_display() {
    # latex_display SOURCE -> the formula in display form. An environment
    # that makes its own display (align, gather, multline, equation, flalign,
    # starred or not) is kept as it is; a formula broken with \\ is set in
    # aligned when it has an &, in gathered otherwise; anything else goes
    # between \[ and \].
    local src="$1" env linebreak="\\\\"
    for env in align gather multline equation flalign; do
        case "$src" in
            *"\\begin{$env}"*|*"\\begin{$env*}"*) printf '%s' "$src"; return 0 ;;
        esac
    done
    case "$src" in
        *"$linebreak"*)
            case "$src" in
                *'&'*) printf '\\[ \\begin{aligned} %s \\end{aligned} \\]' "$src" ;;
                *)     printf '\\[ \\begin{gathered} %s \\end{gathered} \\]' "$src" ;;
            esac ;;
        *) printf '\\[ %s \\]' "$src" ;;
    esac
}

render_math_latex() {
    # render_math_latex SOURCE OUTPUT DPI BACKGROUND
    local src="$1" out="$2" dpi="$3" bg="$4" wd tex bgopt fgopt
    wd=$(workdir); tex="$wd/math.tex"
    case "$bg" in
        transparent) bgopt="Transparent"; fgopt="Black" ;;
        dark)        bgopt="rgb 0.12 0.12 0.12"; fgopt="rgb 0.91 0.91 0.91" ;;
        *)           bgopt="White"; fgopt="Black" ;;
    esac
    {
        # A sentence is set 12 cm wide, which reads well on a phone.
        if [ "$MATH_PROSE" -eq 1 ]; then
            printf '%s\n' '\documentclass[12pt,preview,border=10pt,varwidth=12cm]{standalone}'
        else
            printf '%s\n' '\documentclass[12pt,preview,border=10pt,varwidth=17cm]{standalone}'
        fi
        printf '%s\n' '\usepackage{amsmath,amssymb,amsfonts,mathtools}'
        if [ -n "$MATH_PREAMBLE" ] && [ -r "$MATH_PREAMBLE" ]; then
            case "$MATH_PREAMBLE" in
                *.typ) warn "the preamble $MATH_PREAMBLE is a typst file, ignoring it for LaTeX" ;;
                *) cat "$MATH_PREAMBLE" ;;
            esac
        fi
        printf '%s\n' '\begin{document}'
        # A larger base size keeps the formula legible on a phone screen.
        if [ "$MATH_PROSE" -eq 1 ]; then printf '{\\large %s\\par}\n' "$src"
        elif [ "$MATH_INLINE" -eq 1 ]; then printf '{\\large $%s$}\n' "$src"
        else printf '{\\large %s}\n' "$(latex_display "$src")"; fi
        printf '%s\n' '\end{document}'
    } > "$tex"

    if have latex && have dvipng; then
        ( cd "$wd" && latex -interaction=nonstopmode -halt-on-error math.tex ) >"$wd/latex.log" 2>&1 &&
        dvipng -q -D "$dpi" -T tight -bg "$bgopt" -fg "$fgopt" -o "$out" "$wd/math.dvi" >>"$wd/latex.log" 2>&1 && return 0
    fi
    if have pdflatex; then
        ( cd "$wd" && pdflatex -interaction=nonstopmode -halt-on-error math.tex ) >>"$wd/latex.log" 2>&1 || return 1
        if have pdftoppm; then
            pdftoppm -png -r "$dpi" -singlefile "$wd/math.pdf" "${out%.png}" >>"$wd/latex.log" 2>&1 && return 0
        elif have pdftocairo; then
            pdftocairo -png -r "$dpi" -singlefile "$wd/math.pdf" "${out%.png}" >>"$wd/latex.log" 2>&1 && return 0
        fi
    fi
    return 1
}

render_math_remote() {
    # render_math_remote SOURCE OUTPUT DPI BACKGROUND, LaTeX only.
    local src="$1" out="$2" dpi="$3" bg="$4" bgname
    case "$bg" in
        dark)        bgname='\bg{black}\fg{white}' ;;
        transparent) bgname='' ;;
        *)           bgname='\bg{white}' ;;
    esac
    note "rendering through latex.codecogs.com, the formula leaves this machine"
    curl -sS -G -o "$out" --max-time "$TIMEOUT" \
        --data-urlencode "\\dpi{$dpi}${bgname}${src}" \
        "https://latex.codecogs.com/png.image" 2>/dev/null || return 1
    [ -s "$out" ] || return 1
    # The service answers with a tiny error image rather than an HTTP error.
    [ "$(file_size "$out")" -gt 512 ] || return 1
    return 0
}

render_math() {
    # render_math SOURCE OUTPUT -> 0 on success, engine name in MATH_ENGINE.
    local src="$1" out="$2"
    MATH_ENGINE=""
    if [ -n "$MATH_PREAMBLE" ] && [ ! -r "$MATH_PREAMBLE" ]; then
        warn "the preamble $MATH_PREAMBLE cannot be read, rendering without it"
        MATH_PREAMBLE=""
    fi
    if [ "$MATH_SYNTAX" = "typst" ]; then
        if math_engine_available typst; then
            MATH_ENGINE="typst"
            render_math_typst "$src" "$out" "$MATH_DPI" "$MATH_BG" && return 0
            die "$EX_FAIL" "typst failed to compile the formula. Its log:
$(tail -n 15 "$(workdir)/typst.log" 2>/dev/null)"
        fi
        die "$EX_CONFIG" "typst syntax was requested but typst is not installed.
  Install it from https://github.com/typst/typst, or drop --typst to use LaTeX."
    fi
    if [ "$MATH_REMOTE" -ne 1 ] && math_engine_available latex; then
        MATH_ENGINE="latex"
        render_math_latex "$src" "$out" "$MATH_DPI" "$MATH_BG" && return 0
        warn "the local LaTeX run failed. Its log:
$(tail -n 15 "$(workdir)/latex.log" 2>/dev/null)"
        [ "$MATH_REMOTE_OK" -eq 1 ] || return 1
    fi
    if [ "$MATH_REMOTE" -eq 1 ] || [ "$MATH_REMOTE_OK" -eq 1 ]; then
        MATH_ENGINE="codecogs"
        render_math_remote "$src" "$out" "$MATH_DPI" "$MATH_BG" && return 0
        return 1
    fi
    die "$EX_CONFIG" "no local renderer found for mathematics.
  Install one of:
    sudo apt install -y texlive-latex-base texlive-latex-extra dvipng
    or typst, see https://github.com/typst/typst
  Alternatively pass --remote to render through latex.codecogs.com, which
  means sending the formula to a third party."
}

# ---------------------------------------------------------------------------
# Tables
# ---------------------------------------------------------------------------

align_table() {
    # align_table SEPARATOR HEADER_FLAG: rows on stdin, aligned columns on
    # stdout. A field in double quotes may hold the separator ("a, b"), a
    # doubled quote inside it standing for one quote; a separator of one blank
    # splits on runs of blanks. Numbers are aligned on the right, text on the
    # left, and widths count characters, whatever the awk.
    local sep="$1" header="$2" rich=0
    [ "$FORMAT" = "rich" ] && rich=1
    LC_ALL=C awk_run -v SEP="$sep" -v header="$header" -v RICH="$rich" "$U8_AWK"'
    BEGIN { u8_init() }
    function split_row(line, cells,    n, i, c, field, inq, len) {
        if (SEP == " ") {
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            return split(line, cells, /[ \t]+/)
        }
        n = 0; field = ""; inq = 0; len = length(line)
        for (i = 1; i <= len; i++) {
            c = substr(line, i, 1)
            if (inq) {
                if (c == "\"") {
                    if (substr(line, i + 1, 1) == "\"") { field = field "\""; i++ }
                    else inq = 0
                } else field = field c
            } else if (c == "\"" && field ~ /^[ \t]*$/) { inq = 1; field = "" }
            else if (c == SEP) { cells[++n] = field; field = "" }
            else field = field c
        }
        cells[++n] = field
        return n
    }
    {
        sub(/\r$/, "")
        if ($0 ~ /^[ \t]*$/) next
        n = split_row($0, cells)
        rows++
        for (i = 1; i <= n; i++) {
            v = cells[i]; gsub(/^[ \t]+|[ \t]+$/, "", v); v = u8_clean(v)
            cell[rows, i] = v
            w = vis_len(v, "plain")
            if (w > width[i]) width[i] = w
            if (!(rows == 1 && header == "1") && v != "" &&
                v !~ /^[-+]?([0-9]+([.,][0-9]*)?|[.,][0-9]+)([eE][-+]?[0-9]+)?%?$/) text[i] = 1
        }
        if (n > maxf) maxf = n
    }
    function hesc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
    END {
        if (RICH) {
            # A table drawn by Telegram itself, in a rich message.
            printf "<table bordered striped compact>"
            for (r = 1; r <= rows; r++) {
                printf "<tr>"
                for (c = 1; c <= maxf; c++) {
                    tag = (header == "1" && r == 1) ? "th" : "td"
                    printf "<%s%s>%s</%s>", tag, (text[c] ? "" : " align=\"right\""), hesc(cell[r, c]), tag
                }
                printf "</tr>"
            }
            printf "</table>"
            exit
        }
        for (r = 1; r <= rows; r++) {
            line = ""
            for (c = 1; c <= maxf; c++) {
                v = cell[r, c]
                pad = width[c] - vis_len(v, "plain")
                spaces = ""
                while (pad-- > 0) spaces = spaces " "
                line = line (text[c] ? v spaces : spaces v) (c < maxf ? "  " : "")
            }
            sub(/[ \t]+$/, "", line)
            print line
            if (header == "1" && r == 1) {
                rule = ""
                for (c = 1; c <= maxf; c++) {
                    k = width[c]; while (k-- > 0) rule = rule "-"
                    if (c < maxf) rule = rule "  "
                }
                print rule
            }
        }
    }'
}

# ---------------------------------------------------------------------------
# Reading updates, the basis of ask, poll and chats
# ---------------------------------------------------------------------------


updates_extract() {
    # Normalise getUpdates JSON on stdin into one record per update, fields
    # separated by the unit separator (\037), which, unlike a tab, keeps empty
    # fields when read by 'read'. A line break inside a text travels as \036
    # and a stray \037 becomes a blank. The fields, in order:
    #   update_id kind chat_id from_id payload ref message_id reply_to date
    #   content chat_type chat_label file_id file_name mime_type file_size
    # where kind is callback, message, poll_answer or other; payload is the
    # button data, the text or caption, or the chosen poll options; ref is
    # the callback id or the poll id; content is text, photo, sticker,
    # document, video, animation, audio, voice, video_note, button, poll or
    # other; and the last four describe the file of a message that carries
    # one (the largest size of a photo).
    if have jq; then
        jq -r '
          def clean: tostring | gsub("\u001f"; " ") | gsub("\r?\n"; "\u001e");
          def media: ((.photo // [] | max_by(.width // 0)) // .animation // .video // .document
                      // .audio // .voice // .video_note // {});
          .result[]? |
          if .callback_query then
            [.update_id, "callback",
             (.callback_query.message.chat.id // ""),
             (.callback_query.from.id // ""),
             (.callback_query.data // "" | clean),
             (.callback_query.id // ""),
             (.callback_query.message.message_id // ""), "",
             (.callback_query.message.date // ""), "button",
             (.callback_query.message.chat.type // ""), "", "", "", "", ""]
          elif .message then
            [.update_id, "message",
             (.message.chat.id // ""),
             (.message.from.id // ""),
             (.message.text // .message.caption // "" | clean), "",
             (.message.message_id // ""),
             (.message.reply_to_message.message_id // ""),
             (.message.date // ""),
             (if .message.text then "text" elif .message.sticker then "sticker"
              elif .message.photo then "photo" elif .message.animation then "animation"
              elif .message.video then "video" elif .message.document then "document"
              elif .message.audio then "audio" elif .message.voice then "voice"
              elif .message.video_note then "video_note" else "other" end),
             (.message.chat.type // ""),
             (.message.chat.title // .message.chat.username // .message.from.first_name // "" | clean),
             (.message | media | .file_id // ""),
             (.message | media | .file_name // "" | clean),
             (.message | media | .mime_type // ""),
             (.message | media | .file_size // "")]
          elif .poll_answer then
            [.update_id, "poll_answer", "", (.poll_answer.user.id // ""),
             ((.poll_answer.option_ids // []) | map(tostring) | join(",")),
             (.poll_answer.poll_id // ""), "", "", "", "poll", "", "", "", "", "", ""]
          else
            [.update_id, "other", "", "", "", "", "", "", "", "other", "", "", "", "", "", ""]
          end | map(tostring) | join("\u001f")'
    else
        python3 -c '
import json, sys
US, RS = "\x1f", "\x1e"
def clean(v):
    if v is None:
        return ""
    return str(v).replace(US, " ").replace("\r\n", RS).replace("\n", RS)
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
def media(m):
    photos = m.get("photo") or []
    if photos:
        return max(photos, key=lambda p: p.get("width") or 0)
    for key in ("animation", "video", "document", "audio", "voice", "video_note"):
        if m.get(key):
            return m[key]
    return {}
for u in data.get("result", []) or []:
    uid = u.get("update_id", "")
    if "callback_query" in u:
        c = u["callback_query"]
        m = c.get("message", {}) or {}
        row = [uid, "callback", (m.get("chat") or {}).get("id"), (c.get("from") or {}).get("id"),
               c.get("data", ""), c.get("id", ""), m.get("message_id"), "", m.get("date"),
               "button", (m.get("chat") or {}).get("type"), "", "", "", "", ""]
    elif "message" in u:
        m = u["message"]
        chat = m.get("chat") or {}
        label = chat.get("title") or chat.get("username") or (m.get("from") or {}).get("first_name", "")
        content = "other"
        for key in ("text", "sticker", "photo", "animation", "video", "document", "audio", "voice", "video_note"):
            if key in m:
                content = key
                break
        f = media(m)
        row = [uid, "message", chat.get("id"), (m.get("from") or {}).get("id"),
               m.get("text", m.get("caption", "")), "", m.get("message_id"),
               (m.get("reply_to_message") or {}).get("message_id"), m.get("date"),
               content, chat.get("type"), label,
               f.get("file_id", ""), f.get("file_name", ""), f.get("mime_type", ""), f.get("file_size", "")]
    elif "poll_answer" in u:
        p = u["poll_answer"]
        row = [uid, "poll_answer", "", (p.get("user") or {}).get("id"),
               ",".join(str(i) for i in p.get("option_ids", [])), p.get("poll_id", ""),
               "", "", "", "poll", "", "", "", "", "", ""]
    else:
        row = [uid, "other", "", "", "", "", "", "", "", "other", "", "", "", "", "", ""]
    print(US.join(clean(x) for x in row))
'
    fi
}

# ---------------------------------------------------------------------------
# The shared inbox
#
# Telegram keeps one queue of updates per bot, read by getUpdates, and lets
# one reader at a time. Several questions may wait at once, from several
# sessions of one computer and from several computers sharing the bot, so
# the queue is read by one process at a time per computer (the holder of
# the lock) and every update is filed for the question it belongs to.
#
# Files, under state_dir/bot.<digest of the token>/:
#   offset            where the next reading starts
#   lock, lock.d/     the lock (flock on descriptor 8, else a directory)
#   waiters/<nonce>   "pid chat message_id kind poll_id text deadline" of
#                     each waiting question; message_id is "pending" until
#                     the question is sent
#   inbox/<update_id>.<nonce>    a record filed for that question
#   inbox/<update_id>.pending    a reply to a question not yet sent
#   taken/            records claimed, kept a day
#   seen/<update_id>  the time an update was first read
#   held/<update_id>  an update kept for another computer
#
# A computer never confirms an update that may belong to another computer
# while it is younger than ten minutes (getUpdates confirms everything
# below its offset, for every reader of the bot): the offset stops at the
# first such update, and updates read twice are recognised by seen/.
# ---------------------------------------------------------------------------

INBOX_D=""; INBOX_LOCKED=""; INBOX_WAITER=""; INBOX_MARK=""

inbox_dir() {
    [ -n "$INBOX_D" ] || INBOX_D="$(state_dir)/bot.$(printf '%s' "$TOKEN" | short_hash)"
    mkdir -p "$INBOX_D/inbox" "$INBOX_D/taken" "$INBOX_D/seen" "$INBOX_D/held" "$INBOX_D/waiters" 2>/dev/null
    printf '%s' "$INBOX_D"
}

machine_mark() {
    # Three characters that tell this computer's questions apart from the
    # others', taken from its machine id (host names may repeat).
    if [ -z "$INBOX_MARK" ]; then
        # TG_PING_MACHINE_ID stands for the machine id where one is missing,
        # and lets the tests play two computers on one.
        INBOX_MARK=$( { [ -n "${TG_PING_MACHINE_ID:-}" ] && printf '%s' "$TG_PING_MACHINE_ID"; } ||
                      cat /etc/machine-id 2>/dev/null || cat /var/lib/dbus/machine-id 2>/dev/null ||
                      host_name; )
        INBOX_MARK=$(printf '%s' "$INBOX_MARK" | short_hash | cut -c1-3)
    fi
    printf '%s' "$INBOX_MARK"
}

inbox_lock_try() {
    # inbox_lock_try [SECONDS]: take the lock of the update reader, waiting
    # at most SECONDS (0: not at all). Must run in the main shell.
    local wait="${1:-0}" D owner pid stamp now tries=0
    D=$(inbox_dir)
    if have flock; then
        exec 8>"$D/lock" || return 1
        if [ "$wait" -gt 0 ]; then flock -w "$wait" 8 || { exec 8>&-; return 1; }
        else flock -n 8 || { exec 8>&-; return 1; }
        fi
        INBOX_LOCKED="flock"
        return 0
    fi
    while :; do
        if mkdir "$D/lock.d" 2>/dev/null; then
            printf '%s %s %s' "$$" "$(host_name)" "$(date +%s)" > "$D/lock.d/owner"
            INBOX_LOCKED="mkdir"
            return 0
        fi
        # A lock whose owner died, or older than any reading, is broken; one
        # rename decides who breaks it.
        owner=$(cat "$D/lock.d/owner" 2>/dev/null || true)
        pid=${owner%% *}; stamp=${owner##* }; now=$(date +%s)
        if { is_number "$pid" && ! kill -0 "$pid" 2>/dev/null; } ||
           { is_number "$stamp" && [ $(( now - stamp )) -gt $(( TIMEOUT + 35 )) ]; }; then
            mv "$D/lock.d" "$D/lock.stale.$$" 2>/dev/null && rm -rf "$D/lock.stale.$$"
            continue
        fi
        tries=$(( tries + 1 ))
        [ "$tries" -le "$wait" ] || return 1
        sleep 1
    done
}

inbox_unlock() {
    case "$INBOX_LOCKED" in
        flock) exec 8>&- ;;
        mkdir) rm -rf "$(inbox_dir)/lock.d" ;;
    esac
    INBOX_LOCKED=""
    return 0
}

waiter_register() {
    # waiter_register NONCE KIND POLL_ID TEXT DEADLINE: a question waits.
    local D
    D=$(inbox_dir)
    INBOX_WAITER="$D/waiters/$1"
    atomic_write "$INBOX_WAITER" "$$ $CHATS_CURRENT pending $2 ${3:--} $4 $5"
}

waiter_set() {
    # waiter_set FIELD VALUE: the message id (3) or the poll id (5) of the
    # waiting question, once it is known.
    local f=()
    [ -n "$INBOX_WAITER" ] || return 0
    # The files end without a line break, so read reports failure at the end
    # of a line it did read: the fields themselves are what count.
    read -r -a f < "$INBOX_WAITER" 2>/dev/null
    [ "${#f[@]}" -ge 7 ] || return 0
    f[$1 - 1]="$2"
    atomic_write "$INBOX_WAITER" "${f[*]}"
}

waiter_alive() {
    # waiter_alive NONCE: the question still waits (its process lives and its
    # deadline has not passed).
    local f=()
    read -r -a f < "$(inbox_dir)/waiters/$1" 2>/dev/null
    [ "${#f[@]}" -ge 7 ] || return 1
    kill -0 "${f[0]}" 2>/dev/null || return 1
    [ "${f[6]}" -ge "$(date +%s)" ] 2>/dev/null
}

waiter_find() {
    # waiter_find CHAT FIELD VALUE -> the nonce of a live question of that
    # chat whose field (3 message id, 5 poll id) has that value.
    local D w f now
    D=$(inbox_dir); now=$(date +%s)
    for w in "$D"/waiters/*; do
        [ -f "$w" ] || continue
        f=()
        read -r -a f < "$w" 2>/dev/null
        [ "${#f[@]}" -ge 7 ] || continue
        kill -0 "${f[0]}" 2>/dev/null || continue
        [ "${f[6]}" -ge "$now" ] 2>/dev/null || continue
        [ -z "$1" ] || [ "${f[1]}" = "$1" ] || continue
        [ "${f[$(( $2 - 1 ))]}" = "$3" ] || continue
        basename "$w"
        return 0
    done
    return 1
}

waiter_find_receive() {
    # waiter_find_receive CHAT CONTENT REPLY_TO MESSAGE_ID -> the nonce of
    # the live 'receive' of that chat a file belongs to: the one whose
    # prompt the file answers, else the one whose prompt it directly
    # follows, else the oldest one waiting for files of that kind.
    local D w f now best="" best_deadline=0
    D=$(inbox_dir); now=$(date +%s)
    for w in "$D"/waiters/*; do
        [ -f "$w" ] || continue
        f=()
        read -r -a f < "$w" 2>/dev/null
        [ "${#f[@]}" -ge 7 ] || continue
        [ "${f[3]}" = "receive" ] || continue
        kill -0 "${f[0]}" 2>/dev/null || continue
        [ "${f[6]}" -ge "$now" ] 2>/dev/null || continue
        [ "${f[1]}" = "$1" ] || continue
        case "${f[4]}" in any|"$2") ;; *) continue ;; esac
        if [ -n "$3" ] && [ "${f[2]}" = "$3" ]; then basename "$w"; return 0; fi
        if is_number "$4" && is_number "${f[2]}" && [ "${f[2]}" -eq $(( $4 - 1 )) ]; then basename "$w"; return 0; fi
        if [ -z "$best" ] || [ "${f[6]}" -lt "$best_deadline" ]; then best=$(basename "$w"); best_deadline=${f[6]}; fi
    done
    [ -n "$best" ] || return 1
    printf '%s' "$best"
}

inbox_route() {
    # inbox_route KIND CHAT PAYLOAD REF MESSAGE_ID REPLY_TO CONTENT -> where
    # an update goes: the nonce of its question, "pending", "hold" (perhaps
    # another computer's), "closed" (a press on an expired question) or
    # "drop" (nobody's).
    local kind="$1" chat="$2" payload="$3" ref="$4" mid="$5" replyto="$6" content="$7" nonce w D
    D=$(inbox_dir)
    case "$kind" in
        callback)
            case "$payload" in
                a:*:*)
                    nonce=${payload#a:}; nonce=${nonce%%:*}
                    case "$nonce" in
                        "$(machine_mark)"*)
                            if waiter_alive "$nonce"; then printf '%s' "$nonce"; else printf 'closed'; fi ;;
                        *) printf 'hold' ;;
                    esac ;;
                *) printf 'drop' ;;
            esac ;;
        message)
            case "$content" in
                text)
                    # Commands answer nothing.
                    case "$payload" in /*|"") printf 'drop'; return 0 ;; esac
                    if [ -n "$replyto" ]; then
                        if w=$(waiter_find "$chat" 3 "$replyto"); then printf '%s' "$w"
                        elif waiter_find "$chat" 3 pending >/dev/null; then printf 'pending'
                        else printf 'hold'
                        fi
                    elif is_number "$mid" && w=$(waiter_find "$chat" 3 $(( mid - 1 ))) &&
                         [ "$(cut -d' ' -f6 "$D/waiters/$w")" = "1" ]; then
                        printf '%s' "$w"
                    else
                        printf 'hold'
                    fi ;;
                photo|document|video|animation|audio|voice|video_note)
                    # A file goes to the 'receive' that waits for one; kept
                    # otherwise, since one may start on another computer.
                    if w=$(waiter_find_receive "$chat" "$content" "$replyto" "$mid"); then printf '%s' "$w"
                    else printf 'hold'
                    fi ;;
                *)  printf 'drop' ;;
            esac ;;
        poll_answer)
            if w=$(waiter_find "" 5 "$ref"); then printf '%s' "$w"; else printf 'hold'; fi ;;
        *)
            printf 'drop' ;;
    esac
}

inbox_reroute_pending() {
    # A reply that arrived before its question was recorded finds it now,
    # or is dropped after two minutes.
    local D f rec replyto chat w now stamp
    D=$(inbox_dir); now=$(date +%s)
    for f in "$D"/inbox/*.pending; do
        [ -f "$f" ] || continue
        rec=$(cat "$f")
        IFS="$US" read -r _ _ chat _ _ _ _ replyto _ <<EOF
$rec
EOF
        if w=$(waiter_find "$chat" 3 "$replyto"); then
            mv "$f" "${f%.pending}.$w" 2>/dev/null
        else
            stamp=$(cat "$D/seen/$(basename "${f%.pending}")" 2>/dev/null || echo "$now")
            [ $(( now - stamp )) -gt 120 ] && mv "$f" "$D/taken/" 2>/dev/null
        fi
    done
    return 0
}

inbox_gc() {
    # Records older than a day go, and so do questions whose process died or
    # whose deadline passed a minute ago.
    local D w f now
    D=$(inbox_dir); now=$(date +%s)
    find "$D/taken" "$D/inbox" "$D/seen" "$D/held" -type f -mmin +1440 -exec rm -f {} + 2>/dev/null
    for w in "$D"/waiters/*; do
        [ -f "$w" ] || continue
        f=()
        read -r -a f < "$w" 2>/dev/null
        # A file still being written may look empty for a moment: it is kept.
        [ "${#f[@]}" -ge 7 ] || continue
        if ! kill -0 "${f[0]}" 2>/dev/null || [ $(( now - f[6] )) -gt 60 ]; then rm -f "$w"; fi
    done
    return 0
}

inbox_answer_closed() {
    # A press on a question that no longer waits: the phone stops spinning.
    local saved="$API_BODY"
    req_reset
    req_add callback_query_id "$1"
    req_add text "This question has closed"
    api_call answerCallbackQuery >/dev/null 2>&1 || true
    API_BODY="$saved"
}

inbox_round() {
    # inbox_round SECONDS: one reading of the queue by the holder of the lock,
    # with a long poll of at most SECONDS. Every update is filed for its
    # question; then the offset advances, never past an update held for
    # another computer. Returns 2 when another reader got there first.
    local wait="$1" D offset rc rec uid kind chat payload ref mid replyto content first target
    local hold="" maxuid=0 now new
    D=$(inbox_dir)
    offset=$(cat "$D/offset" 2>/dev/null || echo 0); is_number "$offset" || offset=0
    inbox_reroute_pending
    req_reset
    [ "$offset" -gt 0 ] && req_add offset "$offset"
    req_add timeout "$wait"
    req_add allowed_updates '["message","callback_query","poll_answer"]'
    local TIMEOUT=$(( wait + 10 ))
    api_call getUpdates
    rc=$?
    if [ "$rc" -ne 0 ]; then
        case "$API_ERROR" in
            *webhook*)
                # Fatal, and raised again by updates_check_fatal in the main
                # shell, since this may run in a subshell.
                printf '%s' "a webhook is set for this bot, so its updates cannot be read here.
  Remove it (deleteWebhook) to use ask, poll --wait and chats." > "$(workdir)/updates.fatal"
                return 3 ;;
            *"terminated by other getUpdates"*|*Conflict*) return 2 ;;
        esac
        return "$rc"
    fi
    now=$(date +%s)
    while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        IFS="$US" read -r uid kind chat _ payload ref mid replyto _ content _ <<EOF
$rec
EOF
        is_number "$uid" || continue
        [ "$uid" -gt "$maxuid" ] && maxuid=$uid
        if [ -f "$D/seen/$uid" ]; then
            first=$(cat "$D/seen/$uid" 2>/dev/null || echo "$now")
            if [ -f "$D/held/$uid" ] && [ $(( now - first )) -lt 600 ]; then
                # A question that started since may claim it: a file sent
                # before 'receive' began waiting still reaches it.
                target=$(inbox_route "$kind" "$chat" "$payload" "$ref" "$mid" "$replyto" "$content")
                case "$target" in
                    hold|drop|closed|pending) [ -n "$hold" ] || hold=$uid ;;
                    *) atomic_write "$D/inbox/$uid.$target" "$rec"; rm -f "$D/held/$uid" ;;
                esac
            fi
            continue
        fi
        printf '%s' "$now" > "$D/seen/$uid"
        target=$(inbox_route "$kind" "$chat" "$payload" "$ref" "$mid" "$replyto" "$content")
        case "$target" in
            hold)   : > "$D/held/$uid"; [ -n "$hold" ] || hold=$uid ;;
            drop)   ;;
            closed) inbox_answer_closed "$ref" ;;
            *)      atomic_write "$D/inbox/$uid.$target" "$rec" ;;
        esac
    done <<EOF
$(printf '%s' "$API_BODY" | updates_extract)
EOF
    if [ -n "$hold" ]; then new=$hold
    elif [ "$maxuid" -gt 0 ]; then new=$(( maxuid + 1 ))
    else new=$offset
    fi
    [ "$new" -gt "$offset" ] && [ "$DRY_RUN" -eq 0 ] && atomic_write "$D/offset" "$new"
    inbox_gc
    return 0
}

inbox_claim() {
    # inbox_claim NONCE -> the first record filed for that question, moved
    # into taken/ (a rename: only one process can win it).
    local D f
    D=$(inbox_dir)
    for f in "$D"/inbox/*."$1"; do
        [ -f "$f" ] || continue
        if mv "$f" "$D/taken/" 2>/dev/null; then
            cat "$D/taken/$(basename "$f")"
            return 0
        fi
    done
    return 1
}

inbox_wait() {
    # inbox_wait NONCE DEADLINE -> the record that answers the question, or
    # nothing at the deadline. Reads the queue whenever the lock is free;
    # meanwhile another process of this computer reads it, and between
    # computers a refused reading means a short wait.
    local nonce="$1" deadline="$2" rec now remaining rc
    while :; do
        if rec=$(inbox_claim "$nonce"); then
            printf '%s' "$rec"
            return 0
        fi
        now=$(date +%s); remaining=$(( deadline - now ))
        [ "$remaining" -gt 0 ] || return 1
        if inbox_lock_try 0; then
            [ "$remaining" -gt 10 ] && remaining=10
            inbox_round "$remaining"; rc=$?
            inbox_unlock
            [ "$rc" -eq 3 ] && return 3
            [ "$rc" -eq 2 ] && sleep $(( 2 + RANDOM % 4 ))
            [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ] && sleep 2
        else
            sleep 1
        fi
    done
}

updates_snapshot() {
    # Every update Telegram still holds from this computer's offset, read
    # under the lock and confirmed for nobody: chats and init list them.
    local D offset rc
    inbox_lock_try 35 || { printf '%s' "the update reader stayed busy for 35 seconds, try again" > "$(workdir)/updates.fatal"; return 0; }
    D=$(inbox_dir)
    offset=$(cat "$D/offset" 2>/dev/null || echo 0); is_number "$offset" || offset=0
    req_reset
    [ "$offset" -gt 0 ] && req_add offset "$offset"
    req_add timeout 0
    api_call getUpdates
    rc=$?
    inbox_unlock
    if [ "$rc" -ne 0 ]; then
        printf '%s' "$(api_explain "$API_ERROR")" > "$(workdir)/updates.fatal"
        return 0
    fi
    printf '%s' "$API_BODY" | updates_extract
}

updates_check_fatal() {
    # fetch_updates runs inside a command substitution, where an exit would
    # only end the subshell, so a fatal error is raised again here.
    local marker text
    marker="$(workdir)/updates.fatal"
    [ -f "$marker" ] || return 0
    text=$(cat "$marker")
    rm -f "$marker"
    die "$EX_API" "$text"
}

# ---------------------------------------------------------------------------
# run: wrap a command and report how it went
# ---------------------------------------------------------------------------

RUN_STOP=""; RUN_LOCK=""; RUN_LIMIT_HIT=""; RUN_LOG_OWN=1; RUN_INTERRUPTED=0
RUN_ALERTS=(); RUN_ALERT_DIR=""
readonly RUN_LOG_CAP=47185920      # 45 MiB of log are kept, the end of it

log_tail() {
    # log_tail LINES FILE -> the last lines of a log as they look on screen:
    # colour codes gone, a line redrawn with carriage returns shown in its
    # final state, invalid bytes replaced, each line at most 300 characters.
    tail -n "$1" "$2" 2>/dev/null |
        sed -e "s/$ESC\[[0-9;?]*[A-Za-z]//g" -e "s/.*$CR\(.\)/\1/" -e "s/$CR\$//" | utf8_clean 300
}

run_send_status() {
    # run_send_status LABEL TEXT LEVEL: the message that opens a run, sent to
    # the first chat; its id is printed. Runs in a subshell of its caller.
    local TITLE="$1" BODY="$2" LEVEL="$3" CHATS="$CHATS_CURRENT" META=1 PROGRESS_INFO=""
    local CODE_TEXT="" QUOTE_TEXT="" PERCENT=""
    deliver "$(build_message)" >/dev/null 2>&1 || return 1
    json_get "$API_BODY" "result.message_id"
}

run_status_text() {
    # run_status_text LABEL START LOG LEVEL INFO -> the status message during or
    # after a run: the elapsed time, and the last lines while it runs.
    local TITLE="$1" LEVEL="$4" BODY="" META=0 PERCENT="" QUOTE_TEXT="" CODE_LANG=""
    local CODE_TEXT="" PROGRESS_INFO="$5"
    if [ -z "$PROGRESS_INFO" ]; then
        PROGRESS_INFO=$(fmt_italic "running for $(human_duration $(( $(date +%s) - $2 )))")
        CODE_TEXT=$(log_tail 10 "$3")
    fi
    build_message
}

run_edit_status() {
    # run_edit_status MESSAGE_ID TEXT: one silent edit of the status message,
    # skipped rather than delayed when Telegram asks to slow down.
    local rc
    edit_request "$CHATS_CURRENT" "$1" "$2"
    NO_RATE_WAIT=1
    api_call editMessageText >/dev/null 2>&1; rc=$?
    NO_RATE_WAIT=0
    return "$rc"
}

run_send_stall() {
    # run_send_stall LABEL SECONDS LOG REPLY_TO: the one warning of a run that
    # has gone silent, as a new message, so that the phone rings.
    local TITLE="$1 is silent" LEVEL="warn" META=0 PERCENT="" QUOTE_TEXT="" PROGRESS_INFO=""
    local BODY CODE_LANG="" CODE_TEXT REPLY_TO="$4"
    BODY="no output for $(human_duration "$2"); the last lines were:"
    CODE_TEXT=$(log_tail 5 "$3")
    deliver "$(build_message)" >/dev/null 2>&1 || true
}

run_send_alert() {
    # run_send_alert LABEL PATTERN LINE_NUMBER LOG REPLY_TO: the one message
    # for a pattern seen in the output, as a new message so that the phone
    # rings, with the matching line and the few lines before it.
    local TITLE="$1" LEVEL="warn" META=0 PERCENT="" QUOTE_TEXT="" PROGRESS_INFO="" CODE_LANG=""
    local BODY CODE_TEXT REPLY_TO="$5" from
    BODY="the output matched '$2' at line $3:"
    from=$(( $3 - 4 )); [ "$from" -ge 1 ] || from=1
    CODE_TEXT=$(sed -n "${from},${3}p" "$4" 2>/dev/null |
        sed -e "s/$ESC\[[0-9;?]*[A-Za-z]//g" -e "s/.*$CR\(.\)/\1/" -e "s/$CR\$//" | utf8_clean 300)
    deliver "$(build_message)" >/dev/null 2>&1 || true
}

run_check_alerts() {
    # run_check_alerts LOG FROM LABEL REPLY_TO: the lines of the log written
    # after byte FROM, searched for each --alert pattern not yet seen; the
    # first line matching a pattern is reported at once, that pattern then
    # resting for the rest of the run.
    local log="$1" from="$2" label="$3" reply="$4" i=0 pat rel abs before
    while [ "$i" -lt "${#RUN_ALERTS[@]}" ]; do
        pat="${RUN_ALERTS[$i]}"
        if [ ! -f "$RUN_ALERT_DIR/$i" ]; then
            rel=$(tail -c +$(( from + 1 )) "$log" 2>/dev/null | grep -n -E -m 1 -- "$pat" 2>/dev/null | cut -d: -f1)
            if is_number "$rel"; then
                : > "$RUN_ALERT_DIR/$i"
                before=$(head -c "$from" "$log" 2>/dev/null | wc -l | tr -d ' ')
                is_number "$before" || before=0
                abs=$(( before + rel ))
                run_send_alert "$label" "$pat" "$abs" "$log" "$reply"
            fi
        fi
        i=$(( i + 1 ))
    done
}

run_watcher() {
    # The companion of a run, in the background: it edits the status message
    # every EVERY seconds, warns once when the log has been silent STALL
    # seconds, reports the first line matching each --alert pattern, keeps
    # the log within its cap, and stops the command at LIMIT seconds when no
    # 'timeout' can. It works in a folder of its own, since the request
    # files of api_call would collide with the parent's.
    local parent="$1" log="$2" mid="$3" every="$4" stall="$5" label="$6" start="$7" limit="$8"
    local pidfile="$9" now size last_size=-1 last_change last_edit stalled=0 tick=5 child scanned=0
    WORKDIR="$(dirname "$RUN_STOP")/watch"
    mkdir -p "$WORKDIR" || return 0
    { [ "$every" -gt 0 ] && [ "$every" -lt 30 ]; } && tick=1
    { [ "$stall" -gt 0 ] && [ "$stall" -lt 30 ]; } && tick=1
    { [ "$limit" -gt 0 ] && [ "$limit" -lt 30 ]; } && tick=1
    [ ${#RUN_ALERTS[@]} -gt 0 ] && tick=1
    last_change=$(date +%s); last_edit=$last_change
    while kill -0 "$parent" 2>/dev/null && [ ! -f "$RUN_STOP" ]; do
        sleep "$tick"
        [ -f "$RUN_STOP" ] && break
        now=$(date +%s)
        size=$(file_size "$log"); is_number "$size" || size=0
        if [ "$size" != "$last_size" ]; then last_size=$size; last_change=$now; stalled=0; fi
        if [ ${#RUN_ALERTS[@]} -gt 0 ]; then
            [ "$size" -lt "$scanned" ] && scanned=0
            if [ "$size" -gt "$scanned" ]; then
                run_check_alerts "$log" "$scanned" "$label" "$mid"
                scanned=$size
            fi
        fi
        if [ "$RUN_LOG_OWN" -eq 1 ] && [ "$size" -gt "$RUN_LOG_CAP" ]; then
            tail -c $(( RUN_LOG_CAP * 9 / 10 )) "$log" > "$log.cut" 2>/dev/null && cat "$log.cut" > "$log"
            rm -f "$log.cut"
            scanned=0
        fi
        if [ "$stall" -gt 0 ] && [ "$stalled" -eq 0 ] && [ $(( now - last_change )) -ge "$stall" ]; then
            stalled=1
            run_send_stall "$label" $(( now - last_change )) "$log" "$mid"
        fi
        if [ "$every" -gt 0 ] && [ -n "$mid" ] && [ $(( now - last_edit )) -ge "$every" ]; then
            last_edit=$now
            if mutex_acquire "$RUN_LOCK" 2; then
                [ -f "$RUN_STOP" ] || run_edit_status "$mid" "$(run_status_text "$label" "$start" "$log" progress "")"
                mutex_release "$RUN_LOCK"
            fi
        fi
        if [ "$limit" -gt 0 ] && [ -n "$pidfile" ] && [ $(( now - start )) -ge "$limit" ]; then
            child=$(cat "$pidfile" 2>/dev/null || true)
            if is_number "$child"; then
                : > "$RUN_LIMIT_HIT"
                kill -TERM "$child" 2>/dev/null
                sleep 5
                kill -KILL "$child" 2>/dev/null
            fi
            limit=0
        fi
    done
    return 0
}

run_attach_log() {
    # run_attach_log LOG LABEL: the complete log, as a document, to every chat.
    local log="$1" label="$2" name file chat lines
    [ -s "$log" ] || return 0
    name="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-60).log"
    file="$(mktemp -d "$(workdir)/log.XXXXXX")/$name"
    cp "$log" "$file" 2>/dev/null || return 0
    lines=$(wc -l < "$file" | tr -d ' ')
    if [ "$(file_size "$file")" -gt "$TG_UPLOAD_LIMIT" ] && have gzip; then
        gzip -9 "$file" && file="$file.gz" && name="$name.gz"
    fi
    [ "$(file_size "$file")" -le "$TG_UPLOAD_LIMIT" ] || { warn "the log is too large to attach"; return 0; }
    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"; MEDIA_KEYBOARD=0
        send_media_file sendDocument document "$file" "$(fmt_italic "the complete log, $lines lines")" "$name" ||
            warn "the log could not be attached"
        MEDIA_KEYBOARD=1
    done
}

cmd_run() {
    local label="" notify_start=0 tail_lines="$RUN_TAIL" when="always" quiet_output=0 exit_zero=0
    local limit="" every="" stall="" attach_log=0 log_path="" limit_s=0 every_s=0 stall_s=0
    local rc start elapsed wd log notify=0 status_mid="" wpid="" pidfile="" use_timeout=0
    local limit_hit=0 report=1 level body
    local passthru=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --label|-l|--tail|--on|--limit|--every|--stall|--log|--alert)
                [ $# -ge 2 ] || die "$EX_USAGE" "$1 needs a value" ;;
        esac
        case "$1" in
            --label|-l)          label="$2"; shift 2 ;;
            --notify-start)      notify_start=1; shift ;;
            --tail)              tail_lines="$2"; shift 2 ;;
            --on)                when="$2"; shift 2 ;;
            --quiet-output)      quiet_output=1; shift ;;
            --exit-zero)         exit_zero=1; shift ;;
            --limit)             limit="$2"; shift 2 ;;
            --every)             every="$2"; shift 2 ;;
            --stall)             stall="$2"; shift 2 ;;
            --alert)             RUN_ALERTS[${#RUN_ALERTS[@]}]="$2"; shift 2 ;;
            --log)               log_path="$2"; shift 2 ;;
            --attach-log)        attach_log=1; shift ;;
            --attach-log-always) attach_log=2; shift ;;
            -h|--help)           help_run; exit "$EX_OK" ;;
            --)                  shift; break ;;
            -*)
                # Every other flag belongs to the common set, so that
                # 'run --silent --chat 123 -- make' behaves as expected.
                passthru[${#passthru[@]}]="$1"
                case "$VALUE_OPTS" in
                    *" $1 "*) [ $# -ge 2 ] || die "$EX_USAGE" "$1 needs a value"
                              passthru[${#passthru[@]}]="$2"; shift 2 ;;
                    *)        shift ;;
                esac ;;
            *)                   break ;;
        esac
    done
    [ $# -gt 0 ] || die "$EX_USAGE" "'run' needs a command, for example: $TG_PING_NAME run -- make test"
    [ -n "$label" ] || label="$*"
    [ ${#passthru[@]} -eq 0 ] || parse_common_args "${passthru[@]}"
    case "$when" in
        always|success|failure|fail|never) ;;
        *) die "$EX_USAGE" "--on takes always, success, failure or never" ;;
    esac
    is_number "$tail_lines" || die "$EX_USAGE" "--tail takes a number of lines"
    if [ -n "$limit" ]; then limit_s=$(parse_duration "$limit") || die "$EX_USAGE" "--limit takes a duration such as 90s, 15m or 2h"; fi
    if [ -n "$every" ]; then every_s=$(parse_duration "$every") || die "$EX_USAGE" "--every takes a duration such as 15m"; fi
    if [ -n "$stall" ]; then stall_s=$(parse_duration "$stall") || die "$EX_USAGE" "--stall takes a duration such as 20m"; fi

    wd=$(workdir)
    if [ -n "$log_path" ]; then
        log="$log_path"; RUN_LOG_OWN=0
        : > "$log" 2>/dev/null || die "$EX_USAGE" "cannot write the log $log"
    else
        log="$wd/run.log"; RUN_LOG_OWN=1
        : > "$log"
    fi
    RUN_STOP="$wd/run.stop"; RUN_LOCK="$wd/run.lock"; RUN_LIMIT_HIT="$wd/run.limit"
    RUN_ALERT_DIR="$wd/alerts"; mkdir -p "$RUN_ALERT_DIR"
    local pat
    for pat in ${RUN_ALERTS[@]+"${RUN_ALERTS[@]}"}; do
        printf '' | grep -E -- "$pat" >/dev/null 2>&1
        [ $? -le 1 ] || die "$EX_USAGE" "--alert takes an extended regular expression, and '$pat' is not one"
    done

    # The command runs whatever happens to the notifications.
    if [ "$DISABLED" != "1" ]; then
        load_config
        if [ -n "$TOKEN" ] && [ -n "$CHATS" ]; then
            notify=1
            CHATS_CURRENT=$(chat_list | head -n1)
        else
            warn "no bot settings were found: the command runs without notifications"
        fi
    fi

    start=$(date +%s)
    if [ "$notify" -eq 1 ]; then
        if [ "$every_s" -gt 0 ]; then
            status_mid=$(run_send_status "$label" "running since $(date '+%H:%M')" progress) || status_mid=""
        elif [ "$notify_start" -eq 1 ]; then
            run_send_status "$label" "started" start >/dev/null || true
        fi
    fi

    if [ "$limit_s" -gt 0 ]; then
        if have timeout && timeout --foreground 5 true >/dev/null 2>&1; then
            # --foreground leaves the command in the terminal's group, so that
            # Ctrl-C still reaches it.
            set -- timeout --foreground "$limit_s" "$@"; use_timeout=1
        else
            pidfile="$wd/run.pid"
            # The shell writes its own process id, then becomes the command.
            # shellcheck disable=SC2089,SC2090  # the quotes belong to the sh script
            set -- sh -c 'echo "$$" > "$0"; exec "$@"' "$pidfile" "$@"
        fi
    fi
    rm -f "$RUN_STOP" "$RUN_LIMIT_HIT"
    if { [ "$notify" -eq 1 ] && { [ "$every_s" -gt 0 ] || [ "$stall_s" -gt 0 ] || [ ${#RUN_ALERTS[@]} -gt 0 ]; }; } ||
       [ -n "$pidfile" ]; then
        ( run_watcher "$$" "$log" "$status_mid" "$every_s" "$stall_s" "$label" "$start" "$limit_s" "$pidfile" ) &
        wpid=$!
    fi

    # The command stays in the foreground, so that its input and Ctrl-C
    # behave as without tg-ping; tee ignores the interruption and keeps
    # logging the command's last words.
    export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
    RUN_INTERRUPTED=0
    trap 'RUN_INTERRUPTED=1' INT HUP TERM
    if [ "$quiet_output" -eq 1 ]; then
        "$@" >>"$log" 2>&1
        rc=$?
    else
        "$@" 2>&1 | ( trap '' INT HUP; exec tee -a "$log" )
        rc=${PIPESTATUS[0]}
    fi
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap - HUP
    elapsed=$(( $(date +%s) - start ))
    : > "$RUN_STOP"
    if [ -n "$wpid" ]; then
        kill "$wpid" 2>/dev/null
        wait "$wpid" 2>/dev/null
    fi
    { [ "$use_timeout" -eq 1 ] && [ "$rc" -eq 124 ]; } && limit_hit=1
    [ -f "$RUN_LIMIT_HIT" ] && limit_hit=1

    case "$when" in
        success)      [ "$rc" -eq 0 ] || report=0 ;;
        failure|fail) [ "$rc" -ne 0 ] || report=0 ;;
        never)        report=0 ;;
    esac

    if [ "$RUN_INTERRUPTED" -eq 1 ]; then
        level="warn"; body="interrupted after $(human_duration "$elapsed")"
    elif [ "$limit_hit" -eq 1 ]; then
        level="error"; body="stopped at the time limit of $(human_duration "$limit_s")"
    elif [ "$rc" -eq 0 ]; then
        level="success"; body="finished in $(human_duration "$elapsed")"
    else
        level="error"; body="failed with exit code $rc after $(human_duration "$elapsed")"
    fi

    if [ "$notify" -eq 1 ]; then
        # The status message takes its final form, silently; the report
        # follows as a new message, since an edit never rings the phone.
        if [ -n "$status_mid" ] && is_number "$status_mid" && mutex_acquire "$RUN_LOCK" 10; then
            run_edit_status "$status_mid" "$(run_status_text "$label" "$start" "$log" "$level" "$(fmt_italic "$body")")" || true
            mutex_release "$RUN_LOCK"
        fi
        if [ "$report" -eq 1 ]; then
            LEVEL="${LEVEL:-$level}"; TITLE="${TITLE:-$label}"; BODY="${BODY:-$body}"
            if [ "$rc" -ne 0 ] || [ "$RUN_INTERRUPTED" -eq 1 ]; then
                if [ "$tail_lines" -gt 0 ] && [ -s "$log" ]; then
                    CODE_TEXT=$(log_tail "$tail_lines" "$log"); CODE_LANG=""
                fi
            fi
            FIELDS[${#FIELDS[@]}]="exit=$rc"
            FIELDS[${#FIELDS[@]}]="took=$(human_duration "$elapsed")"
            META=1
            [ -n "$status_mid" ] && REPLY_TO="$status_mid"
            # A figure named with --photo may be the command's own product:
            # one that is missing is left out, and the report still goes.
            ATTACH_LENIENT=1
            deliver_message || warn "the notification itself could not be delivered"
            [ "$DELIVER_SUPPRESSED" -eq 1 ] && note "the report repeats one sent within --cooldown, it was not sent"
            if [ "$attach_log" -eq 2 ] || { [ "$attach_log" -eq 1 ] && [ "$rc" -ne 0 ]; }; then
                run_attach_log "$log" "$label"
            fi
        fi
    fi

    [ "$exit_zero" -eq 1 ] && exit 0
    exit "$rc"
}

# ---------------------------------------------------------------------------
# progress: one message, edited in place
# ---------------------------------------------------------------------------

progress_state_file() {
    # The slot of a progress message: per chat, and per --key, or per project
    # when no key is given, so that two sessions never edit the same message.
    printf '%s/progress.%s.%s' "$(state_dir)" "$(slot_name "${CHATS_CURRENT:-default}")" \
        "$(slot_name "${PROGRESS_KEY:-$(project_key)}")"
}

tg_time() {
    # tg_time EPOCH TEXT: Telegram's live clock in the HTML formats (format r
    # shows "in 35 minutes" and keeps counting down), the text elsewhere.
    case "$FORMAT" in
        auto|html|rich) printf '<tg-time unix="%s" format="r">%s</tg-time>' "$1" "$(fmt_escape "$2")" ;;
        *)              printf '%s' "$2" ;;
    esac
}

progress_timing() {
    # progress_timing ACTION START EXPECTED -> the timing line of a progress
    # message: at the start the expected duration; during the work the time
    # elapsed and, with a percentage, the expected end; at the end the
    # duration against the prediction.
    local action="$1" start="$2" expected="$3" now elapsed pct end line
    now=$(date +%s)
    is_number "$expected" || expected=0
    case "$action" in
        start)
            [ "$expected" -gt 0 ] && fmt_italic "expected to take $(human_duration "$expected")"
            return 0 ;;
    esac
    is_number "$start" && [ "$start" -gt 0 ] || return 0
    elapsed=$(( now - start )); [ "$elapsed" -ge 0 ] || elapsed=0
    case "$action" in
        done|finish|end)
            line="took $(human_duration "$elapsed")"
            [ "$expected" -gt 0 ] && line="$line, against $(human_duration "$expected") expected"
            fmt_italic "$line" ;;
        *)
            line=$(fmt_italic "running for $(human_duration "$elapsed")")
            pct=""
            [ -n "$PERCENT" ] && pct=$(percent_value "$PERCENT")
            if is_number "$pct" && [ "$pct" -gt 0 ] && [ "$pct" -lt 100 ] && [ "$elapsed" -gt 0 ]; then
                end=$(( start + elapsed * 100 / pct ))
                line="$line · $(fmt_italic "ends") $(tg_time "$end" "in about $(human_duration $(( end - now )))")"
            elif [ "$expected" -gt 0 ] && [ $(( start + expected )) -gt "$now" ]; then
                end=$(( start + expected ))
                line="$line · $(fmt_italic "expected to end") $(tg_time "$end" "in about $(human_duration $(( end - now )))")"
            fi
            printf '%s' "$line" ;;
    esac
}

fit_message() {
    # fit_message TEXT -> the text, cut to one message when it is longer.
    local wd n
    if [ "$(visible_length "$1" "$(split_mode)")" -le "$TG_MAX_TEXT" ]; then
        printf '%s' "$1"
        return 0
    fi
    wd=$(workdir); rm -f "$wd"/fit.* 2>/dev/null
    n=$(split_into_files "$1" $(( TG_MAX_TEXT - 46 )) "$wd" fit "$(split_mode)")
    is_number "$n" && [ "$n" -gt 0 ] && printf '%s\n%s' "$(cat "$wd/fit.001")" "$(fmt_italic "(cut to fit one message)")"
}

cmd_progress() {
    local mid="" rc text action i rest="" slot state smid start expected=0 kb
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_progress; exit "$EX_OK"; }

    action="${REMAINING[0]:-}"
    case "$action" in
        start|update|done|finish|end) ;;
        "") help_progress; exit "$EX_USAGE" ;;
        *) die "$EX_USAGE" "'progress' expects start, update or done, not '$action'" ;;
    esac

    i=1
    while [ "$i" -lt "${#REMAINING[@]}" ]; do
        rest="${rest:+$rest }${REMAINING[$i]}"
        i=$(( i + 1 ))
    done
    [ -n "$BODY" ] || BODY="$rest"
    if [ -n "$PROGRESS_EXPECTED" ]; then
        expected=$(parse_duration "$PROGRESS_EXPECTED") ||
            die "$EX_USAGE" "--expected takes a duration such as 90s, 15m, 2h or 1h30m"
    fi
    read_stdin_if_piped
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)
    if [ "$(chat_list | wc -l)" -gt 1 ]; then
        warn "'progress' edits one message, using chat $CHATS_CURRENT"
        CHATS="$CHATS_CURRENT"
    fi

    # The slot holds "message_id start_time expected_seconds format": a
    # message keeps, through its edits, the form it was sent in.
    slot=$(progress_state_file)
    state=$(cat "$slot" 2>/dev/null || true)
    read -r smid start rest smode _ <<EOF
$state
EOF
    is_number "$rest" && [ "$expected" -eq 0 ] && expected="$rest"
    mid="${PROGRESS_ID:-$smid}"
    case "$smode" in auto|html|markdown|plain|rich) [ -n "$PROGRESS_ID" ] || FORMAT="$smode" ;; esac

    if [ "$action" = "start" ] || ! is_number "$mid" || [ "$mid" = "0" ]; then
        # Nothing to edit yet: an update opens the message, a final word goes
        # out as a message of its own.
        [ "$action" = "start" ] || note "no progress message to edit, sending a new one"
        start=$(date +%s)
        if [ -z "$LEVEL" ]; then
            case "$action" in start|update) LEVEL="progress" ;; *) LEVEL="success" ;; esac
        fi
        PROGRESS_INFO=$(progress_timing start "$start" "$expected")
        case "$action" in
            start|update)
                deliver "$(build_message)" || finish_failure $?
                mid=$(json_get "$API_BODY" "result.message_id")
                [ "$DRY_RUN" -eq 1 ] || atomic_write "$slot" "$mid $start $expected $FORMAT" || true
                # Pictures and formulas follow as a reply: the message is
                # edited later and an edited text cannot carry them.
                send_attachments_reply "$mid"
                [ "$action" = "start" ] && [ "$JSON_OUT" -eq 0 ] && printf '%s\n' "$mid" ;;
            *)  deliver_message || finish_failure $? ;;
        esac
        exit "$EX_OK"
    fi

    if [ "$action" != "update" ] && [ -z "$LEVEL" ]; then LEVEL="success"; fi
    [ -n "$LEVEL" ] || LEVEL="progress"
    PROGRESS_INFO=$(progress_timing "$action" "$start" "$expected")
    text=$(build_message)
    kb=$(buttons_json) || kb=""
    edit_request "$CHATS_CURRENT" "$mid" "$text"
    req_add reply_markup "$kb"
    # A rate limit skips an intermediate update instead of blocking the
    # computation that sends it; the final word waits its turn.
    [ "$action" = "update" ] && NO_RATE_WAIT=1
    api_call editMessageText
    rc=$?
    NO_RATE_WAIT=0
    if [ "$rc" -ne 0 ]; then
        case "$API_ERROR" in
            *"not modified"*)
                note "the message already carries this text" ;;
            *"rate limited"*)
                note "Telegram asks to slow down, this update is skipped"
                exit "$EX_OK" ;;
            *"not found"*|*"can't be edited"*|*MESSAGE_ID_INVALID*)
                note "the progress message is gone, sending a new one"
                [ "$DRY_RUN" -eq 1 ] || rm -f "$slot"
                deliver "$(build_message)" || finish_failure $?
                mid=$(json_get "$API_BODY" "result.message_id")
                if [ "$action" = "update" ] && [ "$DRY_RUN" -eq 0 ]; then
                    atomic_write "$slot" "$mid $start $expected $FORMAT" || true
                fi
                exit "$EX_OK" ;;
            *)
                die "$rc" "$(api_explain "$API_ERROR")" ;;
        esac
    else
        report_result "$CHATS_CURRENT"
    fi
    [ "$PIN" -eq 1 ] && pin_message "$CHATS_CURRENT" "$mid"
    case "$action" in
        done|finish|end)
            [ "$DRY_RUN" -eq 1 ] || rm -f "$slot"
            # An edit never rings the phone: the end is announced by a short
            # reply to the progress message, unless --edit-only. The reply
            # carries the pictures and formulas given with it.
            if [ "$EDIT_ONLY" -eq 0 ]; then
                PERCENT=""; CODE_TEXT=""; QUOTE_TEXT=""; ITEMS=(); FIELDS=(); BUTTONS=()
                REPLY_TO="$mid"
                deliver_message || warn "the final reply could not be sent"
            else
                send_attachments_reply "$mid"
            fi ;;
        *)  send_attachments_reply "$mid" ;;
    esac
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# ask: put a question on the phone and wait for the answer
# ---------------------------------------------------------------------------

ask_print() {
    # ask_print ANSWER KIND: the answer on stdout, alone, or as JSON.
    if [ "$JSON_OUT" -eq 1 ]; then
        printf '{"answer":"%s","kind":"%s"}\n' "$(printf '%s' "$1" | json_escape)" "$2"
    else
        printf '%s\n' "$1"
    fi
}

ask_no_answer() {
    # No answer before the deadline: the default with exit code 0, or code 7.
    if [ -n "$ASK_DEFAULT" ]; then
        note "no answer within the deadline, falling back to the default"
        ask_print "$ASK_DEFAULT" default
        exit "$EX_OK"
    fi
    printf '%s: no answer within %s\n' "$TG_PING_NAME" "$(human_duration "$1")" >&2
    exit "$EX_TIMEOUT"
}

random_tail() {
    # Six characters that make a nonce unique on this computer.
    printf '%s %s %s %s' "$$" "$(date +%s)" "$RANDOM" "$RANDOM" | short_hash | cut -c1-6
}

cmd_ask() {
    local wait_total="${ASK_TIMEOUT:-300}" nonce i=0 opt deadline mid rec chosen="" json_out
    local kind chat payload ref rmid record rc

    is_number "$wait_total" || wait_total=$(parse_duration "$wait_total") ||
        die "$EX_USAGE" "--wait takes seconds, or a duration such as 15m"
    [ -n "$BODY" ] || die "$EX_USAGE" "'ask' needs a question"
    # Switched off, nobody can answer: the default stands, else code 7.
    [ "$DISABLED" = "1" ] && ask_no_answer 0
    need_json_reader ask
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)
    if [ "$(chat_list | wc -l)" -gt 1 ]; then
        warn "'ask' talks to one chat, using $CHATS_CURRENT"
        CHATS="$CHATS_CURRENT"
    fi

    # The nonce starts with the mark of this computer, so that a press read
    # by another computer of the same bot is left for this one.
    nonce="$(machine_mark)$(random_tail)"
    BUTTONS=()
    BUTTON_COLS="${ASK_COLS:-2}"
    for opt in ${OPTIONS[@]+"${OPTIONS[@]}"}; do
        BUTTONS[${#BUTTONS[@]}]="cb$US$opt${US}a:$nonce:$i$US$(button_style "$opt")"
        i=$(( i + 1 ))
    done
    # Telegram's reply prompt beside the buttons: a typed answer is a reply.
    [ "$ASK_FREE_TEXT" -eq 1 ] && KEYBOARD_FORCE_REPLY=1
    [ -n "$LEVEL" ] || LEVEL="question"
    deadline=$(( $(date +%s) + wait_total ))
    json_out="$JSON_OUT"; JSON_OUT=0     # stdout carries the answer alone

    # The formulas and the pictures go first, as an album the question
    # answers, so that the buttons sit right under the question.
    attachments_prepare classic
    if [ ${#MP[@]} -gt 0 ]; then
        MEDIA_KEYBOARD=0
        attachment_captions ""
        if send_media_set; then
            if [ -z "$REPLY_TO" ] && is_number "$MEDIA_FIRST_MID" && [ "$MEDIA_FIRST_MID" != "0" ]; then
                REPLY_TO="$MEDIA_FIRST_MID"
            fi
        else
            warn "the pictures of the question could not be sent"
        fi
        MEDIA_KEYBOARD=1
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        deliver "$(build_message)" || true
        JSON_OUT="$json_out"
        [ -n "$ASK_DEFAULT" ] && ask_print "$ASK_DEFAULT" default
        exit "$EX_OK"
    fi

    waiter_register "$nonce" ask - "$ASK_FREE_TEXT" "$deadline"
    deliver "$(build_message)" || { rc=$?; JSON_OUT="$json_out"; finish_failure "$rc"; }
    JSON_OUT="$json_out"
    mid=$(json_get "$API_BODY" "result.message_id")
    waiter_set 3 "$mid"
    note "waiting up to $(human_duration "$wait_total") for an answer"

    rec=$(inbox_wait "$nonce" "$deadline")
    updates_check_fatal
    rm -f "$INBOX_WAITER"; INBOX_WAITER=""
    [ -n "$rec" ] || ask_no_answer "$wait_total"

    IFS="$US" read -r _ kind chat _ payload ref rmid _ <<EOF
$rec
EOF
    if [ "$kind" = "callback" ]; then
        i=${payload##*:}
        is_number "$i" && [ "$i" -lt "${#OPTIONS[@]}" ] && chosen="${OPTIONS[$i]}"
        ANSWER_KIND="button"
        # The phone stops spinning and says what was recorded.
        req_reset
        req_add callback_query_id "$ref"
        req_add text "Recorded: $chosen"
        api_call answerCallbackQuery >/dev/null 2>&1 || true
    else
        chosen=$(printf '%s' "$payload" | tr '\036' '\n')
        ANSWER_KIND="text"
        # A quiet acknowledgement under the typed answer.
        req_reset
        req_add chat_id "$chat"
        req_add message_id "$rmid"
        req_add reaction '[{"type":"emoji","emoji":"👍"}]'
        api_call setMessageReaction >/dev/null 2>&1 || true
    fi

    # The question shows its answer, and its buttons go.
    if is_number "$mid" && [ "$mid" != "0" ]; then
        BUTTONS=(); KEYBOARD_FORCE_REPLY=0
        if [ "$FORMAT" = "rich" ]; then
            record="$(build_message)<p>$(fmt_italic "answered: $chosen")</p>"
        else
            record="$(build_message)
$(fmt_italic "answered: $chosen")"
        fi
        edit_request "$CHATS_CURRENT" "$mid" "$record"
        api_call editMessageText >/dev/null 2>&1 || true
    fi

    ask_print "$chosen" "$ANSWER_KIND"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# poll: a native Telegram poll
# ---------------------------------------------------------------------------

cmd_poll() {
    local json="[" sep="" opt count=0 poll_id nonce deadline rec payload idx wait_total
    [ -n "$BODY" ] || die "$EX_USAGE" "'poll' needs a question"
    [ ${#OPTIONS[@]} -ge 2 ] || die "$EX_USAGE" "'poll' needs at least two --option values"
    wait_total="${POLL_WAIT:-0}"
    is_number "$wait_total" || wait_total=$(parse_duration "$wait_total") ||
        die "$EX_USAGE" "--wait takes seconds, or a duration such as 15m"
    # Checked before the poll goes out, not after.
    [ "$wait_total" -gt 0 ] && need_json_reader "poll --wait"
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)

    for opt in ${OPTIONS[@]+"${OPTIONS[@]}"}; do
        json="$json$sep{\"text\":\"$(printf '%s' "$opt" | json_escape)\"}"
        sep=","
        count=$(( count + 1 ))
    done
    json="$json]"

    req_reset
    req_add chat_id "$CHATS_CURRENT"
    req_add question "$BODY"
    req_add options "$json"
    req_add is_anonymous "${POLL_ANONYMOUS:-false}"
    [ "${POLL_MULTI:-0}" -eq 1 ] && req_add allows_multiple_answers "true"
    if [ -n "${POLL_CORRECT:-}" ]; then
        { is_number "$POLL_CORRECT" && [ "$POLL_CORRECT" -lt "$count" ]; } ||
            die "$EX_USAGE" "--correct takes the position of the right option, from 0 to $(( count - 1 ))"
        req_add type "quiz"
        req_add correct_option_ids "[$POLL_CORRECT]"
    fi
    req_silent
    req_add message_thread_id "$THREAD_ID"
    req_reply "$REPLY_TO"

    api_call sendPoll || die "$EX_API" "$(api_explain "$API_ERROR")"
    report_result "$CHATS_CURRENT"

    [ "$wait_total" -gt 0 ] || exit "$EX_OK"
    [ "$DRY_RUN" -eq 1 ] && exit "$EX_OK"

    poll_id=$(json_get "$API_BODY" "result.poll.id")
    nonce="$(machine_mark)$(random_tail)"
    deadline=$(( $(date +%s) + wait_total ))
    waiter_register "$nonce" poll "$poll_id" 0 "$deadline"
    rec=$(inbox_wait "$nonce" "$deadline")
    updates_check_fatal
    rm -f "$INBOX_WAITER"; INBOX_WAITER=""
    if [ -z "$rec" ]; then
        printf '%s: nobody answered the poll within %s\n' "$TG_PING_NAME" "$(human_duration "$wait_total")" >&2
        exit "$EX_TIMEOUT"
    fi
    IFS="$US" read -r _ _ _ _ payload _ <<EOF
$rec
EOF
    for idx in $(printf '%s' "$payload" | tr ',' ' '); do
        is_number "$idx" && [ "$idx" -lt "${#OPTIONS[@]}" ] && printf '%s\n' "${OPTIONS[$idx]}"
    done
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# receive: a file sent from the phone, saved here
# ---------------------------------------------------------------------------

api_download() {
    # api_download FILE_ID OUT: the file Telegram holds under that id, saved
    # as OUT. The token travels in the curl configuration, as in every
    # request. Returns 0, or an EX_* code with API_ERROR set.
    local path wd cfg rc http attempt=0 delay
    req_reset
    req_add file_id "$1"
    api_call getFile || return $?
    path=$(json_get "$API_BODY" "result.file_path")
    [ -n "$path" ] || { API_ERROR="Telegram gave no path for the file"; return "$EX_API"; }
    wd=$(workdir); cfg="$wd/curl.cfg"
    while :; do
        attempt=$(( attempt + 1 ))
        ( umask 077
          { printf 'url = "%s/file/bot%s/%s"\n' "$(printf '%s' "$API_ROOT" | curl_conf_escape)" "$TOKEN" \
                "$(printf '%s' "$path" | curl_conf_escape)"
            printf 'silent\nshow-error\nlocation\nfail\n'
            printf 'connect-timeout = %s\nspeed-limit = 1024\nspeed-time = 60\n' "$TIMEOUT"
            printf 'user-agent = "%s/%s"\n' "$TG_PING_NAME" "$TG_PING_VERSION"
            [ "$INSECURE" -eq 1 ] && printf 'insecure\n'
            printf 'output = "%s"\n' "$(printf '%s' "$2" | curl_conf_escape)"
            printf 'write-out = "%%{http_code}"\n'; } > "$cfg" )
        http=$(curl --config "$cfg" 2>"$wd/curl.err" 8>&-); rc=$?
        rm -f "$cfg"
        [ "$rc" -eq 0 ] && [ -s "$2" ] && return 0
        API_ERROR="the download failed: $(tr -d '\n' < "$wd/curl.err" | redact)"
        rm -f "$2"
        case "$http" in 4*|5*) return "$EX_API" ;; esac
        if [ "$attempt" -le "$RETRIES" ]; then
            delay=$(( attempt * attempt ))
            note "$API_ERROR, retrying in ${delay}s (attempt $attempt of $RETRIES)"
            sleep "$delay"; continue
        fi
        return "$EX_NET"
    done
}

receive_destination() {
    # receive_destination OUT CONTENT NAME MIME -> where a received file is
    # saved: inside OUT when it is a folder (or ends with a slash), else as
    # OUT itself. A document keeps its own name, a photo is called after its
    # kind and the time, and an existing file is never overwritten.
    local out="$1" content="$2" name="$3" mime="$4" dir ext base n candidate
    name=$(printf '%s' "$name" | tr -d '\000-\037' | tr '/\134' '__')
    case "$name" in .|..) name="" ;; esac
    if [ -z "$name" ]; then
        case "$mime" in
            image/png)       ext=png ;;
            image/jpeg)      ext=jpg ;;
            image/webp)      ext=webp ;;
            application/pdf) ext=pdf ;;
            text/plain)      ext=txt ;;
            audio/ogg)       ext=oga ;;
            audio/mpeg)      ext=mp3 ;;
            video/mp4)       ext=mp4 ;;
            *) case "$content" in
                   photo)                     ext=jpg ;;
                   voice)                     ext=oga ;;
                   audio)                     ext=mp3 ;;
                   video|animation|video_note) ext=mp4 ;;
                   *)                         ext=bin ;;
               esac ;;
        esac
        name="$content-$(date '+%Y%m%d-%H%M%S').$ext"
    fi
    case "$out" in
        */) dir="${out%/}"; [ -n "$dir" ] || dir="/" ;;
        *)  if [ -d "$out" ]; then dir="$out"; else dir=$(dirname "$out"); name=$(basename "$out"); fi ;;
    esac
    [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || die "$EX_USAGE" "cannot create the folder $dir"
    candidate="$dir/$name"; n=1
    while [ -e "$candidate" ]; do
        n=$(( n + 1 ))
        case "$name" in
            ?*.*) base=${name%.*}; ext=${name##*.}; candidate="$dir/$base-$n.$ext" ;;
            *)    candidate="$dir/$name-$n" ;;
        esac
    done
    printf '%s' "$candidate"
}

cmd_receive() {
    # cmd_receive [PROMPT]: a file sent from the phone (a photo, a document,
    # a voice note) saved here under its name, the path printed. With a
    # prompt, the question goes out first and the file that answers it is
    # taken; without one, the next file of the chat, or one sent in the last
    # ten minutes that nobody claimed.
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_receive; exit "$EX_OK"; }
    local wait_total="${ASK_TIMEOUT:-300}" nonce deadline mid="" rec rc out json_out dest full
    local chat payload rmid content fid fname mime fsize record
    body_from_remaining
    is_number "$wait_total" || wait_total=$(parse_duration "$wait_total") ||
        die "$EX_USAGE" "--wait takes seconds, or a duration such as 15m"
    case "$RECEIVE_KIND" in
        any|photo|document|video|animation|audio|voice|video_note) ;;
        *) die "$EX_USAGE" "--kind takes photo, document, video, animation, audio, voice, video_note or any" ;;
    esac
    out="${MATH_OUT:-.}"
    if [ "$DISABLED" = "1" ]; then
        printf '%s: nothing can be received while TG_PING_DISABLED is set\n' "$TG_PING_NAME" >&2
        exit "$EX_TIMEOUT"
    fi
    need_json_reader receive
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)
    if [ "$(chat_list | wc -l)" -gt 1 ]; then
        warn "'receive' listens to one chat, using $CHATS_CURRENT"
        CHATS="$CHATS_CURRENT"
    fi
    nonce="$(machine_mark)$(random_tail)"
    deadline=$(( $(date +%s) + wait_total ))
    json_out="$JSON_OUT"; JSON_OUT=0     # stdout carries the path alone

    if [ -n "$BODY" ]; then
        # The prompt opens the reply field, so that the file answers it.
        [ -n "$LEVEL" ] || LEVEL="question"
        BUTTONS=(); KEYBOARD_FORCE_REPLY=1
        if [ "$DRY_RUN" -eq 1 ]; then
            deliver "$(build_message)" || true
            exit "$EX_OK"
        fi
        waiter_register "$nonce" receive "$RECEIVE_KIND" 0 "$deadline"
        deliver "$(build_message)" || { rc=$?; JSON_OUT="$json_out"; finish_failure "$rc"; }
        mid=$(json_get "$API_BODY" "result.message_id")
        waiter_set 3 "$mid"
    else
        [ "$DRY_RUN" -eq 1 ] && { msg "dry run: nothing is received"; exit "$EX_OK"; }
        waiter_register "$nonce" receive "$RECEIVE_KIND" 0 "$deadline"
        waiter_set 3 open
    fi
    note "waiting up to $(human_duration "$wait_total") for a file"

    rec=$(inbox_wait "$nonce" "$deadline")
    updates_check_fatal
    rm -f "$INBOX_WAITER"; INBOX_WAITER=""
    if [ -z "$rec" ]; then
        printf '%s: no file arrived within %s\n' "$TG_PING_NAME" "$(human_duration "$wait_total")" >&2
        exit "$EX_TIMEOUT"
    fi
    IFS="$US" read -r _ _ chat _ payload _ rmid _ _ content _ _ fid fname mime fsize <<EOF
$rec
EOF
    [ -n "$fid" ] || die "$EX_API" "the message carries no file Telegram can hand over"
    dest=$(receive_destination "$out" "$content" "$fname" "$mime")
    if ! api_download "$fid" "$dest"; then
        rc=$?
        case "$API_ERROR" in
            *"too big"*|*"too large"*)
                die "$rc" "$API_ERROR
  Telegram lets a bot download files of up to 20 MB. Send a smaller file, or a link to it." ;;
        esac
        die "$rc" "$(api_explain "$API_ERROR")"
    fi
    full="$(cd "$(dirname "$dest")" && pwd)/$(basename "$dest")"
    note "received $content $(basename "$dest") ($(file_size "$dest") bytes)"

    # A quiet acknowledgement under the file, and the prompt records it.
    req_reset
    req_add chat_id "$chat"
    req_add message_id "$rmid"
    req_add reaction '[{"type":"emoji","emoji":"👍"}]'
    api_call setMessageReaction >/dev/null 2>&1 || true
    if is_number "$mid" && [ "$mid" != "0" ]; then
        BUTTONS=(); KEYBOARD_FORCE_REPLY=0
        if [ "$FORMAT" = "rich" ]; then
            record="$(build_message)<p>$(fmt_italic "received: $(basename "$dest")")</p>"
        else
            record="$(build_message)
$(fmt_italic "received: $(basename "$dest")")"
        fi
        edit_request "$CHATS_CURRENT" "$mid" "$record"
        api_call editMessageText >/dev/null 2>&1 || true
    fi

    JSON_OUT="$json_out"
    if [ "$JSON_OUT" -eq 1 ]; then
        printf '{"path":"%s","kind":"%s","name":"%s","caption":"%s","size":%s}\n' \
            "$(printf '%s' "$full" | json_escape)" "$content" \
            "$(printf '%s' "$(basename "$dest")" | json_escape)" \
            "$(printf '%s' "$payload" | tr '\036' '\n' | json_escape)" "${fsize:-0}"
    else
        printf '%s\n' "$full"
    fi
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

# Every option that takes a value, those of 'run' included. The command word
# search of main() and the missing value check rely on this list, and a test
# keeps it in step with the parser.
VALUE_OPTS=" -m --message --text -t --title -L --level --emoji --item --field --code --code-file
 --lang --language --quote --quote-file --percent --button --cols --option -o --prefix --format
 --reply-to --topic --thread --chat -c --token --token-file --profile -P --env-file --config --api
 --timeout --retries --cooldown --key --id --max-parts --caption --name --as --dpi --bg --background
 --out --preamble --sep --separator --wait --default --correct --each --math --file --pages
 --expected --photo --document --kind --label -l --tail --on --limit --every --stall --log --alert
 --agent "
VALUE_OPTS=$(printf '%s' "$VALUE_OPTS" | tr '\n' ' ')

# Every option without a value, those of 'run' included. The completions are
# made from the two lists, and a test checks that they hold every option of
# the parser.
FLAG_OPTS=" --ok --success --info --warn --warning --fail --error --start --debug --partial
 --blocked --collapse --meta --no-meta --no-machine --no-agent --plain --html --markdown --md --rich
 --no-fallback --silent -s --pin --protect --preview --no-preview --dry-run -n --json --verbose -v
 --quiet -q --tee --soft-fail --disabled --insecure --truncate --no-stdin --typst --latex --inline
 --display --remote --prose --native --no-header --free-text --strict --multi --anonymous
 --original --replace --attach --last --edit-only --notify-start --quiet-output --exit-zero
 --attach-log --attach-log-always --help -h --version "
FLAG_OPTS=$(printf '%s' "$FLAG_OPTS" | tr '\n' ' ')

# The commands with a line each, for the completions.
COMMAND_LIST="send:send a text message
code:send a snippet or a file as a code block
table:send CSV or TSV rows as an aligned table
math:typeset a formula and send it as a picture
photo:send pictures, several of them as an album
file:send documents
media:send up to ten files as one album
pdf:send pages of a PDF as pictures
rich:send a Markdown report as one rich message
run:run a command and report how it ended
progress:keep one message up to date
wait:report when a running process ends
ask:ask a question and wait for the answer
poll:send a poll
receive:wait for a file sent from the phone and save it
edit:correct a message already sent
delete:withdraw a message already sent
init:set up the bot and the chat
doctor:check the installation
chats:list the chats that wrote to the bot
config:show or change the settings
hook:print snippets for agents and scripts
cheatsheet:print a one-screen reference
completion:print the shell completion
version:print the version
help:help on a command"

# Commands that take arguments: written after options, they are still found.
HOISTABLE=" code table math photo file media pdf rich run progress ask poll receive edit delete wait "

OPTIONS=(); REMAINING=(); EACH=(); MATH_LIST=()
CAPTION=""; MEDIA_AS="auto"; MEDIA_NAME=""; MEDIA_ORIGINAL=0; MEDIA_REPLACE=0
TABLE_SEP=""; TABLE_HEADER=1
MATH_DPI="${TG_PING_MATH_DPI:-400}"; MATH_BG="${TG_PING_MATH_BG:-white}"
MATH_SYNTAX="latex"; MATH_INLINE=0; MATH_OUT=""; MATH_ENGINE=""
MATH_PROSE=0; MATH_NATIVE=0; MATH_FILE=""
MATH_PREAMBLE="${TG_PING_MATH_PREAMBLE:-}"
MATH_REMOTE=0; MATH_REMOTE_OK=$(bool01 "${TG_PING_MATH_REMOTE:-0}")
CHATS_CURRENT=""; PROGRESS_ID=""; PROGRESS_KEY=""; PROGRESS_EXPECTED=""
ASK_TIMEOUT=300; ASK_DEFAULT=""; ASK_FREE_TEXT=1; ASK_COLS=2; ANSWER_KIND=""
POLL_WAIT=0; POLL_MULTI=0; POLL_ANONYMOUS="false"; POLL_CORRECT=""
PDF_PAGES=""; PDF_ATTACH=0; PDF_DPI=""; USE_LAST=0; EDIT_ONLY=0; WAIT_LABEL=""; WAIT_LOG=""
RECEIVE_KIND="any"
NO_STDIN=$(bool01 "${TG_PING_NO_STDIN:-0}")
CAPTION_OVERFLOW=""; CAPTION_TEXT=""

read_file_or_die() {
    if [ "$1" = "-" ]; then cat
    else [ -r "$1" ] || die "$EX_USAGE" "cannot read $1"; cat "$1"
    fi
}

need_readable() {
    # The check runs in the main shell: inside the command substitution that
    # reads the file, a failure would only end the subshell.
    [ "$1" = "-" ] || [ -r "$1" ] || die "$EX_USAGE" "cannot read $1"
    [ "$1" = "-" ] || [ -f "$1" ] || [ -p "$1" ] || [ -c "$1" ] || die "$EX_USAGE" "$1 is not a file"
}

parse_common_args() {
    local label target
    REMAINING=()
    while [ $# -gt 0 ]; do
        case "$VALUE_OPTS" in
            *" $1 "*) [ $# -ge 2 ] || die "$EX_USAGE" "$1 needs a value" ;;
        esac
        case "$1" in
            -m|--message|--text)  BODY="$2"; shift 2 ;;
            -t|--title)           TITLE="$2"; shift 2 ;;
            -L|--level)           LEVEL="$2"; shift 2 ;;
            --emoji)              EMOJI="$2"; shift 2 ;;
            --info)               LEVEL="info"; shift ;;
            --ok|--success)       LEVEL="success"; shift ;;
            --warn|--warning)     LEVEL="warn"; shift ;;
            --fail|--error)       LEVEL="error"; shift ;;
            --start)              LEVEL="start"; shift ;;
            --debug)              LEVEL="debug"; SILENT=1; shift ;;
            --partial)            LEVEL="partial"; shift ;;
            --blocked)            LEVEL="blocked"; shift ;;
            --item)               ITEMS[${#ITEMS[@]}]="$2"; shift 2 ;;
            --field)              FIELDS[${#FIELDS[@]}]="$2"; shift 2 ;;
            --code)               if [ "$2" = "-" ]; then CODE_TEXT=$(cat); else CODE_TEXT="$2"; fi
                                  shift 2 ;;
            --code-file)          need_readable "$2"; CODE_TEXT=$(read_file_or_die "$2"); shift 2 ;;
            --lang|--language)    CODE_LANG="$2"; shift 2 ;;
            --quote)              if [ "$2" = "-" ]; then QUOTE_TEXT=$(cat); else QUOTE_TEXT="$2"; fi
                                  shift 2 ;;
            --quote-file)         need_readable "$2"; QUOTE_TEXT=$(read_file_or_die "$2"); shift 2 ;;
            --collapse)           COLLAPSE=1; shift ;;
            --percent)            PERCENT="$2"; shift 2 ;;
            --button)             case "$2" in *=*) ;; *) die "$EX_USAGE" "--button expects \"Label=https://address\"" ;; esac
                                  # The label ends where the address begins, so that a
                                  # label may hold an equals sign of its own.
                                  target="$2"; label=""
                                  while case "$target" in http://*|https://*|tg://*) false ;; *=*) true ;; *) false ;; esac; do
                                      label="${label:+$label=}${target%%=*}"; target=${target#*=}
                                  done
                                  [ -n "$label" ] && [ -n "$target" ] || die "$EX_USAGE" "--button expects \"Label=https://address\""
                                  BUTTONS[${#BUTTONS[@]}]="url$US$label$US$target"; shift 2 ;;
            --cols)               BUTTON_COLS="$2"; ASK_COLS="$2"; shift 2 ;;
            --option|-o)          OPTIONS[${#OPTIONS[@]}]="$2"; shift 2 ;;
            --meta)               META=1; shift ;;
            --no-meta)            META=0; PROJECT_MODE="off"; shift ;;
            --prefix)             PREFIX="$2"; shift 2 ;;
            --format)             FORMAT=$(lc "$2"); shift 2 ;;
            --plain)              FORMAT="plain"; shift ;;
            --html)               FORMAT="html"; shift ;;
            --markdown|--md)      FORMAT="markdown"; shift ;;
            --no-fallback)        FALLBACK=0; shift ;;
            --silent|-s)          SILENT=1; shift ;;
            --pin)                PIN=1; shift ;;
            --protect)            PROTECT=1; shift ;;
            --reply-to)           case "$2" in
                                      last) ;;
                                      *) is_number "$2" || die "$EX_USAGE" "--reply-to takes the number of a message, or 'last' for the last one this project sent" ;;
                                  esac
                                  REPLY_TO="$2"; shift 2 ;;
            --topic|--thread)     THREAD_ID="$2"; shift 2 ;;
            --preview)            NO_PREVIEW=0; shift ;;
            --no-preview)         NO_PREVIEW=1; shift ;;
            --chat|-c)            CHATS="${CHATS:+$CHATS,}$2"; shift 2 ;;
            --token)              TOKEN="$2"; shift 2 ;;
            --token-file)         need_readable "$2"; TOKEN=$(read_file_or_die "$2" | tr -d '\r\n')
                                  [ -n "$TOKEN" ] || die "$EX_CONFIG" "$2 holds no token"
                                  TOKEN_SRC="$2"; shift 2 ;;
            --profile|-P)         PROFILE="$2"; shift 2 ;;
            --env-file|--config)  shift 2 ;;     # read by preparse_config_flags
            --api)                API_ROOT="$2"; API_FROM_FLAG=1; shift 2 ;;
            --timeout)            TIMEOUT="$2"; shift 2 ;;
            --retries)            RETRIES="$2"; shift 2 ;;
            --insecure)           INSECURE=1; shift ;;
            --dry-run|-n)         DRY_RUN=1; shift ;;
            --json)               JSON_OUT=1; shift ;;
            -v|--verbose)         VERBOSE=1; shift ;;
            -q|--quiet)           QUIET=1; shift ;;
            --tee)                TEE=1; shift ;;
            --soft-fail)          SOFT_FAIL=1; shift ;;
            --disabled)           DISABLED=1; shift ;;
            --cooldown)           COOLDOWN="$2"; shift 2 ;;
            --key)                COOLDOWN_KEY="$2"; PROGRESS_KEY="$2"; shift 2 ;;
            --id)                 PROGRESS_ID="$2"; shift 2 ;;
            --truncate)           TRUNCATE=1; shift ;;
            --max-parts)          MAX_PARTS="$2"; shift 2 ;;
            --caption)            CAPTION="$2"; shift 2 ;;
            --name)               MEDIA_NAME="$2"; shift 2 ;;
            --as)                 MEDIA_AS=$(lc "$2"); shift 2 ;;
            --dpi)                MATH_DPI="$2"; PDF_DPI="$2"; shift 2 ;;
            --bg|--background)    MATH_BG=$(lc "$2"); shift 2 ;;
            --typst)              MATH_SYNTAX="typst"; shift ;;
            --latex)              MATH_SYNTAX="latex"; shift ;;
            --inline)             MATH_INLINE=1; shift ;;
            --display)            MATH_INLINE=0; shift ;;
            --remote)             MATH_REMOTE=1; MATH_REMOTE_OK=1; shift ;;
            --out)                MATH_OUT="$2"; shift 2 ;;
            --preamble)           MATH_PREAMBLE="$2"; shift 2 ;;
            --sep|--separator)    TABLE_SEP="$2"; shift 2 ;;
            --no-header)          TABLE_HEADER=0; shift ;;
            --wait)               ASK_TIMEOUT="$2"; POLL_WAIT="$2"; shift 2 ;;
            --default)            ASK_DEFAULT="$2"; shift 2 ;;
            --free-text)          ASK_FREE_TEXT=1; shift ;;
            --strict)             ASK_FREE_TEXT=0; shift ;;
            --multi)              POLL_MULTI=1; shift ;;
            --anonymous)          POLL_ANONYMOUS="true"; shift ;;
            --correct)            POLL_CORRECT="$2"; shift 2 ;;
            --rich)               FORMAT="rich"; shift ;;
            --no-machine)         SHOW_MACHINE=0; shift ;;
            --agent)              AGENT_MODE="$2"; resolve_agent; shift 2 ;;
            --no-agent)           AGENT_NAME=""; shift ;;
            --no-stdin)           NO_STDIN=1; shift ;;
            --each)               EACH[${#EACH[@]}]="$2"; shift 2 ;;
            --math)               MATH_LIST[${#MATH_LIST[@]}]="$2"; shift 2 ;;
            --photo)              ATTACH_PHOTOS[${#ATTACH_PHOTOS[@]}]="$2"; shift 2 ;;
            --document)           ATTACH_DOCS[${#ATTACH_DOCS[@]}]="$2"; shift 2 ;;
            --kind)               RECEIVE_KIND=$(lc "$2"); shift 2 ;;
            --prose)              MATH_PROSE=1; shift ;;
            --native)             MATH_NATIVE=1; shift ;;
            --file)               need_readable "$2"; MATH_FILE="$2"; shift 2 ;;
            --original)           MEDIA_ORIGINAL=1; shift ;;
            --replace)            MEDIA_REPLACE=1; shift ;;
            --pages)              PDF_PAGES="$2"; shift 2 ;;
            --attach)             PDF_ATTACH=1; shift ;;
            --expected)           PROGRESS_EXPECTED="$2"; shift 2 ;;
            --last)               USE_LAST=1; shift ;;
            --label|-l)           WAIT_LABEL="$2"; shift 2 ;;
            --log)                WAIT_LOG="$2"; shift 2 ;;
            --edit-only)          EDIT_ONLY=1; shift ;;
            -h|--help)            HELP_REQUESTED=1; shift ;;
            -)                    REMAINING[${#REMAINING[@]}]="-"; shift ;;     # stdin, read on request
            --version)            printf '%s %s\n' "$TG_PING_NAME" "$TG_PING_VERSION"; exit "$EX_OK" ;;
            --)                   shift; while [ $# -gt 0 ]; do REMAINING[${#REMAINING[@]}]="$1"; shift; done ;;
            -*)                   die "$EX_USAGE" "unknown option: $1
  Run '$TG_PING_NAME --help' for the full list." ;;
            *)                    REMAINING[${#REMAINING[@]}]="$1"; shift ;;
        esac
    done
    case "$FORMAT" in
        auto|plain|html|markdown|rich) ;;
        *) die "$EX_USAGE" "unknown --format '$FORMAT' (auto, plain, markdown, html or rich)" ;;
    esac
}

join_remaining() {
    local out="" arg
    for arg in ${REMAINING[@]+"${REMAINING[@]}"}; do
        if [ -z "$out" ]; then out="$arg"; else out="$out $arg"; fi
    done
    printf '%s' "$out"
}

body_from_remaining() {
    # The body is the text left on the command line, unless -m gave one, in
    # which case the words left over are not silently dropped.
    local rest
    if [ -n "$BODY" ]; then
        rest=$(join_remaining)
        [ -n "$rest" ] && [ "$rest" != "-" ] &&
            warn "the words '$rest' are not sent: the body was given with -m (give the text once, or put it after --)"
        return 0
    fi
    BODY=$(join_remaining)
}

# ---------------------------------------------------------------------------
# Commands: text, code, tables, media, mathematics
# ---------------------------------------------------------------------------

cmd_send() {
    parse_common_args "$@"
    [ "${HELP_REQUESTED:-0}" -eq 1 ] && { help_send; exit "$EX_OK"; }
    body_from_remaining
    read_stdin_if_piped
    require_credentials
    deliver_message || finish_failure $?
    exit "$EX_OK"
}

language_for_extension() {
    # Telegram highlights by language name, not by file extension.
    case "$(lc "$1")" in
        py|pyw)        printf 'python' ;;
        jl)            printf 'julia' ;;
        m)             printf 'matlab' ;;
        f|f90|f95|f03) printf 'fortran' ;;
        sh|bash|zsh)   printf 'bash' ;;
        js|mjs)        printf 'javascript' ;;
        ts)            printf 'typescript' ;;
        rs)            printf 'rust' ;;
        rb)            printf 'ruby' ;;
        c|h)           printf 'c' ;;
        cc|cpp|cxx|hpp) printf 'cpp' ;;
        yml|yaml)      printf 'yaml' ;;
        md|markdown)   printf 'markdown' ;;
        tex|sty|cls)   printf 'latex' ;;
        typ)           printf 'typst' ;;
        ini|cfg|conf)  printf 'ini' ;;
        patch)         printf 'diff' ;;
        txt|log|out|err|dat) printf '' ;;
        *)             printf '%s' "$(lc "$1")" ;;
    esac
}

cmd_code() {
    parse_common_args "$@"
    [ "${HELP_REQUESTED:-0}" -eq 1 ] && { help_code; exit "$EX_OK"; }
    local source_file content size
    source_file=$(join_remaining)
    if [ -n "$source_file" ] && [ "$source_file" != "-" ]; then
        [ -r "$source_file" ] || die "$EX_USAGE" "cannot read $source_file"
        content=$(cat "$source_file")
        if [ -z "$CODE_LANG" ]; then
            # Only a real extension names a language: a file called "Makefile"
            # must not end up tagged as "language-Makefile".
            case "$(basename "$source_file")" in
                ?*.?*) CODE_LANG=$(language_for_extension "${source_file##*.}") ;;
            esac
        fi
        [ -n "$TITLE" ] || TITLE=$(basename "$source_file")
    else
        content=$(cat)
    fi
    [ -n "$content" ] || die "$EX_USAGE" "no code to send"
    case "$MEDIA_AS" in
        auto|message|document) ;;
        *) die "$EX_USAGE" "'code' sends a snippet --as message or --as document, not '$MEDIA_AS'" ;;
    esac
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)

    size=$(visible_length "$content" plain)
    if [ "$MEDIA_AS" = "document" ] || { [ "$MEDIA_AS" = "auto" ] && [ "$size" -gt $(( TG_MAX_TEXT - 400 )) ]; }; then
        local wd tmp name chat
        wd=$(workdir)
        name="${MEDIA_NAME:-${source_file:-snippet.txt}}"
        name=$(basename "$name")
        tmp="$(mktemp -d "$wd/code.XXXXXX")/$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
        printf '%s\n' "$content" > "$tmp"
        note "the snippet is $size characters long, sending it as a document"
        BODY="${BODY:-$size characters}"
        caption_split "$(build_message)"
        for chat in $(chat_list); do
            CHATS_CURRENT="$chat"
            send_media_file sendDocument document "$tmp" "$CAPTION_TEXT" "$name" ||
                finish_failure $?
            send_overflow "$chat" "$(json_get "$API_BODY" "result.message_id")"
        done
        exit "$EX_OK"
    fi
    CODE_TEXT="$content"
    deliver "$(build_message)"
    exit $?
}

cmd_table() {
    parse_common_args "$@"
    [ "${HELP_REQUESTED:-0}" -eq 1 ] && { help_table; exit "$EX_OK"; }
    local source_file raw sep
    source_file=$(join_remaining)
    if [ -n "$source_file" ] && [ "$source_file" != "-" ]; then
        need_readable "$source_file"
        raw=$(read_file_or_die "$source_file")
    else
        raw=$(cat)
    fi
    sep="$TABLE_SEP"
    case "$(lc "$sep")" in
        '\t'|tab) sep="$TAB" ;;
        space|' ') sep=' ' ;;
    esac
    if [ -z "$sep" ]; then
        # Guess the separator from the first line.
        case "$(printf '%s' "$raw" | head -n1)" in
            *"$TAB"*) sep="$TAB" ;;
            *\;*)     sep=';' ;;
            *,*)      sep=',' ;;
            *)        sep="$TAB" ;;
        esac
    fi
    # A pattern, not 'printf | grep -q': grep stops reading at the first
    # match, and with pipefail the cut pipe would call a long table empty.
    if case "$raw" in *[![:space:]]*) true ;; *) false ;; esac; then
        if [ "$FORMAT" = "rich" ]; then
            RICH_EXTRA=$(printf '%s\n' "$raw" | align_table "$sep" "$TABLE_HEADER")
        else
            CODE_TEXT=$(printf '%s\n' "$raw" | align_table "$sep" "$TABLE_HEADER")
            CODE_LANG=""
        fi
    else
        # An empty table is news too: the title arrives with "no rows".
        BODY="${BODY:-no rows}"
    fi
    require_credentials
    deliver "$(build_message)"
    exit $?
}

media_kind() {
    # media_kind PATH DEFAULT -> how a file travels: photo, video, audio,
    # animation, document, or figure (a vector figure to turn into a picture).
    # --as decides when given; then 'file' (DEFAULT document) sends documents,
    # 'photo' sends pictures and routes animations and videos by extension,
    # and 'media' (auto) goes by the extension alone.
    local path="$1" default="$2" guess ext
    guess=$(guess_kind "$path")
    ext=$(lc "${path##*.}")
    case "$MEDIA_AS" in
        photo)
            case "$ext" in pdf|svg|eps|ps) printf 'figure' ;; *) printf 'photo' ;; esac
            return 0 ;;
        video|audio|animation|document) printf '%s' "$MEDIA_AS"; return 0 ;;
    esac
    case "$default" in
        document) printf 'document' ;;
        photo)
            case "$guess" in
                animation|video) printf '%s' "$guess" ;;
                *) case "$ext" in pdf|svg|eps|ps) printf 'figure' ;; *) printf 'photo' ;; esac ;;
            esac ;;
        *) printf '%s' "$guess" ;;
    esac
}

RASTER_PATH=""; RASTER_ERROR=""

rasterise_figure() {
    # rasterise_figure PATH: a picture of a vector figure (the first page of a
    # PDF, an SVG, an EPS) at 300 dpi on white, in RASTER_PATH; fails with
    # the reason in RASTER_ERROR. Must run in the main shell.
    local path="$1" ext d base out dpi=300
    [ -r "$path" ] || { RASTER_ERROR="cannot read $path"; return 1; }
    ext=$(lc "${path##*.}")
    d=$(mktemp -d "$(workdir)/figure.XXXXXX") || die "$EX_FAIL" "cannot create a temporary folder"
    base="$d/$(printf '%s' "$(basename "${path%.*}")" | tr -c 'A-Za-z0-9._-' '_')"
    out="$base.png"
    case "$ext" in
        pdf)
            if have pdftoppm; then
                pdftoppm -png -r "$dpi" -singlefile -f 1 -l 1 "$path" "$base" >"$d/log" 2>&1
            elif have pdftocairo; then
                pdftocairo -png -r "$dpi" -singlefile -f 1 -l 1 "$path" "$base" >"$d/log" 2>&1
            elif have_imagemagick; then
                imagemagick -density "$dpi" "${path}[0]" -background white -alpha remove "$out" >"$d/log" 2>&1
            fi ;;
        svg)
            if have inkscape; then
                inkscape "$path" --export-type=png --export-dpi="$dpi" --export-background=white \
                    --export-background-opacity=1 --export-filename="$out" >"$d/log" 2>&1
            elif have rsvg-convert; then
                rsvg-convert -d "$dpi" -p "$dpi" -b white -o "$out" "$path" >"$d/log" 2>&1
            elif have_imagemagick; then
                imagemagick -density "$dpi" "$path" -background white -alpha remove "$out" >"$d/log" 2>&1
            fi ;;
        *)
            if have_imagemagick; then
                imagemagick -density "$dpi" "$path" -background white -alpha remove "$out" >"$d/log" 2>&1
            elif have inkscape; then
                inkscape "$path" --export-type=png --export-dpi="$dpi" --export-background=white \
                    --export-background-opacity=1 --export-filename="$out" >"$d/log" 2>&1
            fi ;;
    esac
    if [ ! -s "$out" ]; then
        RASTER_ERROR="could not turn $path into a picture.
  Install poppler-utils for PDF figures, inkscape for SVG, or imagemagick, or send it with 'file'.
$(tail -n 5 "$d/log" 2>/dev/null)"
        return 1
    fi
    RASTER_PATH="$out"
}

slot_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_'; }

have_imagemagick() { have magick || have convert; }

imagemagick() {
    # ImageMagick 7 is 'magick'; version 6, still common, is 'convert'.
    if have magick; then magick "$@"; else convert "$@"; fi
}

project_key() {
    # The name of the current project: the top folder of its git repository,
    # else the working folder, with a short digest of the full path so that
    # two folders of the same name stay apart.
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
    [ -n "$root" ] || root="$PWD"
    printf '%s-%s' "$(basename "$root")" "$(printf '%s' "$root" | short_hash | cut -c1-6)"
}

pin_message() {
    # pin_message CHAT MESSAGE_ID
    [ -n "${2:-}" ] && [ "$2" != "0" ] || return 0
    local saved_body="$API_BODY"
    req_reset
    req_add chat_id "$1"
    req_add message_id "$2"
    req_silent
    api_call pinChatMessage || warn "could not pin the message: $API_ERROR"
    API_BODY="$saved_body"
    return 0
}

send_originals() {
    # send_originals CHAT REPLY_TO FILE...: the files themselves, as
    # documents answering the pictures made of them, since Telegram
    # recompresses photos.
    local chat="$1" reply="$2" f saved_reply="$REPLY_TO" saved_name="$MEDIA_NAME" saved_first
    shift 2
    [ $# -gt 0 ] || return 0
    # The files of the main call are kept for the next chat.
    local saved_mp=(${MP[@]+"${MP[@]}"}) saved_mk=(${MK[@]+"${MK[@]}"})
    local saved_cap=(${ITEM_CAPTION[@]+"${ITEM_CAPTION[@]}"})
    saved_first="$MEDIA_FIRST_MID"
    MP=(); MK=(); ITEM_CAPTION=()
    for f in "$@"; do
        prepare_upload "$f" document
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="document"; ITEM_CAPTION[${#ITEM_CAPTION[@]}]=""
    done
    CHATS_CURRENT="$chat"; REPLY_TO="$reply"; MEDIA_KEYBOARD=0; MEDIA_NAME=""
    send_media_set || warn "the original files could not be sent"
    REPLY_TO="$saved_reply"; MEDIA_KEYBOARD=1; MEDIA_NAME="$saved_name"
    MP=(${saved_mp[@]+"${saved_mp[@]}"}); MK=(${saved_mk[@]+"${saved_mk[@]}"})
    ITEM_CAPTION=(${saved_cap[@]+"${saved_cap[@]}"})
    MEDIA_FIRST_MID="$saved_first"
    return 0
}

replace_media() {
    # The live figure. The first call sends the file and remembers its
    # message, per chat and per --key (the project by default); later calls
    # replace the picture and the caption of that message.
    local slot mid rc json mode="" keyboard=""
    slot="$(state_dir)/figure.$(slot_name "$CHATS_CURRENT").$(slot_name "${PROGRESS_KEY:-$(project_key)}")"
    mid=$(cat "$slot" 2>/dev/null || true)
    if is_number "$mid" && [ "$mid" != "0" ]; then
        [ -n "${ITEM_CAPTION[0]}" ] && mode=$(parse_mode_value)
        json="{\"type\":\"${MK[0]}\",\"media\":\"attach://f0\""
        [ -n "${ITEM_CAPTION[0]}" ] && json="$json,\"caption\":\"$(printf '%s' "${ITEM_CAPTION[0]}" | json_escape)\""
        [ -n "$mode" ] && json="$json,\"parse_mode\":\"$mode\""
        json="$json}"
        keyboard=$(buttons_json) || keyboard=""
        req_reset
        req_add chat_id "$CHATS_CURRENT"
        req_add message_id "$mid"
        req_add media "$json"
        req_add reply_markup "$keyboard"
        req_file f0 "$(_safe_path "${MP[0]}")"
        api_call editMessageMedia; rc=$?
        if [ "$rc" -eq 0 ]; then
            report_result "$CHATS_CURRENT"
            return 0
        fi
        case "$API_ERROR" in
            *"not modified"*) return 0 ;;
            *"not found"*|*"can't be edited"*|*MESSAGE_ID_INVALID*)
                note "the earlier figure message is gone, sending a new one" ;;
            *)
                printf '%s: error: %s\n' "$TG_PING_NAME" "$(api_explain "$API_ERROR")" | redact >&2
                return "$rc" ;;
        esac
    fi
    send_media_set || return $?
    [ "$DRY_RUN" -eq 1 ] || atomic_write "$slot" "$MEDIA_FIRST_MID" || true
    return 0
}

cmd_media() {
    # cmd_media DEFAULT ARGS..., shared by photo (DEFAULT photo), file
    # (document) and media (auto: each file's extension decides).
    local default="$1"; shift
    parse_common_args "$@"
    if [ "$HELP_REQUESTED" -eq 1 ]; then
        case "$default" in photo) help_photo ;; *) help_file ;; esac
        exit "$EX_OK"
    fi
    local files=() originals=() arg kind chat i cap
    for arg in ${REMAINING[@]+"${REMAINING[@]}"}; do files[${#files[@]}]="$arg"; done
    [ ${#files[@]} -gt 0 ] || die "$EX_USAGE" "give at least one file to send"
    case "$MEDIA_AS" in
        auto|photo|video|audio|animation|document) ;;
        *) die "$EX_USAGE" "--as expects photo, video, audio, animation or document, not '$MEDIA_AS'" ;;
    esac
    [ "$MEDIA_REPLACE" -eq 1 ] && [ ${#files[@]} -gt 1 ] &&
        die "$EX_USAGE" "--replace keeps one picture up to date: give a single file"
    [ -n "$CAPTION" ] && BODY="${BODY:-$CAPTION}"
    require_credentials

    MP=(); MK=(); ITEM_CAPTION=()
    for arg in "${files[@]}"; do
        kind=$(media_kind "$arg" "$default")
        if [ "$kind" = "figure" ]; then
            rasterise_figure "$arg" || die "$EX_FAIL" "$RASTER_ERROR"
            originals[${#originals[@]}]="$arg"
            arg="$RASTER_PATH"; kind="photo"
        elif [ "$kind" = "photo" ] && ! is_remote_ref "$arg"; then
            originals[${#originals[@]}]="$arg"
        fi
        prepare_upload "$arg" "$kind"
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="$UPLOAD_KIND"
    done

    # The message goes with the first file; --each gives every file its own line.
    caption_split "$(build_message)"
    i=0
    while [ "$i" -lt "${#MP[@]}" ]; do
        cap=""
        [ "$i" -eq 0 ] && cap="$CAPTION_TEXT"
        if [ "$i" -lt "${#EACH[@]}" ]; then
            cap=$(cut_caption "${cap:+$cap
}$(format_text "${EACH[$i]}")")
        fi
        ITEM_CAPTION[i]="$cap"
        i=$(( i + 1 ))
    done

    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"
        if [ "$MEDIA_REPLACE" -eq 1 ]; then
            replace_media || finish_failure $?
            continue
        fi
        send_media_set || finish_failure $?
        send_overflow "$chat" "$MEDIA_FIRST_MID"
        if [ "$MEDIA_ORIGINAL" -eq 1 ] && [ ${#originals[@]} -gt 0 ]; then
            send_originals "$chat" "$MEDIA_FIRST_MID" "${originals[@]}"
        fi
        [ "$PIN" -eq 1 ] && pin_message "$chat" "$MEDIA_FIRST_MID"
    done
    exit "$EX_OK"
}

formula_image() {
    # formula_image PNG: the --math formulas of a message drawn into one
    # picture, one per line. Fails, quietly, when no renderer can draw them.
    local png="$1" src="" f sep
    if [ "$MATH_SYNTAX" = "typst" ]; then sep=' \ '; else sep=' \\ '; fi
    for f in ${MATH_LIST[@]+"${MATH_LIST[@]}"}; do src="${src:+$src$sep}$f"; done
    [ -n "$src" ] || return 1
    rm -f "$png"
    # shellcheck disable=SC2030  # a subshell on purpose: the caller's choices stay
    ( MATH_INLINE=0; MATH_PROSE=0; render_math "$src" "$png" ) >/dev/null 2>&1
    [ -s "$png" ]
}

# The pictures and documents that travel with a message (--photo, --document),
# and whether they have been prepared yet.
ATTACH_PHOTOS=(); ATTACH_DOCS=(); ATTACH_READY=0; ATTACH_LENIENT=0

attachments_prepare() {
    # attachments_prepare classic|rich: fill MP, MK and ITEM_CAPTION with
    # the files that travel with the message: the --math formulas drawn into
    # one picture (in the classic form, when a renderer can draw them), then
    # each --photo (a vector figure drawn first) and each --document. In the
    # rich mode the files are also listed for the rich message, which embeds
    # them. Runs once. With ATTACH_LENIENT=1 a file that cannot be read is
    # left out with a warning rather than stopping the command, since the
    # report of 'run' must go out whatever happened to the figure.
    local mode="${1:-classic}" png f kind i id t sep=""
    [ "$ATTACH_READY" -eq 1 ] && return 0
    ATTACH_READY=1
    MP=(); MK=(); ITEM_CAPTION=(); RICH_FILES=(); RICH_MEDIA_JSON=""
    if [ ${#MATH_LIST[@]} -gt 0 ] && [ "$FORMAT" != "rich" ]; then
        png="$(workdir)/formulas.png"
        if formula_image "$png"; then
            MP[${#MP[@]}]="$png"; MK[${#MK[@]}]="photo"; ITEM_CAPTION[${#ITEM_CAPTION[@]}]=""
        else
            warn "the formulas could not be drawn here, they travel as their LaTeX source"
            MATH_AS_CODE=1
        fi
    fi
    for f in ${ATTACH_PHOTOS[@]+"${ATTACH_PHOTOS[@]}"}; do
        if [ "$ATTACH_LENIENT" -eq 1 ] && ! is_remote_ref "$f" &&
           { [ ! -r "$f" ] || [ "$(file_size "$f")" -gt "$TG_UPLOAD_LIMIT" ]; }; then
            warn "the picture $f cannot be read or is too large, it is left out"; continue
        fi
        kind=$(media_kind "$f" photo)
        if [ "$kind" = "figure" ]; then
            if rasterise_figure "$f"; then f="$RASTER_PATH"; kind="photo"
            elif [ "$ATTACH_LENIENT" -eq 1 ]; then warn "$RASTER_ERROR"; continue
            else die "$EX_FAIL" "$RASTER_ERROR"
            fi
        fi
        prepare_upload "$f" "$kind"
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="$UPLOAD_KIND"; ITEM_CAPTION[${#ITEM_CAPTION[@]}]=""
    done
    for f in ${ATTACH_DOCS[@]+"${ATTACH_DOCS[@]}"}; do
        if [ "$ATTACH_LENIENT" -eq 1 ] && ! is_remote_ref "$f" &&
           { [ ! -r "$f" ] || [ "$(file_size "$f")" -gt "$TG_UPLOAD_LIMIT" ]; }; then
            warn "the document $f cannot be read or is too large, it is left out"; continue
        fi
        prepare_upload "$f" document
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="document"; ITEM_CAPTION[${#ITEM_CAPTION[@]}]=""
    done
    [ "$mode" = "rich" ] || return 0
    i=0
    while [ "$i" -lt "${#MP[@]}" ]; do
        id="a$(( i + 1 ))"; t="${MK[$i]}"
        RICH_MEDIA_JSON="$RICH_MEDIA_JSON$sep{\"id\":\"$id\",\"media\":{\"type\":\"$t\",\"media\":\"attach://$id\"}}"
        sep=","
        RICH_FILES[${#RICH_FILES[@]}]="$id=$(_safe_path "${MP[$i]}")"
        i=$(( i + 1 ))
    done
    [ -n "$RICH_MEDIA_JSON" ] && RICH_MEDIA_JSON="[$RICH_MEDIA_JSON]"
    return 0
}

attachment_captions() {
    # attachment_captions FIRST: the caption of each file of MP: FIRST for
    # the first one, and the --each lines, one per file.
    local i=0 cap
    while [ "$i" -lt "${#MP[@]}" ]; do
        cap=""
        [ "$i" -eq 0 ] && cap="$1"
        if [ "$i" -lt "${#EACH[@]}" ]; then
            cap=$(cut_caption "${cap:+$cap
}$(format_text "${EACH[$i]}")")
        fi
        ITEM_CAPTION[i]="$cap"
        i=$(( i + 1 ))
    done
}

send_with_attachments() {
    # The message with its formulas, pictures and documents in the classic
    # form: the files carry the text as their caption when it fits and the
    # buttons can ride along (an album takes none), and otherwise the text
    # goes first and the files follow as its reply.
    local text chat mid saved_chats saved_reply rc
    attachments_prepare classic
    if [ ${#MP[@]} -eq 0 ]; then
        deliver "$(build_message)"
        return $?
    fi
    text=$(build_message)
    caption_split "$text"
    if [ -n "$CAPTION_OVERFLOW" ] || { [ ${#BUTTONS[@]} -gt 0 ] && [ ${#MP[@]} -gt 1 ]; }; then
        for chat in $(chat_list); do
            saved_chats="$CHATS"; CHATS="$chat"
            deliver "$text"; rc=$?
            CHATS="$saved_chats"
            [ "$rc" -eq 0 ] || return "$rc"
            [ "$DELIVER_SUPPRESSED" -eq 1 ] && return 0
            mid=$(json_get "$API_BODY" "result.message_id")
            CHATS_CURRENT="$chat"; saved_reply="$REPLY_TO"; REPLY_TO="$mid"; MEDIA_KEYBOARD=0
            attachment_captions ""
            send_media_set || warn "the attachments could not be sent"
            REPLY_TO="$saved_reply"; MEDIA_KEYBOARD=1
        done
        return 0
    fi
    if ! cooldown_allows "$text"; then
        DELIVER_SUPPRESSED=1
        return 0
    fi
    [ "$TEE" -eq 1 ] && printf '%s\n' "$(printf '%s' "$text" | markup_strip)" >&2
    attachment_captions "$CAPTION_TEXT"
    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"
        send_media_set || return $?
        [ "$PIN" -eq 1 ] && pin_message "$chat" "$MEDIA_FIRST_MID"
    done
    cooldown_record "$text"
    return 0
}

send_attachments_reply() {
    # send_attachments_reply MESSAGE_ID: the formulas, pictures and documents
    # of a message that cannot carry them itself (a progress message, which
    # is edited later), sent as its reply. In the rich format the formulas
    # are typeset in the message and only the files follow.
    local saved_reply="$REPLY_TO"
    attachments_prepare classic
    [ ${#MP[@]} -gt 0 ] || return 0
    REPLY_TO="$1"; MEDIA_KEYBOARD=0
    attachment_captions ""
    send_media_set >/dev/null || warn "the attachments could not be sent"
    REPLY_TO="$saved_reply"; MEDIA_KEYBOARD=1
    return 0
}

deliver_message() {
    # The composed message to every chat, formulas and attachments included:
    # a rich message embeds them, the classic form carries them as captions
    # or sends them as a reply.
    if [ "$FORMAT" = "rich" ]; then
        attachments_prepare rich
        deliver "$(build_message)"
        return $?
    fi
    send_with_attachments
}

cmd_math() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_math; exit "$EX_OK"; }
    local formula wd png chat caption
    if [ -n "$MATH_FILE" ]; then
        formula=$(read_file_or_die "$MATH_FILE")
    else
        formula=$(join_remaining)
        if { [ -z "$formula" ] || [ "$formula" = "-" ]; } && [ ! -t 0 ]; then formula=$(cat); fi
    fi
    [ -n "$formula" ] && [ "$formula" != "-" ] || die "$EX_USAGE" "'math' needs a formula, for example:
  $TG_PING_NAME math '\\int_0^1 x^2 \\, dx = \\tfrac{1}{3}'"
    [ -n "$BODY" ] || BODY="$CAPTION"

    if [ "$MATH_NATIVE" -eq 1 ]; then
        # Typeset by Telegram itself, inside a rich message.
        [ "$MATH_SYNTAX" = "typst" ] && die "$EX_USAGE" "Telegram typesets LaTeX: --native does not take typst"
        FORMAT="rich"
        # shellcheck disable=SC2031  # this is the caller's own MATH_PROSE
        if [ "$MATH_PROSE" -eq 1 ]; then
            BODY="${BODY:+$BODY

}$formula"
        else
            MATH_LIST=("$formula")
        fi
        require_credentials
        deliver "$(build_message)" || finish_failure $?
        exit "$EX_OK"
    fi

    wd=$(workdir); png="$wd/math.png"
    render_math "$formula" "$png" || die "$EX_FAIL" "could not render the formula"
    [ -s "$png" ] || die "$EX_FAIL" "the renderer produced an empty image"
    note "rendered with $MATH_ENGINE at ${MATH_DPI} dpi"

    if [ -n "$MATH_OUT" ]; then
        cp "$png" "$MATH_OUT" || die "$EX_FAIL" "cannot write $MATH_OUT"
        msg "image written to $MATH_OUT"
    fi

    require_credentials
    caption_split "$(build_message)"
    caption="$CAPTION_TEXT"
    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"
        if [ "$MEDIA_AS" = "document" ]; then
            send_media_file sendDocument document "$png" "$caption" "${MEDIA_NAME:-formula.png}" || finish_failure $?
        else
            send_media_file sendPhoto photo "$png" "$caption" "" || finish_failure $?
        fi
        send_overflow "$chat" "$(json_get "$API_BODY" "result.message_id")"
    done
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# edit, delete: correct or withdraw a message; wait: a process ends
# ---------------------------------------------------------------------------

message_target() {
    # message_target -> the message to correct: its number, the first word
    # left on the command line, or with --last the last message sent from
    # this project. Sets TARGET_MID and drops the number from REMAINING.
    TARGET_MID=""
    if [ "$USE_LAST" -eq 1 ]; then
        TARGET_MID=$(cat "$(last_file "$CHATS_CURRENT")" 2>/dev/null || true)
        is_number "$TARGET_MID" || die "$EX_USAGE" "no message of this project is remembered in chat $CHATS_CURRENT"
        return 0
    fi
    TARGET_MID="${REMAINING[0]:-}"
    is_number "$TARGET_MID" || die "$EX_USAGE" "give the number of the message (from --json or -v), or --last"
    REMAINING=(${REMAINING[@]+"${REMAINING[@]:1}"})
}

cmd_edit() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_edit; exit "$EX_OK"; }
    local rc
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)
    message_target
    body_from_remaining
    read_stdin_if_piped
    edit_request "$CHATS_CURRENT" "$TARGET_MID" "$(build_message)"
    req_add reply_markup "$(buttons_json || true)"
    api_call editMessageText; rc=$?
    if [ "$rc" -ne 0 ]; then
        case "$API_ERROR" in
            *"not modified"*) note "the message already carries this text" ;;
            *) die "$rc" "$(api_explain "$API_ERROR")" ;;
        esac
    fi
    report_result "$CHATS_CURRENT"
    exit "$EX_OK"
}

cmd_delete() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_delete; exit "$EX_OK"; }
    require_credentials
    CHATS_CURRENT=$(chat_list | head -n1)
    message_target
    req_reset
    req_add chat_id "$CHATS_CURRENT"
    req_add message_id "$TARGET_MID"
    api_call deleteMessage || die "$EX_API" "$(api_explain "$API_ERROR")"
    if [ "$DRY_RUN" -eq 0 ] && [ "$(cat "$(last_file "$CHATS_CURRENT")" 2>/dev/null)" = "$TARGET_MID" ]; then
        rm -f "$(last_file "$CHATS_CURRENT")"
    fi
    note "message $TARGET_MID deleted"
    exit "$EX_OK"
}

process_alive() {
    # True while the process runs (a zombie, ended but not collected, counts
    # as ended).
    if [ -d /proc ] && [ -r /proc/self/stat ]; then
        [ -d "/proc/$1" ] || return 1
        case "$(awk_run '{ print $3 }' "/proc/$1/stat" 2>/dev/null)" in Z|X) return 1 ;; esac
        return 0
    fi
    kill -0 "$1" 2>/dev/null || ps -p "$1" >/dev/null 2>&1
}

process_command() {
    # The command line of a process, shortened.
    if [ -r "/proc/$1/cmdline" ]; then
        tr '\0' ' ' < "/proc/$1/cmdline"; echo
    else
        ps -o args= -p "$1" 2>/dev/null
    fi | utf8_clean 80 | sed -e 's/[[:space:]]*$//'
}

process_age() {
    # process_age PID -> seconds since the process started, 0 when unknown
    # (the ps of Linux knows 'etimes'; that of BSD and macOS gives 'etime'
    # as [[dd-]hh:]mm:ss).
    local t d=0 a b c
    t=$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')
    if is_number "$t"; then printf '%s' "$t"; return 0; fi
    t=$(ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')
    case "$t" in *-*) d=${t%%-*}; t=${t#*-} ;; esac
    IFS=: read -r a b c <<EOF
$t
EOF
    if [ -z "$c" ]; then c=$b; b=$a; a=0; fi
    if is_number "$d" && is_number "$a" && is_number "$b" && is_number "$c"; then
        printf '%s' $(( 10#$d * 86400 + 10#$a * 3600 + 10#$b * 60 + 10#$c ))
    else
        printf '0'
    fi
}

cmd_wait() {
    # cmd_wait PID: a message when a process started earlier, without
    # tg-ping, comes to its end.
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_wait; exit "$EX_OK"; }
    local pid="${REMAINING[0]:-}" label age start now tick="${TG_PING_WAIT_TICK:-5}"
    is_number "$pid" || die "$EX_USAGE" "'wait' takes the number of a running process, for example: $TG_PING_NAME wait 12345"
    process_alive "$pid" || die "$EX_USAGE" "no process $pid is running"
    label="$WAIT_LABEL"
    [ -n "$label" ] || label=$(process_command "$pid")
    [ -n "$label" ] || label="process $pid"
    age=$(process_age "$pid")
    require_credentials
    start=$(date +%s)
    note "waiting for process $pid ($label)"
    while process_alive "$pid"; do sleep "$tick"; done
    now=$(date +%s)
    LEVEL="${LEVEL:-info}"
    TITLE="${TITLE:-$label has ended}"
    BODY="${BODY:-it ran for about $(human_duration $(( age + now - start ))); its exit code cannot be seen from outside}"
    if [ -n "$WAIT_LOG" ]; then
        CODE_TEXT=$(log_tail "$RUN_TAIL" "$WAIT_LOG"); CODE_LANG=""
    fi
    ATTACH_LENIENT=1
    deliver_message || finish_failure $?
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# rich: a Markdown report as one message; pdf: pages as pictures
# ---------------------------------------------------------------------------

RICH_REPORT_MD=""; TARGET_MID=""

rich_report_fallback() {
    # The classic form of a Markdown report: its text, then its figures as
    # an album answering it.
    local saved_reply="$REPLY_TO" mid chat
    BODY="$RICH_REPORT_MD"
    deliver "$(build_message)" || return $?
    [ ${#MP[@]} -gt 0 ] || return 0
    mid=$(json_get "$API_BODY" "result.message_id")
    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"; REPLY_TO="$mid"; MEDIA_KEYBOARD=0
        send_media_set || warn "the figures could not be sent"
    done
    REPLY_TO="$saved_reply"; MEDIA_KEYBOARD=1
    return 0
}

cmd_rich() {
    # cmd_rich FILE.md: a report written in Markdown, sent as one rich message
    # (Telegram reads its tables, lists and $...$ formulas); local figures
    # are uploaded with it, vector figures turned into pictures first.
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_rich; exit "$EX_OK"; }
    local file dir md rewritten sidecar id path kind media="" sep="" head emoji tag t n
    file="${REMAINING[0]:-}"
    [ -n "$file" ] || die "$EX_USAGE" "'rich' needs a Markdown file, for example: $TG_PING_NAME rich report.md"
    if [ "$file" = "-" ]; then
        md=$(cat); dir="$PWD"
    else
        [ -f "$file" ] || die "$EX_USAGE" "no such file: $file"
        need_readable "$file"
        md=$(cat "$file"); dir=$(cd "$(dirname "$file")" && pwd)
    fi
    [ -n "$md" ] || die "$EX_USAGE" "$file is empty"
    require_credentials

    # Local figures become tg://photo?id=mN references, listed aside.
    sidecar="$(workdir)/rich.media"
    : > "$sidecar"
    rewritten=$(printf '%s\n' "$md" | awk_run -v SIDE="$sidecar" '
        BEGIN { n = 0; fence = 0 }
        /^[ \t]*```/ { fence = !fence; print; next }
        fence { print; next }
        {
            line = $0; out = ""
            while (match(line, /!\[[^]]*\]\([^)]*\)/)) {
                pre = substr(line, 1, RSTART - 1); m = substr(line, RSTART, RLENGTH)
                line = substr(line, RSTART + RLENGTH)
                p = index(m, "](")
                alt = substr(m, 1, p - 1); target = substr(m, p + 2, length(m) - p - 2)
                title = ""
                if (match(target, / +"[^"]*"$/)) { title = substr(target, RSTART); target = substr(target, 1, RSTART - 1) }
                if (target ~ /^(https?|tg):/) { out = out pre m; continue }
                ext = tolower(target); sub(/.*\./, "", ext)
                kind = (ext ~ /^(mp4|mov|m4v|webm|mkv|gif)$/) ? "video" : "photo"
                n++
                printf "m%d\t%s\t%s\n", n, target, (ext == "gif" ? "animation" : kind) >> SIDE
                out = out pre alt "](tg://" kind "?id=m" n title ")"
            }
            print out line
        }')

    MP=(); MK=(); ITEM_CAPTION=(); RICH_FILES=()
    n=0
    while IFS="$TAB" read -r id path kind; do
        [ -n "$id" ] || continue
        case "$path" in /*) ;; *) path="$dir/$path" ;; esac
        [ -f "$path" ] || die "$EX_USAGE" "the report shows $path, which does not exist"
        case "$(lc "${path##*.}")" in
            pdf|svg|eps|ps) rasterise_figure "$path" || die "$EX_FAIL" "$RASTER_ERROR"; path="$RASTER_PATH" ;;
        esac
        prepare_upload "$path" "$kind"
        t="$UPLOAD_KIND"
        media="$media$sep{\"id\":\"$id\",\"media\":{\"type\":\"$t\",\"media\":\"attach://$id\"}}"
        sep=","
        RICH_FILES[${#RICH_FILES[@]}]="$id=$(_safe_path "$UPLOAD_PATH")"
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="$t"; ITEM_CAPTION[${#ITEM_CAPTION[@]}]=""
        n=$(( n + 1 ))
    done < "$sidecar"
    [ "$n" -le 50 ] || die "$EX_USAGE" "a rich message holds at most 50 figures, the report has $n"
    [ -n "$media" ] && RICH_MEDIA_JSON="[$media]"

    # The first line names the machine, the agent and the title, as every
    # message does.
    emoji="$EMOJI"; [ -n "$emoji" ] || emoji=$(level_emoji "$LEVEL")
    tag=$(speaker_tag)
    head="${emoji:+$emoji }${tag:+$tag · }${TITLE:+**$TITLE**}"
    head="${head% · }"; head="${head% }"
    [ -n "$head" ] && rewritten="$head

$rewritten"
    # The last line names the project, as every message does when asked.
    if project_shown; then
        rewritten="$rewritten

📂 $(project_label)"
        md="$md

📂 $(project_label)"
    fi
    RICH_REPORT_MD="$md"
    FORMAT="rich"; RICH_KIND="markdown"
    deliver "$rewritten" || finish_failure $?
    exit "$EX_OK"
}

pdf_pages() {
    # pdf_pages SPEC COUNT -> the page numbers of "1,3-5" or "all", one per
    # line; COUNT is 0 when unknown.
    local spec="$1" count="$2" part a b
    [ "$spec" = "all" ] && { [ "$count" -gt 0 ] || return 1; spec="1-$count"; }
    for part in $(printf '%s' "$spec" | tr ',' ' '); do
        case "$part" in
            *-*) a=${part%-*}; b=${part#*-} ;;
            *)   a=$part; b=$part ;;
        esac
        { is_number "$a" && is_number "$b" && [ "$a" -ge 1 ] && [ "$b" -ge "$a" ]; } || return 1
        [ "$count" -gt 0 ] && [ "$b" -gt "$count" ] && return 1
        while [ "$a" -le "$b" ]; do printf '%s\n' "$a"; a=$(( a + 1 )); done
    done
}

pages_phrase() {
    # pages_phrase PAGE... -> "page 3", or "pages 3, 7 to 9", in words.
    local out="" start="" prev="" p
    [ $# -eq 1 ] && { printf 'page %s' "$1"; return 0; }
    for p in "$@"; do
        if [ -z "$start" ]; then start=$p; prev=$p; continue; fi
        if [ "$p" -eq $(( prev + 1 )) ]; then prev=$p; continue; fi
        out="$out, $start"; [ "$prev" != "$start" ] && out="$out to $prev"
        start=$p; prev=$p
    done
    out="$out, $start"; [ "$prev" != "$start" ] && out="$out to $prev"
    printf 'pages %s' "${out#, }"
}

render_pdf_page() {
    # render_pdf_page FILE PAGE DPI OUT.png
    local base="${4%.png}"
    if have pdftoppm; then
        pdftoppm -png -r "$3" -f "$2" -l "$2" -singlefile "$1" "$base" >/dev/null 2>&1
    elif have pdftocairo; then
        pdftocairo -png -r "$3" -f "$2" -l "$2" -singlefile "$1" "$base" >/dev/null 2>&1
    else
        imagemagick -density "$3" "$1[$(( $2 - 1 ))]" -background white -alpha remove "$4" >/dev/null 2>&1
    fi
    [ -s "$4" ]
}

cmd_pdf() {
    # cmd_pdf FILE.pdf: chosen pages as pictures, as albums, the page count in
    # the caption, and with --attach the PDF itself as a reply.
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_pdf; exit "$EX_OK"; }
    local file count=0 pages d p png chat i cap phrase
    file="${REMAINING[0]:-}"
    [ -n "$file" ] || die "$EX_USAGE" "'pdf' needs a PDF file, for example: $TG_PING_NAME pdf paper.pdf --pages 1,3"
    [ -f "$file" ] || die "$EX_USAGE" "no such file: $file"
    need_readable "$file"
    { have pdftoppm || have pdftocairo || have_imagemagick; } ||
        die "$EX_CONFIG" "turning PDF pages into pictures needs pdftoppm (sudo apt install -y poppler-utils)"
    if have pdfinfo; then
        count=$(pdfinfo "$file" 2>/dev/null | awk_run '/^Pages:/ { print $2 }')
        is_number "$count" || count=0
    fi
    pages=$(pdf_pages "${PDF_PAGES:-1}" "$count") ||
        die "$EX_USAGE" "--pages takes page numbers and ranges such as 1,3-5, or all, within the $count pages of $file"
    require_credentials

    d=$(mktemp -d "$(workdir)/pages.XXXXXX") || die "$EX_FAIL" "cannot create a temporary folder"
    MP=(); MK=(); ITEM_CAPTION=()
    for p in $pages; do
        png="$d/page-$p.png"
        render_pdf_page "$file" "$p" "${PDF_DPI:-200}" "$png" || die "$EX_FAIL" "page $p of $file could not be drawn"
        prepare_upload "$png" photo
        MP[${#MP[@]}]="$UPLOAD_PATH"; MK[${#MK[@]}]="$UPLOAD_KIND"
    done
    # shellcheck disable=SC2086  # the page numbers are words on purpose
    phrase=$(pages_phrase $pages)
    [ "$count" -gt 0 ] && phrase="$phrase of $count"
    [ -n "$BODY" ] || BODY="$CAPTION"
    BODY="${BODY:+$BODY
}_${phrase}_"
    caption_split "$(build_message)"
    i=0
    for p in $pages; do
        cap=""
        [ "$i" -eq 0 ] && cap="$CAPTION_TEXT"
        if [ "$i" -lt "${#EACH[@]}" ]; then
            cap=$(cut_caption "${cap:+$cap
}$(format_text "${EACH[$i]}")")
        elif [ "$i" -gt 0 ]; then
            cap=$(fmt_italic "page $p")
        fi
        ITEM_CAPTION[i]="$cap"
        i=$(( i + 1 ))
    done

    for chat in $(chat_list); do
        CHATS_CURRENT="$chat"
        send_media_set || finish_failure $?
        send_overflow "$chat" "$MEDIA_FIRST_MID"
        [ "$PDF_ATTACH" -eq 1 ] && send_originals "$chat" "$MEDIA_FIRST_MID" "$file"
    done
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Setup and diagnostics
# ---------------------------------------------------------------------------

cmd_init() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_init; exit "$EX_OK"; }
    local dir file token chat me name n=0 uid kind cid from payload ref mid replyto mdate content
    local ctype clabel ids="" labels="" choice machine guess

    dir=$(config_dir); file="$dir/${PROFILE}.env"
    printf '%s\n' "$TG_PING_NAME setup" "" \
        "This writes the settings of profile '$PROFILE' to $file." \
        "Nothing is sent anywhere until the credentials have been checked." ""
    [ "$DRY_RUN" -eq 1 ] && printf '%s\n' "Dry run: nothing will be written." ""

    token="$TOKEN"
    if [ -z "$token" ]; then
        if [ ! -t 0 ]; then
            die "$EX_USAGE" "init needs a terminal, or pass --token-file FILE and --chat ID"
        fi
        printf '%s\n' "Open Telegram, talk to @BotFather, send /newbot, and copy the token." \
                      "It looks like 123456789:AAExampleTokenWithLettersAndDigits."
        printf 'Bot token: '
        # Ctrl-C at the hidden prompt must not leave the terminal without echo.
        trap 'stty echo 2>/dev/null; printf "\n"; exit 130' INT
        stty -echo 2>/dev/null || true
        read -r token || token=""
        stty echo 2>/dev/null || true
        trap 'exit 130' INT
        printf '\n'
    fi
    [ -n "$token" ] || die "$EX_USAGE" "no token given"
    TOKEN="$token"

    req_reset
    api_call getMe || die "$EX_CONFIG" "the token was refused: $(api_explain "$API_ERROR")"
    name=$(json_get "$API_BODY" "result.username")
    me=$(json_get "$API_BODY" "result.first_name")
    if [ -n "$name" ]; then printf 'Bot verified: %s (@%s)\n\n' "$me" "$name"
    else printf 'Bot verified.\n\n'; fi

    chat="$CHATS"
    if [ -z "$chat" ]; then
        need_json_reader init
        printf '%s\n' "Now open Telegram, find @$name, and send it any message (/start will do)." \
                      "If you want the alerts in a group, add the bot there and post a message."
        printf 'Press Enter once you have done that: '
        read -r _ || true
        # shellcheck disable=SC2034  # the fields are read to keep them aligned
        while IFS="$US" read -r uid kind cid from payload ref mid replyto mdate content ctype clabel; do
            [ -n "$uid" ] || continue
            [ "$kind" = "message" ] || continue
            [ -n "$cid" ] || continue
            case " $ids " in *" $cid "*) continue ;; esac
            n=$(( n + 1 ))
            ids="$ids $cid"
            labels="$labels
$n) $cid  $ctype  $clabel"
        done <<EOF
$(updates_snapshot)
EOF
        updates_check_fatal
        if [ "$n" -eq 0 ]; then
            die "$EX_CONFIG" "no message reached the bot.
  Send a message to @$name and run '$TG_PING_NAME init' again.
  In a group, remember that privacy mode hides ordinary messages from bots:
  either address the bot directly, or disable privacy mode through @BotFather."
        fi
        printf '%s\n' "Chats that have written to the bot:$labels" ""
        if [ "$n" -eq 1 ]; then
            chat=$(printf '%s' "$ids" | tr ' ' '\n' | grep -v '^$' | head -n1)
            printf 'Using chat %s.\n' "$chat"
        else
            printf 'Which one should receive the notifications? [1] '
            read -r choice || choice=1
            is_number "$choice" || choice=1
            chat=$(printf '%s' "$ids" | tr ' ' '\n' | grep -v '^$' | sed -n "${choice}p")
        fi
    fi
    [ -n "$chat" ] || die "$EX_CONFIG" "no chat id chosen"
    CHATS="$chat"

    # The name shown on every message, so that several machines reporting to
    # the same chat can be told apart.
    machine="$MACHINE"
    if [ -z "$machine" ] && [ -t 0 ]; then
        guess=$(detect_machine_kind)
        printf 'What should this machine be called in your messages? [%s] ' "$guess"
        read -r machine || machine=""
        [ -n "$machine" ] || machine="$guess"
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        msg "dry run: the token and chat $CHATS${machine:+, and the machine name \"$machine\",} would be written to $file"
        exit "$EX_OK"
    fi
    mkdir -p "$dir" || die "$EX_FAIL" "cannot create $dir"
    chmod 700 "$dir" 2>/dev/null || true
    if [ -f "$file" ]; then
        cp "$file" "$file.bak" && chmod 600 "$file.bak" 2>/dev/null &&
            msg "previous settings kept as $file.bak"
    fi
    # Only these lines change; every other setting of the file stays.
    settings_set "$file" TG_PING_TOKEN "$TOKEN" || die "$EX_FAIL" "cannot write $file"
    settings_set "$file" TG_PING_CHAT_ID "$CHATS" || die "$EX_FAIL" "cannot write $file"
    if [ -n "$machine" ]; then
        settings_set "$file" TG_PING_MACHINE "$machine"
        settings_set "$file" TG_PING_MACHINE_ICON "$(machine_icon_for "$(detect_machine_kind)")"
        MACHINE="$machine"; MACHINE_ICON=""
    fi
    msg "settings written to $file"

    TITLE="tg-ping is ready"
    BODY="Notifications from this machine will arrive here."
    LEVEL="success"; META=1
    deliver "$(build_message)" && msg "a confirmation message was sent to chat $CHATS"
    exit "$EX_OK"
}

doctor_line() {
    # doctor_line STATUS LABEL DETAIL
    local status="$1" label="$2" detail="$3" mark
    case "$status" in
        ok)   mark="[ ok ]" ;;
        warn) mark="[warn]" ;;
        note) mark="[note]" ;;
        *)    mark="[fail]" ;;
    esac
    printf '%s %-22s %s\n' "$mark" "$label" "$detail"
}

latex_engine_name() {
    # The programs that render LaTeX formulas here, or nothing.
    if have latex && have dvipng; then printf 'latex and dvipng'
    elif have pdflatex && have pdftoppm; then printf 'pdflatex and pdftoppm'
    elif have pdflatex && have pdftocairo; then printf 'pdflatex and pdftocairo'
    fi
}

doctor_math_test() {
    # doctor_math_test SYNTAX SOURCE: renders a formula offline, nothing sent.
    local syntax="$1" src="$2" png t0 t1
    png="$(workdir)/doctor-$syntax.png"
    rm -f "$png"
    t0=$(date +%s)
    ( MATH_SYNTAX="$syntax"; SOFT_FAIL=0; render_math "$src" "$png" ) >/dev/null 2>&1
    t1=$(date +%s)
    if [ -s "$png" ]; then
        doctor_line ok "$syntax formula" "a test formula rendered in $(( t1 - t0 ))s"
        return 0
    fi
    doctor_line fail "$syntax formula" "the test formula did not render; run '$TG_PING_NAME math --dry-run -v' on a formula to see the log"
    return 1
}

cmd_doctor() {
    local args=() a problems=0 scope file found="" perms me name engine line chat ctype clabel url
    for a in "$@"; do
        case "$a" in
            --send) DOCTOR_SEND=1 ;;
            --math) DOCTOR_MATH=1 ;;
            *)      args[${#args[@]}]="$a" ;;
        esac
    done
    if [ ${#args[@]} -gt 0 ]; then parse_common_args "${args[@]}"; else parse_common_args; fi
    [ "$HELP_REQUESTED" -eq 1 ] && { help_doctor; exit "$EX_OK"; }

    printf '%s %s on %s\n\n' "$TG_PING_NAME" "$TG_PING_VERSION" "$(uname -s)"

    if have curl; then doctor_line ok "curl" "$(curl --version 2>/dev/null | head -n1 | cut -c1-40)"
    else doctor_line fail "curl" "missing, install with: sudo apt install -y curl"; problems=$((problems+1)); fi

    if have jq; then doctor_line ok "jq" "$(jq --version 2>/dev/null)"
    elif have python3; then doctor_line ok "json reader" "python3 (jq not installed, that is fine)"
    else doctor_line warn "json reader" "neither jq nor python3, 'ask' and 'chats' will not work"; fi

    doctor_line ok "bash" "${BASH_VERSION:-unknown}"

    # shellcheck disable=SC2086  # the setting may hold a command and its arguments
    if awk_counts_bytes ${TG_PING_AWK:-${AWK_CMD:-awk}}; then
        doctor_line ok "awk" "${TG_PING_AWK:-${AWK_CMD:-awk}}"
    else
        doctor_line warn "awk" "${TG_PING_AWK:-${AWK_CMD:-awk}} reads UTF-8 by itself, so long texts may be cut badly; install mawk or gawk"
    fi

    engine=$(latex_engine_name)
    if [ -n "$engine" ]; then doctor_line ok "LaTeX formulas" "$engine"
    else doctor_line warn "LaTeX formulas" "none, install texlive and dvipng for 'tg-ping math'"; fi
    if have typst; then doctor_line ok "typst formulas" "$(typst --version 2>/dev/null | head -n1) (with --typst)"
    else doctor_line note "typst formulas" "typst is not installed, so --typst is not available"; fi
    line=""
    { have pdftoppm || have pdftocairo || have_imagemagick; } && line="$line, PDF pages"
    have ffmpeg && line="$line, video re-encoding"
    { have inkscape || have_imagemagick || have rsvg-convert; } && line="$line, SVG figures"
    have flock && line="$line, the shared lock for questions"
    [ -n "$line" ] && doctor_line note "optional helpers" "found for ${line#, }"

    while read -r scope file; do
        [ -n "$file" ] && [ -r "$file" ] || continue
        found="$file"
        if [ "$scope" = "own" ]; then
            # shellcheck disable=SC2012  # ls is the portable way to read a mode string
            perms=$(ls -lL "$file" 2>/dev/null | cut -c1-10)
            case "$perms" in
                -rw-------|-r--------) doctor_line ok "settings" "$file ($perms)" ;;
                *) doctor_line warn "settings" "$file is readable by others ($perms), run: chmod 600 $file" ;;
            esac
        else
            doctor_line ok "settings" "$file (this folder's own)"
        fi
        break
    done <<EOF
$(config_files)
EOF
    [ -n "$found" ] || doctor_line warn "settings" "no settings file found, using environment variables only"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        doctor_line warn "ignored key" "$line: a file in the working folder cannot supply a bot key or a server; a project chooses one of your profiles with TG_PING_PROFILE"
    done <<EOF
$(ignored_keys)
EOF

    load_config
    if [ -n "$TOKEN" ]; then
        case "$TOKEN" in
            [0-9]*:*) doctor_line ok "token" "bot number ${TOKEN%%:*}, from $TOKEN_SRC" ;;
            *)        doctor_line warn "token" "from $TOKEN_SRC, but its shape is unusual" ;;
        esac
    else
        doctor_line fail "token" "not set, run '$TG_PING_NAME init'"; problems=$((problems+1))
    fi
    if [ -n "$CHATS" ]; then doctor_line ok "chat id" "$CHATS, from $CHATS_SRC"
    else doctor_line fail "chat id" "not set, run '$TG_PING_NAME init'"; problems=$((problems+1)); fi

    if [ -n "$(machine_tag)" ]; then doctor_line ok "machine" "$(machine_tag)"
    else doctor_line note "machine" "not named; '$TG_PING_NAME config set machine NAME' shows it on every message"; fi
    if [ -n "$AGENT_NAME" ]; then doctor_line ok "agent" "$(agent_summary)"
    else doctor_line note "agent" "$(agent_summary); a message sent from here names no agent"; fi

    case ":$PATH:" in
        *":$HOME/.local/bin:"*) doctor_line ok "PATH" "\$HOME/.local/bin is on PATH" ;;
        *) doctor_line warn "PATH" "\$HOME/.local/bin is not on PATH, add it in ~/.profile" ;;
    esac

    if [ -n "${HTTPS_PROXY:-${https_proxy:-}}" ]; then
        doctor_line warn "proxy" "HTTPS_PROXY is set, curl will use it"
    fi

    if [ "$DISABLED" = "1" ]; then
        doctor_line warn "disabled" "TG_PING_DISABLED is set: every call is a silent no-op, Telegram is not contacted"
    elif [ -n "$TOKEN" ]; then
        req_reset
        if api_call getMe; then
            name=$(json_get "$API_BODY" "result.username")
            me=$(json_get "$API_BODY" "result.first_name")
            doctor_line ok "Telegram API" "reachable, bot is $me (@$name)"
            if [ "$(json_get "$API_BODY" "result.has_topics_enabled")" = "true" ]; then
                doctor_line ok "topics" "topic mode is on for this bot${TOPICS_MODE:+ (TG_PING_TOPICS=$TOPICS_MODE)}"
            elif [ "$TOPICS_MODE" = "project" ]; then
                doctor_line warn "topics" "TG_PING_TOPICS asks for a topic per project, but topic mode is off for the bot; switch on Threaded Mode in @BotFather"
            fi
            req_reset
            if api_call getWebhookInfo; then
                url=$(json_get "$API_BODY" "result.url")
                [ -z "$url" ] || doctor_line warn "webhook" "a webhook is set, so 'ask', 'poll --wait' and 'chats' cannot read answers"
            fi
            for chat in $(chat_list); do
                req_reset
                req_add chat_id "$chat"
                if api_call getChat; then
                    ctype=$(json_get "$API_BODY" "result.type")
                    clabel=$(json_get "$API_BODY" "result.title")
                    [ -n "$clabel" ] || clabel=$(json_get "$API_BODY" "result.first_name")
                    doctor_line ok "chat $chat" "${ctype:-chat}${clabel:+, $clabel}, reachable (nothing was sent)"
                else
                    doctor_line fail "chat $chat" "$(api_explain "$API_ERROR")"; problems=$((problems+1))
                fi
            done
        else
            doctor_line fail "Telegram API" "$(api_explain "$API_ERROR")"; problems=$((problems+1))
        fi
    fi

    if [ "$DOCTOR_MATH" -eq 1 ]; then
        if [ -n "$engine" ]; then
            doctor_math_test latex 'E(t) \leqslant E(0)\, e^{-\gamma t}, \quad t \geqslant 0' || problems=$((problems+1))
        fi
        if have typst; then
            doctor_math_test typst 'E(t) lt.eq.slant E(0) e^(-gamma t), quad t gt.eq.slant 0' || problems=$((problems+1))
        fi
    fi

    if [ "$DOCTOR_SEND" -eq 1 ] && [ -n "$TOKEN" ] && [ -n "$CHATS" ]; then
        TITLE="doctor"; BODY="test message from this machine"; LEVEL="ok"
        if deliver "$(build_message)"; then doctor_line ok "delivery" "test message sent"
        else doctor_line fail "delivery" "could not send the test message"; problems=$((problems+1)); fi
    fi

    printf '\n'
    if [ "$problems" -eq 0 ]; then
        printf '%s\n' "Everything needed to send messages is in place."
        exit "$EX_OK"
    fi
    printf '%s\n' "$problems problem(s) found. Fix the [fail] lines above, then run doctor again."
    exit "$EX_CONFIG"
}

cmd_chats() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_chats; exit "$EX_OK"; }
    need_json_reader chats
    require_credentials_token_only
    local uid kind cid from payload ref mid replyto mdate content ctype clabel seen=""
    printf '%-16s %-10s %s\n' "CHAT ID" "TYPE" "NAME"
    # shellcheck disable=SC2034  # the fields are read to keep them aligned
    while IFS="$US" read -r uid kind cid from payload ref mid replyto mdate content ctype clabel; do
        [ "$kind" = "message" ] || continue
        [ -n "$cid" ] || continue
        case " $seen " in *" $cid "*) continue ;; esac
        seen="$seen $cid"
        printf '%-16s %-10s %s\n' "$cid" "$ctype" "$clabel"
    done <<EOF
$(updates_snapshot)
EOF
    updates_check_fatal
    [ -n "$seen" ] || printf '%s\n' "" "No chat has written to this bot recently." \
        "Send it a message in Telegram, then run this again." \
        "Telegram only keeps unread updates for 24 hours."
    exit "$EX_OK"
}

require_credentials_token_only() {
    load_config
    [ -n "$TOKEN" ] || die "$EX_CONFIG" "no bot token found, run '$TG_PING_NAME init'"
}

cmd_config() {
    parse_common_args "$@"
    [ "$HELP_REQUESTED" -eq 1 ] && { help_config; exit "$EX_OK"; }
    local action="${REMAINING[0]:-show}" key value var file scope
    case "$action" in
        path)
            printf '%s\n' "$(config_dir)/${PROFILE}.env" ;;
        files)
            while read -r scope file; do
                printf '%s (%s)\n' "$file" "$scope"
            done <<EOF
$(config_files)
EOF
            ;;
        show)
            load_config
            printf 'profile   : %s\n' "$PROFILE"
            printf 'config    : %s\n' "$(config_dir)/${PROFILE}.env"
            if [ -n "$TOKEN" ]; then
                printf 'bot       : number %s (the secret part of the token is never shown)\n' "${TOKEN%%:*}"
            else
                printf 'bot       : no token\n'
            fi
            printf 'token from: %s\n' "${TOKEN_SRC:-nowhere}"
            printf 'chat id   : %s\n' "${CHATS:-not set}"
            printf 'chat from : %s\n' "${CHATS_SRC:-nowhere}"
            printf 'machine   : %s\n' "$( [ -n "$(machine_tag)" ] && machine_tag || printf 'not named')"
            printf 'agent     : %s\n' "$(agent_summary)"
            printf 'project   : %s\n' "$( project_shown && printf '%s (on every message)' "$(project_label)" || printf 'not shown; %s config set project on' "$TG_PING_NAME")"
            printf 'topic     : %s\n' "${THREAD_ID:-none}"
            printf 'topics    : %s\n' "${TOPICS_MODE:-off}"
            printf 'quiet     : %s\n' "${QUIET_HOURS:-never}"
            printf 'api root  : %s\n' "$API_ROOT"
            printf 'state dir : %s\n' "$(state_dir)"
            printf 'format    : %s\n' "$FORMAT"
            printf 'math      : %s dpi, %s background, remote %s\n' \
                "$MATH_DPI" "$MATH_BG" "$( [ "$MATH_REMOTE_OK" = "1" ] && printf allowed || printf 'never')"
            printf 'preamble  : %s\n' "${MATH_PREAMBLE:-none}"
            printf 'footer    : %s\n' "$META_FIELDS"
            printf 'network   : %ss timeout, %s retries\n' "$TIMEOUT" "$RETRIES"
            printf 'run tail  : %s lines\n' "$RUN_TAIL" ;;
        set|unset)
            key="${REMAINING[1]:-}"; value=""
            local i=2
            while [ "$i" -lt "${#REMAINING[@]}" ]; do
                value="${value:+$value }${REMAINING[$i]}"
                i=$(( i + 1 ))
            done
            [ -n "$key" ] || die "$EX_USAGE" "usage: $TG_PING_NAME config set KEY VALUE, or $TG_PING_NAME config unset KEY"
            case "$(lc "$key")" in
                machine)              var=TG_PING_MACHINE ;;
                agent)                var=TG_PING_AGENT ;;
                icon|machine-icon)    var=TG_PING_MACHINE_ICON ;;
                topics)               var=TG_PING_TOPICS ;;
                quiet|quiet-hours)    var=TG_PING_QUIET_HOURS ;;
                format)               var=TG_PING_FORMAT ;;
                prefix)               var=TG_PING_PREFIX ;;
                meta|footer)          var=TG_PING_META ;;
                project|folder)       var=TG_PING_PROJECT ;;
                chat|chat-id)         var=TG_PING_CHAT_ID ;;
                topic|thread)         var=TG_PING_THREAD_ID ;;
                tg_ping_*)            var=$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]') ;;
                *) die "$EX_USAGE" "unknown setting '$key': use machine, icon, agent, project, topics, quiet-hours, format, prefix, meta, chat, topic, or a TG_PING_* name" ;;
            esac
            case "$var" in
                TG_PING_TOKEN|TG_PING_BOT_TOKEN)
                    die "$EX_USAGE" "the token is set by '$TG_PING_NAME init', which reads it without echo and checks it" ;;
            esac
            if [ "$action" = "unset" ]; then
                value=""
            elif [ -z "$value" ]; then
                die "$EX_USAGE" "'config set $key' needs a value"
            fi
            file="$(config_dir)/${PROFILE}.env"
            if [ "$DRY_RUN" -eq 1 ]; then
                msg "dry run: $var would be $( [ -n "$value" ] && printf 'set' || printf 'removed') in $file"
                exit "$EX_OK"
            fi
            settings_set "$file" "$var" "$value" || die "$EX_FAIL" "cannot write $file"
            if [ "$var" = "TG_PING_MACHINE" ]; then
                # The icon follows the kind of machine, detected once, now.
                if [ -n "$value" ]; then
                    settings_set "$file" TG_PING_MACHINE_ICON "$(machine_icon_for "$(detect_machine_kind)")"
                else
                    settings_set "$file" TG_PING_MACHINE_ICON ""
                fi
            fi
            if [ -n "$value" ]; then msg "$var set in $file"; else msg "$var removed from $file"; fi ;;
        *)
            die "$EX_USAGE" "'config' expects show, set, unset, path or files" ;;
    esac
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Integration snippets
# ---------------------------------------------------------------------------

cmd_hook() {
    local target="${1:-list}"
    case "$target" in
        claude)
            cat <<'EOS'
## Notifications (tg-ping)

`tg-ping` sends a Telegram message to the user's phone. Use it to keep the
user informed while you work unattended.

Ping when:
- a long task starts, so the user knows work is under way;
- a build, test suite, benchmark or simulation finishes or fails;
- you produced a figure, a table or a document worth looking at;
- you are blocked and need a decision;
- the requested objective is complete.

Keep every message to one or two sentences. Prefer one message per milestone
over a stream of small updates.

```bash
tg-ping --ok    --title "Tests green" "142 passed in 38s"
tg-ping --fail  --title "Build broke" --code-file /tmp/build.log --lang text
tg-ping --ok    --title "Figure ready" "The spectrum is real." --photo figures/spectrum.pdf
tg-ping photo   figures/convergence.pdf --caption "Second order confirmed"
tg-ping math    '\lambda_1 = \pi^2/4' --caption "First eigenvalue"
tg-ping pdf     paper.pdf --pages 7-8 --caption "The corrected section"
tg-ping run --label "full test suite" --every 30m --stall 20m --alert 'NaN|Error' -- make test
answer=$(tg-ping ask "Continue with the refactor?" -o yes -o no --wait 900)
answer=$(tg-ping ask "Which figure?" --photo a.png --photo b.png -o left -o right --wait 900)
file=$(tg-ping receive "Please send the PDF of the paper" --wait 15m --out inbox/)
```

Add `--dry-run` to see the request without sending it. Questions asked from
several sessions at once never mix their answers. `receive` saves a file the
user sends from the phone and prints its path.

Never print or echo the bot token. Never pass `--token` on the command line.
EOS
            ;;
        codex|agents)
            cat <<'EOS'
# Notifications

The `tg-ping` command messages the user on Telegram. Run `tg-ping --help` once
for the full interface. Send a message when a long job starts or ends, when
something fails, when a figure or document is ready, and when you need a
decision. One or two sentences per message.

  tg-ping --ok --title "Done" "Refactor complete, 0 regressions"
  tg-ping --fail --title "make failed" --code-file build.log
  tg-ping run --label "benchmarks" -- ./bench.sh
  tg-ping ask "Ship it?" -o ship -o wait --wait 600
EOS
            ;;
        hooks|settings)
            cat <<'EOS'
Claude Code hooks. Put this in .claude/settings.json to be notified whenever
the agent stops and whenever it needs attention. Claude Code hands each hook
a JSON document on stdin, which --no-stdin leaves unread; --cooldown keeps a
burst of stops to one message a minute. Grok runs these hooks too, so the
titles name no agent: the first line of every message names the one that
sends it.

{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tg-ping --no-stdin --ok --title \"Finished\" --cooldown 60 --key agent-stop --meta \"Session ended in $(basename \"$PWD\")\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tg-ping --no-stdin --level question --title \"Needs you\" --meta \"Waiting in $(basename \"$PWD\")\""
          }
        ]
      }
    ]
  }
}
EOS
            ;;
        bash|trap)
            cat <<'EOS'
Notify when a script fails, wherever it fails, and when it ends well:

  set -Eeuo pipefail
  trap 'rc=$?; tg-ping --no-stdin --fail --title "$(basename "$0") failed" \
        --field "line=$LINENO" --field "exit=$rc" --meta' ERR
  trap '[ $? -eq 0 ] && tg-ping --no-stdin --ok --title "$(basename "$0") finished" --meta' EXIT

The ERR trap reports the line that failed and its exit code (kept first, since
the title runs a command of its own); the EXIT trap speaks only when the
script succeeded, so a failure is not followed by "finished". --no-stdin keeps
the traps from reading the script's own input.

Report the failure of one long command, with the end of its output:

  long() { tg-ping run --label "$*" --on failure -- "$@"; }
  long ./sweep.sh --cases 512
EOS
            ;;
        make)
            cat <<'EOS'
Makefile integration:

  NOTIFY := tg-ping

  .PHONY: paper
  paper:
	@$(NOTIFY) --start --title "Compiling the paper"
	@$(NOTIFY) run --label "typst compile" --on failure -- typst compile main.typ
	@$(NOTIFY) file main.pdf --ok --caption "Paper rebuilt"
EOS
            ;;
        actions|ci)
            cat <<'EOS'
GitHub Actions step. Store the credentials as repository secrets:

  - name: Notify Telegram
    if: always()
    env:
      TG_PING_TOKEN: ${{ secrets.TG_PING_TOKEN }}
      TG_PING_CHAT_ID: ${{ secrets.TG_PING_CHAT_ID }}
    run: |
      curl -fsSL https://raw.githubusercontent.com/dutykh/tg-ping/main/bin/tg-ping -o "$RUNNER_TEMP/tg-ping"
      chmod +x "$RUNNER_TEMP/tg-ping"
      "$RUNNER_TEMP/tg-ping" --soft-fail \
              --level ${{ job.status == 'success' && 'ok' || 'error' }} \
              --title "${{ github.workflow }}: ${{ job.status }}" \
              --field "repo=${{ github.repository }}" \
              --field "ref=${{ github.ref_name }}" \
              --button "Run=${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
EOS
            ;;
        systemd)
            cat <<'EOS'
Report the failure of any systemd unit. Save as
/etc/systemd/system/tg-ping-failure@.service:

  [Unit]
  Description=Telegram alert for %i

  [Service]
  Type=oneshot
  EnvironmentFile=/etc/tg-ping/config
  ExecStart=/usr/local/bin/tg-ping --fail --title "%i failed" --meta

Then add to any unit:  OnFailure=tg-ping-failure@%n.service
EOS
            ;;
        python)
            cat <<'EOS'
From Python, for research scripts:

  import subprocess

  def ping(text, level="info", **fields):
      cmd = ["tg-ping", "--soft-fail", "--level", level]
      for key, value in fields.items():
          cmd += ["--field", f"{key}={value}"]
      cmd += ["--", text]          # the text is never read as a command
      subprocess.run(cmd, check=False, stdin=subprocess.DEVNULL)

  ping("Sweep finished", level="ok", runs=512, best_error="1.4e-8")
  subprocess.run(["tg-ping", "photo", "figures/spectrum.png", "--soft-fail",
                  "--caption", "Spectrum of the linearised operator"],
                 check=False, stdin=subprocess.DEVNULL)
EOS
            ;;
        *)
            printf '%s\n' "Available snippets:" \
                "  claude    project instructions for Claude Code (CLAUDE.md)" \
                "  codex     project instructions for Codex (AGENTS.md)" \
                "  hooks     Claude Code hooks for .claude/settings.json" \
                "  bash      ERR and EXIT traps for shell scripts" \
                "  make      Makefile targets" \
                "  actions   GitHub Actions step" \
                "  systemd   OnFailure alerting" \
                "  python    helper function for research scripts" \
                "" "Usage: $TG_PING_NAME hook claude >> CLAUDE.md"
            ;;
    esac
    exit "$EX_OK"
}

cmd_cheatsheet() {
    cat <<'EOS'
tg-ping cheat sheet

  tg-ping "text"                          plain notification
  tg-ping --ok --title "Done" "details"   titled, with a green check
  tg-ping --fail --title "Broke" --code-file log.txt --lang text
  echo "$output" | tg-ping --title "Result"
  tg-ping --item "step one done" --item "step two running"
  tg-ping --field "error=1.4e-8" --field "runs=512"
  tg-ping --ok --title "Lemma closed" "text" --math 'E(t) \leqslant E(0)'
  tg-ping --ok --title "Figure ready" "text" --photo fig.pdf --document data.csv
  tg-ping photo fig.pdf --caption "Convergence"          PDF, SVG, EPS drawn first
  tg-ping photo a.png b.png --caption "Sweep" --each "a" --each "b"
  tg-ping photo res.png --key res --replace              live figure
  tg-ping pdf paper.pdf --pages 3,7-9 --attach
  tg-ping file clip.mp4 --as video --caption "Evolution"
  tg-ping rich report.md --title "Opening"               Markdown, formulas, figures
  tg-ping code solver.py --lang python
  tg-ping table results.csv --title "Errors"
  tg-ping math 'u_t + u u_x = 0 \\ u(x,0) = u_0(x)'
  tg-ping run --label "sweep" --every 30m --stall 20m --alert 'NaN|diverg' -- make test
  tg-ping wait 41532 --label "sweep" --log sweep.log
  tg-ping progress start "Training" --expected 2h
  tg-ping progress update "epoch 5 of 20" --percent 5/20
  tg-ping progress done "converged"
  answer=$(tg-ping ask "Which basis?" -o Chebyshev -o Fourier --wait 900)
  answer=$(tg-ping ask "Which figure?" --photo a.png --photo b.png -o left -o right)
  file=$(tg-ping receive "Please send the PDF" --wait 15m --out inbox/)
  tg-ping edit --last "corrected text";  tg-ping delete --last

Levels: --start --info --ok --warn --fail --partial --blocked --debug --level question
Delivery: --silent --pin --topic ID --chat ID --reply-to last --cooldown 300 --no-stdin
Formats: auto (default), --rich (formulas typeset by Telegram), --plain, --html
Safety: --dry-run --disabled --soft-fail
Settings: tg-ping config set machine NAME | agent auto | project on | topics project | quiet-hours 23-08
Exit codes: 0 sent, 2 usage, 3 config, 4 network, 5 API, 6 rate limit, 7 timeout
EOS
    exit "$EX_OK"
}

cmd_completion() {
    # cmd_completion bash|zsh: the completion code, made from the lists of
    # commands and options, so that it follows every new option.
    local shell="${1:-bash}" names longs files other entry script lines
    case "$shell" in
        bash|zsh) ;;
        -h|--help) help_completion; exit "$EX_OK" ;;
        *) die "$EX_USAGE" "completion supports bash and zsh" ;;
    esac
    names=$(printf '%s\n' "$COMMAND_LIST" | cut -d: -f1 | tr '\n' ' ')
    longs=$(printf '%s %s' "$VALUE_OPTS" "$FLAG_OPTS" | tr ' ' '\n' | grep -e '^--.' | LC_ALL=C sort -u | tr '\n' ' ')
    files="--code-file --quote-file --out --preamble --env-file --config --token-file --file --log"
    other=""
    for entry in $VALUE_OPTS; do
        case " $files --level -L --format --as --bg --background --on --profile -P " in
            *" $entry "*) ;;
            *) other="$other|$entry" ;;
        esac
    done
    if [ "$shell" = bash ]; then
        IFS= read -r -d '' script <<'EOS' || true
# Bash completion for tg-ping, made by 'tg-ping completion bash'.
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).

_tg_ping_completions() {
    local cur prev dir f names
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    case "$prev" in
        --level|-L) COMPREPLY=($(compgen -W "@LEVELS@" -- "$cur")); return ;;
        --format)   COMPREPLY=($(compgen -W "@FORMATS@" -- "$cur")); return ;;
        --as)       COMPREPLY=($(compgen -W "@KINDS@" -- "$cur")); return ;;
        --bg|--background)
                    COMPREPLY=($(compgen -W "white transparent dark" -- "$cur")); return ;;
        --on)       COMPREPLY=($(compgen -W "always success failure never" -- "$cur")); return ;;
        --profile|-P)
            dir="${XDG_CONFIG_HOME:-$HOME/.config}/tg-ping"; names=""
            for f in "$dir"/*.env; do [ -e "$f" ] && f=${f##*/} && names="$names ${f%.env}"; done
            COMPREPLY=($(compgen -W "$names" -- "$cur")); return ;;
        @FILE_OPTS@)
            COMPREPLY=($(compgen -f -- "$cur")); return ;;
        @OTHER_OPTS@)
            return ;;
    esac
    if [ "$COMP_CWORD" -eq 2 ]; then
        case "$prev" in
            hook|hooks) COMPREPLY=($(compgen -W "@HOOKS@" -- "$cur")); return ;;
            progress)   COMPREPLY=($(compgen -W "start update done" -- "$cur")); return ;;
            config)     COMPREPLY=($(compgen -W "show set unset path files" -- "$cur")); return ;;
            completion) COMPREPLY=($(compgen -W "bash zsh" -- "$cur")); return ;;
            help)       COMPREPLY=($(compgen -W "@COMMANDS@" -- "$cur")); return ;;
        esac
    fi
    case "$cur" in
        -*) COMPREPLY=($(compgen -W "@OPTIONS@" -- "$cur")) ;;
        *)  if [ "$COMP_CWORD" -eq 1 ]; then
                COMPREPLY=($(compgen -W "@COMMANDS@" -- "$cur"))
            else
                COMPREPLY=($(compgen -f -- "$cur"))
            fi ;;
    esac
}
complete -o filenames -F _tg_ping_completions tg-ping
EOS
    else
        IFS= read -r -d '' script <<'EOS' || true
#compdef tg-ping
# Zsh completion for tg-ping, made by 'tg-ping completion zsh'.
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).

_tg_ping() {
    local -a commands options profiles
    commands=(
@DESCRIBED@
    )
    options=(@OPTIONS@)
    case "${words[CURRENT-1]}" in
        --level|-L) compadd -- @LEVELS@; return ;;
        --format) compadd -- @FORMATS@; return ;;
        --as) compadd -- @KINDS@; return ;;
        --bg|--background) compadd -- white transparent dark; return ;;
        --on) compadd -- always success failure never; return ;;
        --profile|-P)
            profiles=(${XDG_CONFIG_HOME:-$HOME/.config}/tg-ping/*.env(N:t:r))
            compadd -a profiles; return ;;
        @FILE_OPTS@) _files; return ;;
        @OTHER_OPTS@) return ;;
    esac
    if (( CURRENT == 3 )); then
        case "${words[2]}" in
            hook|hooks) compadd -- @HOOKS@; return ;;
            progress) compadd -- start update done; return ;;
            config) compadd -- show set unset path files; return ;;
            completion) compadd -- bash zsh; return ;;
            help) _describe 'command' commands; return ;;
        esac
    fi
    if [[ "$PREFIX" == -* ]]; then
        compadd -a options
    elif (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_tg_ping "$@"
EOS
    fi
    lines=$(printf '%s\n' "$COMMAND_LIST" | sed -e "s/.*/        '&'/")
    script=${script//@DESCRIBED@/"$lines"}
    script=${script//@COMMANDS@/"${names% }"}
    script=${script//@OPTIONS@/"${longs% }"}
    script=${script//@FILE_OPTS@/"$(printf '%s' "$files" | tr ' ' '|')"}
    script=${script//@OTHER_OPTS@/"${other#|}"}
    script=${script//@LEVELS@/"start info success warn error partial blocked question progress debug math"}
    script=${script//@FORMATS@/"auto rich html markdown plain"}
    script=${script//@KINDS@/"auto photo video audio animation document"}
    script=${script//@HOOKS@/"claude codex hooks bash make actions systemd python"}
    printf '%s' "$script"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

usage() {
    cat <<EOS
$TG_PING_NAME $TG_PING_VERSION, expressive Telegram notifications for terminals and agents.

USAGE
  $TG_PING_NAME [options] "message text"
  $TG_PING_NAME <command> [options] [arguments]
  <command producing output> | $TG_PING_NAME [options]

  The command word may come before or after the options:
  '$TG_PING_NAME photo fig.png --caption X' and '$TG_PING_NAME --caption X photo fig.png'
  do the same. After '--' a word is text: '$TG_PING_NAME --ok -- math' sends "math".

COMMANDS
  send        send a text message (the default, the word may be omitted)
  code        send a snippet or a file as a highlighted code block
  table       align CSV or TSV rows and send them as a table
  math        typeset a LaTeX or Typst formula and send it as an image
  photo       send pictures (PDF, SVG and EPS figures are drawn first), one or an album
  file        send any document: PDF, log, archive, notebook
  media       send files, each as what its extension says
  pdf         send chosen pages of a PDF as pictures
  rich        send a Markdown report as one rich message, figures included
  run         run a command, then report how it ended
  progress    keep a single message updated in place
  ask         ask a question and wait for the answer on the phone
  poll        send a native Telegram poll
  receive     wait for a file sent from the phone (a photo, a document) and save it
  wait        send a message when a running process ends
  edit        correct a message already sent
  delete      withdraw a message already sent
  init        interactive setup, writes the settings file
  doctor      check the installation, the settings, the bot and each chat
              ('doctor --math' renders a test formula, 'doctor --send' sends a test message)
  chats       list the chat ids that have written to the bot
  config      show the settings and where each comes from; 'config set KEY VALUE'
  hook        print integration snippets (claude, codex, hooks, bash, make, actions, systemd, python)
  cheatsheet  one screen reference, made to paste into agent instructions
  completion  print shell completion for bash or zsh
  help        help for a command, for example: $TG_PING_NAME help ask

MESSAGE PARTS, combine them freely
  -m, --message TEXT    the body; '-' or a pipe gives it on stdin (--no-stdin forbids)
  -t, --title TEXT      bold first line
  -L, --level NAME      start, info, success, warn, error, question, debug, progress,
                        partial, blocked
      --ok --fail --warn --start --info --debug --partial --blocked
                        shorthands for --level
      --emoji CHAR      use this emoji instead of the level default
      --item TEXT       a bullet point, repeatable
      --field KEY=VALUE a bold key followed by its value, repeatable
      --math LATEX      a formula with the message, repeatable: typeset by Telegram
                        in the rich format, drawn as a picture otherwise
      --photo FILE      a picture with the message, repeatable (a PDF, SVG or EPS
                        figure is drawn first); --document FILE a file: they carry
                        the text as their caption when it fits, or follow it as a reply
      --code TEXT       a code block; --code-file FILE reads it, --lang NAME highlights it
      --quote TEXT      a block quote; --quote-file FILE reads it, --collapse folds it
      --percent N       a progress bar: 45, 45.5, or a count such as 37/512
      --button "L=URL"  an inline button that opens a link, repeatable
      --meta            footer: machine, repository, project and time (TG_PING_META chooses);
                        with TG_PING_PROJECT=on every message ends with its project
      --no-meta         no footer on this message, not even the project
      --no-machine      leave out the name of this machine for once
      --agent NAME      the agent named after the machine, found by itself otherwise
                        (Claude, Codex, Grok, OpenCode, Gemini, Antigravity, ...);
                        --no-agent leaves it out for once

DELIVERY
  -c, --chat ID         target chat, repeatable, overrides the settings
      --topic ID        forum topic (message thread) inside a group
      --reply-to ID     reply to an existing message; 'last' is the last one this project sent
      --silent          deliver without a notification sound
      --pin             pin the message after sending
      --protect         forbid forwarding and saving
      --preview         allow link previews, which are suppressed by default
      --cooldown SEC    drop a repeat of the same alert inside this window
      --key NAME        name the cooldown bucket, the progress slot or the live figure
      --truncate        cut instead of splitting a long message
      --max-parts N     at most N parts (default 8); beyond, the whole text follows as a file

FORMATTING
      --format MODE     auto (default), plain, markdown, html or rich
        auto      write light Markdown; correctly escaped HTML is emitted, and
                  if Telegram still refuses the markup the message is resent as
                  literal plain text, so a notification is never lost
        rich      a rich message: headings, lists, tables, and formulas $...$ and
                  \$\$...\$\$ typeset by Telegram; refused, the classic form goes out
        plain     send exactly the characters given, nothing is interpreted
        markdown  Telegram MarkdownV2, escaping is the caller's responsibility
        html      Telegram HTML, escaping is the caller's responsibility
      --rich --plain --html --markdown    shorthands for --format
      --no-fallback     fail instead of resending as plain text
  Understood in auto and rich mode:
      **bold**  *bold*  _italic_  __underline__  ~~strike~~  ||spoiler||
      \`code\`  \`\`\`lang fenced blocks\`\`\`  [label](url)  - bullets  > quotes
  An emphasis needs a non-blank character inside each marker, so f(*args, **kwargs),
  a || b and __init__ stay as written.

BEHAVIOUR
  -n, --dry-run         print the request instead of sending it; nothing is written
      --json            print the raw Telegram reply on stdout
  -v, --verbose         explain what is happening, on stderr
  -q, --quiet           suppress everything but errors
      --tee             also print the message locally, on stderr
      --soft-fail       exit 0 even when delivery fails, so a pipeline survives
      --disabled        do nothing at all, same as TG_PING_DISABLED=1
      --timeout SEC     per request timeout, default $TIMEOUT (uploads stop only when stalled)
      --retries N       retries on network errors, 429 and 5xx, default $RETRIES
      --api URL         another Bot API server
  -P, --profile NAME    use a second bot or chat, kept in its own file
      --env-file FILE   read the settings from this file
      --token-file FILE read the token from this file, never from the argument list

SETTINGS, first match wins
  1. command line flags
  2. environment: TG_PING_TOKEN, TG_PING_CHAT_ID and the other TG_PING_* names
  3. --env-file FILE, or \$TG_PING_ENV_FILE
  4. ./.tg-ping.env, which may choose a chat, a topic or a profile (TG_PING_PROFILE)
  5. ./.env.local, TG_PING_* keys only
  6. ./.env, TG_PING_* keys only
  7. $(config_dir)/<profile>.env
  8. /etc/tg-ping/config
  9. the older TELEGRAM_* names: from the environment, then from the files 3, 4, 7 and 8
  A file of the working folder never supplies the token or TG_PING_API. Files are
  parsed as KEY=VALUE, never sourced, never evaluated.

ENVIRONMENT
  TG_PING_TOKEN, TG_PING_CHAT_ID    credentials, chat id may be a comma separated list
  TG_PING_MACHINE                   the name of this machine, shown on every message
  TG_PING_AGENT                     the agent shown next to it: auto (found by itself,
                                    the default), off, or a name of your own
  TG_PING_PROJECT=on                every message ends with its project (repository and
                                    folder, or a name given here), when several agents report
  TG_PING_TOPICS=project            one topic per project and machine in the chat
  TG_PING_QUIET_HOURS=23-08         no sound at night (errors and questions excepted)
  TG_PING_THREAD_ID                 default forum topic
  TG_PING_PREFIX                    label put in front of every message
  TG_PING_FORMAT                    default format, default auto
  TG_PING_META                      footer fields: host, repo, project, time (default host,repo,time)
  TG_PING_DISABLED=1                turn every call into a silent no-op
  TG_PING_SOFT_FAIL=1               never fail a pipeline because of a notification
  TG_PING_NO_STDIN=1                never read stdin unless asked with '-'
  TG_PING_NO_DOTENV=1               ignore ./.env, ./.env.local and ./.tg-ping.env
  TG_PING_PROFILE                   profile name, default "default"
  TG_PING_MATH_REMOTE=1             allow the public LaTeX renderer as a fallback
  'tg-ping config show' lists every setting and where it comes from.

EXIT CODES
  0 delivered      2 bad usage       3 missing configuration   4 network failure
  5 Telegram error 6 rate limited    7 no answer before the deadline
  run passes the exit code of the wrapped command through unchanged.

EXAMPLES
  $TG_PING_NAME "Sweep finished, 512 runs, best error 1.4e-8"
  $TG_PING_NAME --ok --title "Tests green" "142 passed in 38 s" --meta
  $TG_PING_NAME --fail --title "Build broke" --code-file build.log --lang text
  $TG_PING_NAME --ok --title "Lemma closed" "The energy decays." --math 'E(t) \\leqslant E(0)'
  $TG_PING_NAME --ok --title "Figure ready" "The spectrum is real." --photo figures/spectrum.pdf
  $TG_PING_NAME photo figures/convergence.pdf --caption "Second order confirmed"
  $TG_PING_NAME pdf paper.pdf --pages 1,7-8 --caption "The new section" --attach
  $TG_PING_NAME rich report.md --title "Opening of the sweep"
  $TG_PING_NAME table results.csv --title "Errors per resolution"
  $TG_PING_NAME run --label "sweep" --every 30m --stall 20m --alert 'NaN|diverg' -- julia sweep.jl
  $TG_PING_NAME progress start "Training" --expected 2h
  $TG_PING_NAME progress update "epoch 5 of 20" --percent 5/20
  $TG_PING_NAME progress done "converged, loss 3.1e-4"
  answer=\$($TG_PING_NAME ask "Which figure?" --photo a.png --photo b.png -o left -o right --wait 900)
  file=\$($TG_PING_NAME receive "Please send the referee's PDF" --wait 15m --out inbox/)

NOTES FOR AGENTS
  Send a message when a long job starts, when it ends or fails, when a figure
  or document is ready, when you are blocked on a decision, and when the task
  is complete. One or two sentences each. Prefer one clear milestone message
  over a stream of small updates, and use --cooldown when a loop might repeat.
  Use 'ask' when you need a human decision: it prints the answer on stdout,
  and questions from several sessions or computers never mix their answers.
  Use 'receive' when you need a file from the user: it saves what they send
  and prints the path. Every message names its agent on its first line, found
  by itself, so there is no need to sign one ('config show' says which agent
  is seen). Never pass a token on the command line and never echo it.

Homepage: https://github.com/dutykh/tg-ping
EOS
}

help_send() { cat <<EOS
$TG_PING_NAME send: deliver a text message.

  $TG_PING_NAME [send] [options] "text"
  <command> | $TG_PING_NAME [send] [options]

The body may come from the arguments, from --message, or from stdin. Every
message part described in '$TG_PING_NAME --help' applies here. The pictures
of --photo (a PDF, SVG or EPS figure drawn first) and the files of --document
carry the text as their caption when it fits, and otherwise follow it as a
reply; a rich message embeds them.

  $TG_PING_NAME --ok --title "Deployment finished" "Version 2.3 is live" --meta
  $TG_PING_NAME --item "data loaded" --item "model fitted" --item "report written"
  $TG_PING_NAME --field "runs=512" --field "best error=1.4e-8" --title "Sweep"
  $TG_PING_NAME --ok --title "Figure ready" "The spectrum is real." --photo figures/spectrum.pdf
  tail -n 40 run.log | $TG_PING_NAME --title "Last lines" --code -
EOS
}

help_code() { cat <<EOS
$TG_PING_NAME code: send a snippet or a file as a highlighted block.

  $TG_PING_NAME code FILE [--lang NAME] [--title TEXT]
  <command> | $TG_PING_NAME code [--lang NAME]

The language is guessed from the file extension. A snippet too long for one
message is sent as a document instead, which --as message or --as document
overrides.

  $TG_PING_NAME code solver.py --lang python --title "Current solver"
  git diff | $TG_PING_NAME code --lang diff --title "Pending changes"
EOS
}

help_table() { cat <<EOS
$TG_PING_NAME table: send CSV or TSV rows as a table.

  $TG_PING_NAME table FILE [--sep CHAR] [--no-header] [--title TEXT]
  <command> | $TG_PING_NAME table

The separator is guessed from the first line when --sep is absent (tab, then
semicolon, then comma; '--sep space' splits on runs of blanks). A field in
double quotes may hold the separator. The first row is a header unless
--no-header is given. Numbers are aligned on the right, and widths count
characters, so Greek letters line up. In the rich format Telegram draws the
table itself. An empty table sends its title with "no rows".

  $TG_PING_NAME table errors.csv --title "Convergence study"
  printf 'N\\terror\\n64\\t1.2e-4\\n128\\t7.9e-6\\n' | $TG_PING_NAME table
EOS
}

help_photo() { cat <<EOS
$TG_PING_NAME photo: send pictures, one, or several as albums.

  $TG_PING_NAME photo FILE [FILE...] [--caption TEXT] [--each TEXT]...
                      [--original] [--key NAME --replace]

A PDF, SVG or EPS figure is drawn at 300 dpi on white before it goes;
--original also sends the files themselves, since Telegram recompresses
photos. A GIF goes as an animation and an MP4 as a video. Up to ten files
form one album; more become balanced albums (eleven are six and five). The
caption goes with the first file, and each --each adds a line to the next
file. A caption longer than $TG_MAX_CAPTION characters continues as a reply.
A photo over 10 MB, or one Telegram refuses as a photo, goes as a document.
With --key NAME --replace the picture of the same message is replaced on the
next calls: a live figure. A web address may stand for a local file.

  $TG_PING_NAME photo figures/spectrum.pdf --caption "Spectrum of the operator"
  $TG_PING_NAME photo t0.png t1.png t2.png --caption "Three moments" \\
      --each "the initial pulse" --each "the reflection" --each "the final state"
  $TG_PING_NAME photo residual.png --key residual --replace --caption "after 400 iterations"
EOS
}

help_file() { cat <<EOS
$TG_PING_NAME file: send documents; media: send files as what they are.

  $TG_PING_NAME file FILE [FILE...] [--caption TEXT] [--name NAME] [--as KIND]
  $TG_PING_NAME media FILE [FILE...] [--caption TEXT]

Anything up to 50 MiB can be sent; a video above is re-encoded with ffmpeg to
fit. --name changes the file name shown in the chat, --as sends as photo,
document, video, audio or animation. 'media' chooses from each extension.

  $TG_PING_NAME file report.pdf --caption "Draft, section 3 is new"
  $TG_PING_NAME file evolution.mp4 --as video --caption "The pulse crosses the chamber"
  $TG_PING_NAME media evolution.gif snapshot.png
EOS
}

help_math() { cat <<EOS
$TG_PING_NAME math: typeset a formula and send it.

  $TG_PING_NAME math 'LATEX' [--typst] [--prose] [--native] [--file FILE]
                     [--dpi N] [--bg white|transparent|dark] [--inline]
                     [--preamble FILE] [--out FILE] [--remote]

Rendering happens locally, with typst when --typst is given and with LaTeX
otherwise (latex and dvipng, or pdflatex and pdftoppm). A formula with \\\\ is
set over several lines, aligned at & when it has one; an align, gather,
multline or equation environment is kept as written. --prose typesets a
sentence with its inline formulas, the equation with its conditions in one
picture. --file reads the source from a file. --native lets Telegram typeset
the formula in a rich message instead of a picture. --preamble adds your own
macro definitions. --remote renders through latex.codecogs.com instead of
this machine, which sends the formula to that site; it is off unless asked.

  $TG_PING_NAME math '\\nabla^2 u = f, \\quad u|_{\\partial\\Omega} = 0'
  $TG_PING_NAME math 'u_t + 6 u u_x + u_{xxx} = 0 \\\\ u(x, 0) = u_0(x)'
  $TG_PING_NAME math --prose 'For every \$t \\geqslant 0\$ the energy \$E(t)\$ is conserved.'
  $TG_PING_NAME math --typst 'integral_0^1 x^2 dif x = 1/3'
  $TG_PING_NAME math '\\lambda_1 = \\pi^2/4' --native --caption "First eigenvalue"
EOS
}

help_run() { cat <<EOS
$TG_PING_NAME run: run a command and report how it ended.

  $TG_PING_NAME run [--label TEXT] [--notify-start] [--tail N] [--on WHEN]
                    [--every DURATION] [--stall DURATION] [--alert PATTERN]
                    [--limit DURATION] [--attach-log | --attach-log-always]
                    [--log FILE] [--photo FILE] [--quiet-output] [--exit-zero] -- COMMAND...

The command runs whatever happens to the notifications, its output still
reaches the terminal, Ctrl-C still reaches it, and its exit code is passed
through. --every keeps one status message, edited silently with the time
elapsed and the last lines of output; the report arrives as a new message.
--stall warns once when the output has been silent that long. --alert warns
at the first line of the output matching PATTERN (an extended regular
expression, repeatable: each pattern warns once), with that line and the
lines before it. --limit stops the command at a deadline. --attach-log sends
the complete log on failure (--attach-log-always every time), --log keeps
it in FILE. --photo FILE sends a figure with the report, one the command
itself may have produced (missing, it is left out). --on takes always
(default), success, failure or never. On failure the last --tail lines
(default 20) travel with the report. Durations read 90s, 15m, 2h or 1h30m.

  $TG_PING_NAME run --label "test suite" -- make test
  $TG_PING_NAME run --label "sweep" --every 30m --stall 20m --attach-log -- julia sweep.jl
  $TG_PING_NAME run --label "solver" --alert 'NaN|diverg' --photo figures/residual.png -- ./solve
  $TG_PING_NAME run --on failure --exit-zero -- ./flaky-check.sh
EOS
}

help_progress() { cat <<EOS
$TG_PING_NAME progress: keep one message updated in place.

  $TG_PING_NAME progress start "text" [--key NAME] [--expected DURATION]   prints the message id
  $TG_PING_NAME progress update "text" [--percent N|K/N] [--id ID] [--key NAME]
  $TG_PING_NAME progress done "text" [--ok|--fail] [--pin] [--edit-only]

A long computation then occupies one message instead of fifty. The message
is remembered per chat and per project (or per --key), so two sessions never
edit the same one. Each update shows the time elapsed and, with a percentage,
the expected end, counting down on the phone. 'done' gives the duration
against --expected, and since an edit never rings the phone, it also sends a
short reply, unless --edit-only. An update refused for its rate is skipped.
A picture (--photo) or a formula (--math) given with start or update follows
the message as a reply, since an edited text cannot carry one; with done it
goes with the final reply.

  $TG_PING_NAME progress start "Training the network" --expected 2h
  for epoch in \$(seq 1 20); do
      $TG_PING_NAME progress update "epoch \$epoch of 20" --percent \$epoch/20
  done
  $TG_PING_NAME progress done "converged, final loss 3.1e-4"
EOS
}

help_ask() { cat <<EOS
$TG_PING_NAME ask: put a question on the phone and wait for the answer.

  $TG_PING_NAME ask "question" -o OPTION [-o OPTION...] [--wait SECONDS]
                    [--default TEXT] [--strict] [--cols N] [--json]
                    [--photo FILE]... [--math LATEX]...

The options appear as buttons (a yes in green, a no in red). The answer is
printed on stdout, alone, so it can be captured. A typed reply is accepted as
well, unless --strict is given: a reply to the question, or the message that
follows it directly. Without an answer before the deadline the exit code is
7, or the --default value is printed and the exit code is 0. The pictures of
--photo and the formulas of --math go first, as an album the question
answers, so that the buttons sit right under the question.

Questions from several sessions, and from several computers sharing the bot,
may wait at the same time: each answer reaches its own question.

  answer=\$($TG_PING_NAME ask "Which basis?" -o Chebyshev -o Fourier --wait 900)
  case "\$answer" in Chebyshev) ... ;; Fourier) ... ;; esac

  $TG_PING_NAME ask "Continue after the failing test?" -o yes -o no --default no
  $TG_PING_NAME ask "Which figure goes in the paper?" --photo a.pdf --photo b.pdf -o left -o right
EOS
}

help_poll() { cat <<EOS
$TG_PING_NAME poll: send a native Telegram poll.

  $TG_PING_NAME poll "question" -o OPTION -o OPTION [--multi] [--anonymous]
                     [--correct INDEX] [--wait SECONDS]

--correct turns the poll into a quiz (INDEX counts from 0). --wait blocks
until somebody answers and prints the chosen options.

  $TG_PING_NAME poll "Which figure goes in the paper?" -o "spectrum" -o "residual" -o "both"
EOS
}

help_receive() { cat <<EOS
$TG_PING_NAME receive: wait for a file sent from the phone and save it.

  $TG_PING_NAME receive ["prompt"] [--wait SECONDS] [--out FOLDER|FILE] [--kind KIND] [--json]

A photo, a document, a video or a voice note sent to the bot is saved here
and its path is printed on stdout, alone, so that a script or an agent can
open it. With a prompt, the question goes out first (a reply field opens on
the phone) and the file that answers it, or that follows it, is taken.
Without one, the next file of the chat is taken, or one sent in the last ten
minutes that no other question claimed. --out names the folder (the working
folder by default) or the file; a document keeps its own name, a photo is
called after the time, and nothing is overwritten. --kind photo, document,
video, audio or voice takes files of that kind only. Without a file before
the deadline the exit code is 7. Telegram hands over files of up to 20 MB.
With --json, the path comes with the kind, the name, the caption and the
size.

  file=\$($TG_PING_NAME receive "Please send a photo of the whiteboard" --wait 15m --out inbox/)
  $TG_PING_NAME receive --kind document --out referee-report.pdf
EOS
}

help_rich() { cat <<EOS
$TG_PING_NAME rich: send a Markdown report as one rich message.

  $TG_PING_NAME rich FILE.md [--title TEXT] [--ok|--start|...]

Telegram reads the Markdown itself: headings, lists, tables, quotations, code,
and formulas between \$ or \$\$, typeset natively. Local figures (![caption](fig.png),
paths relative to the file) are uploaded with the message, PDF, SVG and EPS
figures drawn first; at most 50. Up to 32,768 characters. Refused, the text
goes in the classic form and the figures follow as an album.

  $TG_PING_NAME rich opening.md --start --title "The sweep begins"
EOS
}

help_pdf() { cat <<EOS
$TG_PING_NAME pdf: send pages of a PDF as pictures.

  $TG_PING_NAME pdf FILE.pdf [--pages 1,3-5|all] [--dpi N] [--caption TEXT]
                    [--each TEXT]... [--attach]

The pages (the first one by default) are drawn at 200 dpi and sent as albums,
the caption saying which pages of how many. Each page after the first is
marked "page N" unless --each says more. --attach adds the PDF itself.

  $TG_PING_NAME pdf paper.pdf --pages 7-8 --caption "The corrected section" --attach
EOS
}

help_edit() { cat <<EOS
$TG_PING_NAME edit: correct a message already sent.

  $TG_PING_NAME edit ID "new text" [message options]
  $TG_PING_NAME edit --last "new text"

ID is the number of the message (printed by --json or -v); --last means the
last message sent to the chat from this project.
EOS
}

help_delete() { cat <<EOS
$TG_PING_NAME delete: withdraw a message already sent.

  $TG_PING_NAME delete ID
  $TG_PING_NAME delete --last

Telegram lets a bot delete its messages for 48 hours.
EOS
}

help_wait() { cat <<EOS
$TG_PING_NAME wait: a message when a running process ends.

  $TG_PING_NAME wait PID [--label TEXT] [--log FILE] [message options]

For a computation started without tg-ping. The message gives how long it ran
and, with --log, the last lines of its log; its exit code cannot be seen from
outside.

  $TG_PING_NAME wait 41532 --label "the cavity sweep" --log sweep.log
EOS
}

help_init() { cat <<EOS
$TG_PING_NAME init: interactive setup of a profile.

  $TG_PING_NAME init [--profile NAME] [--token-file FILE] [--chat ID]

Asks for the bot token (typed without echo), checks it with Telegram, finds
the chat that last wrote to the bot, asks what this machine should be called
in messages, and writes the profile file with mode 600. Only the token, chat
and machine lines change; every other setting of the file stays, and the old
file is kept as a .bak copy. With --dry-run nothing is written.
EOS
}

help_doctor() { cat <<EOS
$TG_PING_NAME doctor: check the installation, the settings and the bot.

  $TG_PING_NAME doctor [--math] [--send]

Checks the programs used, where the token and the chat come from, whether
Telegram answers, whether each chat is reachable (nothing is sent), and
whether a webhook would stop 'ask'. --math renders a test formula with each
engine, offline; --send also delivers a test message.
EOS
}

help_chats() { cat <<EOS
$TG_PING_NAME chats: list the chats that have written to the bot.

  $TG_PING_NAME chats

Telegram keeps unread messages for 24 hours, so send the bot a message first.
Nothing is marked as read.
EOS
}

help_config() { cat <<EOS
$TG_PING_NAME config: show or change the settings of the active profile.

  $TG_PING_NAME config [show]           where every setting comes from (the token is never shown)
  $TG_PING_NAME config set KEY VALUE    write a setting into the profile file
  $TG_PING_NAME config unset KEY        remove it
  $TG_PING_NAME config path | files     the profile file, every file consulted

Keys: machine, icon, project, topics, quiet-hours, format, prefix, meta,
chat, topic, or any TG_PING_* name. 'config set machine NAME' also records
the icon of this kind of machine (laptop, desktop or server); 'config set
project on' ends every message with the project it comes from (the folder
inside its repository, or a name of your own). The token is set by 'init'.

  $TG_PING_NAME config set machine "home desktop"
  $TG_PING_NAME config set project on
  $TG_PING_NAME config set quiet-hours 23-08
EOS
}

help_completion() { cat <<EOS
$TG_PING_NAME completion: print shell completion code.

  $TG_PING_NAME completion bash > ~/.local/share/bash-completion/completions/tg-ping
  $TG_PING_NAME completion zsh  > ~/.local/share/zsh/site-functions/_tg-ping
EOS
}

help_command() {
    case "${1:-}" in
        send|msg|message) help_send ;;
        code)             help_code ;;
        table)            help_table ;;
        photo|image|img)  help_photo ;;
        file|doc|document|media) help_file ;;
        math|formula)     help_math ;;
        run|exec|wrap)    help_run ;;
        progress)         help_progress ;;
        ask)              help_ask ;;
        poll)             help_poll ;;
        receive|get)      help_receive ;;
        rich)             help_rich ;;
        pdf)              help_pdf ;;
        edit)             help_edit ;;
        delete)           help_delete ;;
        wait)             help_wait ;;
        init|setup)       help_init ;;
        doctor|check)     help_doctor ;;
        chats|whoami)     help_chats ;;
        config)           help_config ;;
        completion)       help_completion ;;
        ""|-h|--help)     usage ;;
        *)                usage ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

HELP_REQUESTED=0
DOCTOR_SEND=0
DOCTOR_MATH=0
HOISTED=()

hoist_command() {
    # A command word written after options moves to the front, so that
    # 'tg-ping --caption "Spectrum" photo fig.png' sends the photo instead of
    # the words "photo fig.png". Only commands that take arguments move, only
    # when an argument follows them (a word that is not an option, or '--'
    # with words after it), and a '--' before the word ends the search, so
    # that 'tg-ping --ok -- math' still sends the word.
    local i=1 n=$# j k arg found
    HOISTED=("$@")
    while [ "$i" -le "$n" ]; do
        arg=${!i}
        case "$arg" in
            --) return 0 ;;
            -?*)
                case "$VALUE_OPTS" in
                    *" $arg "*) i=$(( i + 2 )) ;;
                    *)          i=$(( i + 1 )) ;;
                esac
                continue ;;
        esac
        [ "$i" -gt 1 ] || return 0
        case "$HOISTABLE" in *" $arg "*) ;; *) return 0 ;; esac
        k=$(( i + 1 )); found=0
        while [ "$k" -le "$n" ]; do
            case "${!k}" in
                --)   [ "$k" -lt "$n" ] && found=1; break ;;
                -?*)  case "$VALUE_OPTS" in *" ${!k} "*) k=$(( k + 2 )) ;; *) k=$(( k + 1 )) ;; esac ;;
                *)    found=1; break ;;
            esac
        done
        [ "$found" -eq 1 ] || return 0
        HOISTED=("$arg")
        j=1
        while [ "$j" -le "$n" ]; do
            [ "$j" -eq "$i" ] || HOISTED[${#HOISTED[@]}]="${!j}"
            j=$(( j + 1 ))
        done
        return 0
    done
    return 0
}

main() {
    [ $# -eq 0 ] && { usage; exit "$EX_USAGE"; }
    hoist_command "$@"
    set -- "${HOISTED[@]}"
    case "$1" in
        -h|--help|help|version|--version|cheatsheet|cheat|hook|hooks|completion) ;;
        *)
            workdir_init
            preparse_config_flags "$@"
            load_file_settings
            resolve_agent
            ;;
    esac
    case "$1" in
        send|msg|message)   shift; cmd_send "$@" ;;
        code|snippet)       shift; cmd_code "$@" ;;
        table)              shift; cmd_table "$@" ;;
        math|formula)       shift; cmd_math "$@" ;;
        photo|image|img)    shift; cmd_media photo "$@" ;;
        file|doc|document)  shift; cmd_media document "$@" ;;
        media|album)        shift; cmd_media auto "$@" ;;
        run|exec|wrap)      shift; cmd_run "$@" ;;
        progress)           shift; cmd_progress "$@" ;;
        rich)               shift; cmd_rich "$@" ;;
        pdf)                shift; cmd_pdf "$@" ;;
        edit)               shift; cmd_edit "$@" ;;
        delete)             shift; cmd_delete "$@" ;;
        wait)               shift; cmd_wait "$@" ;;
        ask)                shift; parse_common_args "$@"
                            [ "$HELP_REQUESTED" -eq 1 ] && { help_ask; exit "$EX_OK"; }
                            body_from_remaining
                            cmd_ask ;;
        poll)               shift; parse_common_args "$@"
                            [ "$HELP_REQUESTED" -eq 1 ] && { help_poll; exit "$EX_OK"; }
                            body_from_remaining
                            cmd_poll ;;
        receive|get)        shift; cmd_receive "$@" ;;
        init|setup)         shift; cmd_init "$@" ;;
        doctor|check)       shift; cmd_doctor "$@" ;;
        chats|whoami)       shift; cmd_chats "$@" ;;
        config)             shift; cmd_config "$@" ;;
        hook|hooks)         shift; cmd_hook "$@" ;;
        cheatsheet|cheat)   shift; cmd_cheatsheet ;;
        completion)         shift; cmd_completion "$@" ;;
        version|--version)  printf '%s %s\n' "$TG_PING_NAME" "$TG_PING_VERSION"; exit "$EX_OK" ;;
        help)               shift; help_command "${1:-}"; exit "$EX_OK" ;;
        -h|--help)          usage; exit "$EX_OK" ;;
        *)                  cmd_send "$@" ;;
    esac
}

[ -n "${TG_PING_AWK:-}" ] || AWK_CMD=$(choose_awk)
main "$@"
