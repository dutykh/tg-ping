# tg-ping configuration example.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# Copy this file, fill in the two required values, and keep the copy private:
#
#     cp .env.example .tg-ping.env
#     chmod 600 .tg-ping.env
#
# tg-ping reads, in order: command line flags, environment variables,
# --env-file FILE, ./.tg-ping.env, ./.env (only TG_PING_* and TELEGRAM_* keys),
# ~/.config/tg-ping/<profile>.env, /etc/tg-ping/config. The first value found
# for each setting wins. Files are parsed as KEY=VALUE and are never sourced,
# so nothing in them can be executed.
#
# The quickest way to produce a filled file is:  tg-ping init

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Token issued by @BotFather when you send /newbot. Anyone holding it controls
# the bot, so never commit it. Revoke it with /revoke if it ever leaks.
TG_PING_TOKEN=123456789:AAExampleTokenReplaceThisWithYourOwnValue

# Where the messages go. Find it with 'tg-ping chats' after sending your bot a
# message, or with 'tg-ping init'.
#   private chat   123456789
#   group         -987654321
#   supergroup    -1001234567890
#   public channel @my_channel      (the bot must be an administrator)
# Several targets may be listed, separated by commas.
TG_PING_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Forum topic (message thread) inside a group that has topics enabled.
#TG_PING_THREAD_ID=

# Label put in front of every message, useful when several machines or several
# agents report into the same chat.
#TG_PING_PREFIX=[hpc-node-3]

# Default message format: auto (light Markdown in, escaped HTML out, plain text
# fallback), plain, markdown or html.
#TG_PING_FORMAT=auto

# Turn every call into a silent no-op. Useful in CI and in test suites.
#TG_PING_DISABLED=0

# Never let a failed notification break a pipeline.
#TG_PING_SOFT_FAIL=0

# Ignore ./.env and ./.tg-ping.env entirely.
#TG_PING_NO_DOTENV=0

# Network behaviour.
#TG_PING_TIMEOUT=20
#TG_PING_RETRIES=3

# Longest message before it is split into several parts.
#TG_PING_MAX_PARTS=8

# Mathematics rendering.
#TG_PING_MATH_DPI=400
#TG_PING_MATH_BG=white
#TG_PING_MATH_PREAMBLE=/home/me/.config/tg-ping/macros.tex
# Allow the public renderer at latex.codecogs.com as a fallback. This sends the
# formula to a third party, so it is off by default.
#TG_PING_MATH_REMOTE=0

# Alternative API endpoint, for a local Bot API server.
#TG_PING_API=https://api.telegram.org

# These older names are accepted as well, so an existing setup keeps working:
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
