# tg-ping configuration example.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# The quickest way to a working setup is 'tg-ping init', which validates the
# token, finds the chat id, asks what this machine should be called, and writes
# ~/.config/tg-ping/default.env with mode 600. This file shows every setting
# that file may contain. A single setting is changed later with
# 'tg-ping config set KEY VALUE', which prints no secret.
#
# Settings are resolved in this order, the first value found wins:
#
#     1. command line flags
#     2. environment variables (TG_PING_*)
#     3. --env-file FILE, or $TG_PING_ENV_FILE
#     4. ./.tg-ping.env               a chat, a topic, a profile, any setting
#     5. ./.env.local                 TG_PING_* keys only
#     6. ./.env                       TG_PING_* keys only
#     7. ~/.config/tg-ping/<profile>.env
#     8. /etc/tg-ping/config
#     9. the older TELEGRAM_* names, from the environment, then from 3, 4, 7, 8
#
# The files of the working folder (4 to 6) never supply the token nor
# TG_PING_API: a project needing another bot names one of your profiles with
# TG_PING_PROFILE in its ./.tg-ping.env, and the token stays in your own
# folder. Files are parsed as KEY=VALUE. They are never sourced and never
# evaluated, so nothing written here can execute. A value may be quoted, a
# comment starts at a blank followed by '#', and a leading ~/ in a path is
# expanded.

# --- credentials, in your own folder only -----------------------------------

TG_PING_TOKEN=123456789:AAExampleTokenReplaceThisWithYourOwnValue
TG_PING_CHAT_ID=123456789

# --- this machine ------------------------------------------------------------

# The name shown on every message, right after the level emoji, so that the
# phone says which computer is speaking: "✅ 💻 laptop · Tests green". Each
# machine keeps its own name in its own settings file. 'tg-ping config set
# machine NAME' writes it and records the icon of the kind of machine (laptop,
# desktop, or server and virtual machine), detected once. Unset, nothing is
# shown; 'auto' shows the icon and the host name.
#TG_PING_MACHINE=laptop
#TG_PING_MACHINE_ICON=💻

# The agent named after the machine, "✅ 💻 laptop · Codex · Tests green", so
# that the phone also says who is speaking. 'auto', the default, finds it by
# itself: the nearest program above tg-ping that is a coding agent (Claude
# Code, Codex, Grok, OpenCode, Gemini, Antigravity and others), else the marks
# agents leave in the environment; a script run by hand names none. 'off'
# shows no agent, and any other value is the name to show.
#TG_PING_AGENT=auto

# Every message ends with the project it comes from, when several agents
# report from one machine: the folder inside its git repository
# ("📂 typst-vault/Proofs/Zipf"), or the folder relative to home outside a
# repository. A folder may give its own name in its ./.tg-ping.env:
# TG_PING_PROJECT="Zipf paper".
#TG_PING_PROJECT=on

# One Telegram topic per project and per machine, named like
# "NLS-cavity · laptop" and made by the bot the first time. Switch on
# Threaded Mode for the bot in @BotFather first; until then messages go to the
# main chat.
#TG_PING_TOPICS=project

# Quiet hours of the local clock: messages arrive without sound, except
# errors, questions and blocked work.
#TG_PING_QUIET_HOURS=23-08

# --- mathematics -------------------------------------------------------------

# 400 dpi puts a display formula at roughly 800 px, crisp on a phone.
TG_PING_MATH_DPI=400

# white, transparent or dark. White reads well in both Telegram themes.
TG_PING_MATH_BG=white

# Personal macros, inserted after amsmath and friends. The extension decides
# which engine reads it: .tex for LaTeX, .typ for typst.
TG_PING_MATH_PREAMBLE=~/.config/tg-ping/macros.tex

# Never hand a formula to latex.codecogs.com. Rendering stays on this machine,
# and a single command can still opt in with --remote.
TG_PING_MATH_REMOTE=0

# --- long jobs ---------------------------------------------------------------

# Lines of output carried by a failed 'tg-ping run'.
TG_PING_TAIL=20

# --- network -----------------------------------------------------------------

# Seconds allowed for one request; an upload stops only when it stalls.
TG_PING_TIMEOUT=20
TG_PING_RETRIES=3

# --- deliberately left unset -------------------------------------------------

# A fixed label in front of every message. The machine name above is usually
# the better choice.
#TG_PING_PREFIX=[cluster]

# The fields of the footer that --meta adds: host, repo and time, in any
# combination. A footer without the host name: TG_PING_META=repo,time
#TG_PING_META=host,repo,time

# Soft failure stays a per command decision, so a delivery problem is visible
# here while scripts and CI pass --soft-fail themselves.
#TG_PING_SOFT_FAIL=1

# Turn every call into a silent no-op, for a rehearsal. 'run' still runs its
# command.
#TG_PING_DISABLED=1

# Never read standard input unless asked with '-'. Without it, the body is read
# from a pipe when no text is given, never from a file or a terminal.
#TG_PING_NO_STDIN=1

# Forum topic inside a group that has topics enabled.
#TG_PING_THREAD_ID=

# Message format: auto, rich, plain, markdown or html. Auto is the safe
# default; rich sends Telegram's rich messages, with formulas typeset by
# Telegram itself, and falls back to auto when they are refused.
#TG_PING_FORMAT=auto

# Parts a long message may be split into, and the width of the progress bar.
#TG_PING_MAX_PARTS=8
#TG_PING_BAR_WIDTH=12

# --- older names, still accepted ---------------------------------------------

# An existing setup using these keeps working. They rank below every TG_PING_*
# setting, and ./.env and ./.env.local never supply them, since other projects
# keep their own bots under these names there.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- other endpoints ---------------------------------------------------------

# A local Bot API server, for large uploads or an isolated network. Read only
# from your own files and the environment.
#TG_PING_API=https://api.telegram.org

# Ignore ./.env, ./.env.local and ./.tg-ping.env entirely. This one works from
# the environment or from a flag, not from inside a file:
#
#     TG_PING_NO_DOTENV=1 tg-ping "ignore whatever sits in this directory"
#
# TG_PING_PROFILE chooses the profile file; it may come from the environment,
# from a flag (--profile), or from ./.tg-ping.env.
