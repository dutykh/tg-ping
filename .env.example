# tg-ping configuration example.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# The quickest way to a working setup is 'tg-ping init', which validates the
# token, finds the chat id and writes ~/.config/tg-ping/default.env with mode
# 600. This file shows every setting that file may contain.
#
# To use it as a project local configuration instead:
#
#     cp .env.example .tg-ping.env
#     chmod 600 .tg-ping.env
#
# Settings are resolved in this order, first value found wins:
#
#     1. command line flags
#     2. environment variables
#     3. --env-file FILE, or $TG_PING_ENV_FILE
#     4. ./.tg-ping.env
#     5. ./.env.local
#     6. ./.env                       only TG_PING_* and TELEGRAM_* keys
#     7. ~/.config/tg-ping/<profile>.env
#     8. /etc/tg-ping/config
#
# Files are parsed as KEY=VALUE. They are never sourced and never evaluated,
# so nothing written here can execute. Paths must be absolute, although a
# leading ~/ is expanded.

# --- credentials -----------------------------------------------------------

TG_PING_TOKEN=123456789:AAExampleTokenReplaceThisWithYourOwnValue
TG_PING_CHAT_ID=123456789

# --- mathematics -----------------------------------------------------------

# 400 dpi puts a display formula at roughly 800 px, crisp on a phone.
TG_PING_MATH_DPI=400

# white, transparent or dark. White reads well in both Telegram themes.
TG_PING_MATH_BG=white

# Personal macros, inserted after amsmath and friends. The extension decides
# which engine reads it: .tex for LaTeX, .typ for typst.
TG_PING_MATH_PREAMBLE=~/.config/tg-ping/macros.tex

# Never hand a formula to latex.codecogs.com. Rendering stays on this machine,
# and a single command can still opt in with --remote.
TG_PING_MATH_REMOTE=0

# --- long jobs -------------------------------------------------------------

# Lines of output carried by a failed 'tg-ping run'.
TG_PING_TAIL=20

# --- network ---------------------------------------------------------------

TG_PING_TIMEOUT=20
TG_PING_RETRIES=3

# --- deliberately left unset -----------------------------------------------

# A fixed label in front of every message, for when a second machine reports
# into the same chat.
#TG_PING_PREFIX=[laptop]

# Soft failure stays a per command decision, so a delivery problem is visible
# here while scripts and CI pass --soft-fail themselves.
#TG_PING_SOFT_FAIL=1

# Turn every call into a silent no-op, for a rehearsal.
#TG_PING_DISABLED=1

# Forum topic inside a group that has topics enabled. A private chat has none.
#TG_PING_THREAD_ID=

# Message format: auto, plain, markdown or html. Auto is the safe default.
#TG_PING_FORMAT=auto

# Parts a long message may be split into, and the width of the progress bar.
#TG_PING_MAX_PARTS=8
#TG_PING_BAR_WIDTH=12

# --- older names, still accepted --------------------------------------------

# An existing setup using these keeps working, and they are also read from a
# generic ./.env, which is otherwise ignored.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- other endpoints --------------------------------------------------------

# A local Bot API server, for large uploads or an isolated network.
#TG_PING_API=https://api.telegram.org

# Ignore ./.env, ./.env.local and ./.tg-ping.env entirely.
#TG_PING_NO_DOTENV=1
